function slashItems(tree,cb){var c=SLASH.cache[tree];if(c&&Date.now()-c.at<60000)return cb(c.items);fetch('/api/skills?tree='+encodeURIComponent(tree)).then(function(r){return r.json()}).then(function(d){SLASH.cache[tree]={at:Date.now(),items:d.items||[]};cb(d.items||[])}).catch(function(){cb([])})}
function slashClose(){SLASH.ta=null;SLASH.rows=[];var p=$('slashpop');if(p)p.classList.remove('on')}
function slashUpdate(ta){var m=ta.value.match(/^\/([\w:.-]*)$/);if(!m||ta.selectionStart!==ta.value.length){slashClose();return}var q=m[1].toLowerCase(),tree=ta.dataset.reply;
  slashItems(tree,function(items){if(document.activeElement!==ta||!ta.value.match(/^\/([\w:.-]*)$/))return;
    var rows=items.filter(function(i){return !q||i.name.toLowerCase().indexOf(q)>=0||i.desc.toLowerCase().indexOf(q)>=0});
    rows.sort(function(a,b){var ap=a.name.toLowerCase().indexOf(q)===0?0:a.name.toLowerCase().indexOf(q)>=0?1:2,bp=b.name.toLowerCase().indexOf(q)===0?0:b.name.toLowerCase().indexOf(q)>=0?1:2;return ap-bp||a.name.localeCompare(b.name)});
    SLASH.ta=ta;SLASH.rows=rows.slice(0,30);if(SLASH.sel>=SLASH.rows.length)SLASH.sel=0;slashPaint()})}
function slashPaint(){var p=$('slashpop');if(!p){p=document.createElement('div');p.id='slashpop';p.className='slashpop';document.body.appendChild(p)}
  var ta=SLASH.ta;if(!ta||!SLASH.rows.length){p.classList.remove('on');return}
  // inside an open <dialog> the popup must live in it, or the dialog's top layer hides it
  var host=ta.closest('dialog')||document.body;if(p.parentNode!==host)host.appendChild(p);
  p.innerHTML=SLASH.rows.map(function(r,i){return '<div class="slashrow'+(i===SLASH.sel?' on':'')+'" data-slash="'+i+'"><b>/'+esc(r.name)+'</b><span class="sub">'+esc(r.desc)+'</span><span class="src">'+esc(r.src)+'</span></div>'}).join('');
  var rc=ta.getBoundingClientRect(),hr=host===document.body?{left:0,top:0}:host.getBoundingClientRect();p.style.left=(rc.left-hr.left)+'px';p.style.width=Math.max(320,rc.width)+'px';p.style.bottom=(host===document.body?innerHeight-rc.top:hr.bottom-rc.top)+6+'px';p.style.top='auto';p.classList.add('on');
  var on=p.querySelector('.on');if(on)on.scrollIntoView({block:'nearest'})}
function slashPick(i){var r=SLASH.rows[i],ta=SLASH.ta;if(!r||!ta)return;ta.value='/'+r.name+' ';setDraft(ta.dataset.reply,ta.value,ta);growBox(ta);slashClose();ta.focus();ta.setSelectionRange(ta.value.length,ta.value.length)}
document.addEventListener('input',function(e){if(e.target.dataset&&e.target.dataset.reply){SLASH.sel=0;slashUpdate(e.target)}});
window.addEventListener('keydown',function(e){if(!SLASH.ta||e.target!==SLASH.ta||!SLASH.rows.length)return;var k=e.key,n=SLASH.rows.length;
  if(k==='ArrowDown'||k==='ArrowUp'){SLASH.sel=(SLASH.sel+(k==='ArrowDown'?1:n-1))%n;slashPaint()}else if(k==='Tab'||(k==='Enter'&&!e.shiftKey)){slashPick(SLASH.sel)}else if(k==='Escape'){slashClose()}else return;
  e.preventDefault();e.stopPropagation();e.stopImmediatePropagation()},true);
