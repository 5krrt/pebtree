/* ---------- terminals: tmux sessions on every host, attached in the page ---------- */
// One xterm per open tab, each on its own WebSocket to pebtree, which runs tmux attach (over ssh for another host).
// The session lives on in tmux whatever happens here: a dropped connection reattaches by itself.
var TERM={tabs:[],cur:null,lib:null};
function loadXterm(){if(TERM.lib)return TERM.lib;TERM.lib=new Promise(function(res,rej){var l=document.createElement('link');l.rel='stylesheet';l.href='/vendor/xterm.css';document.head.appendChild(l);
  var s=document.createElement('script');s.src='/vendor/xterm.js';s.onerror=rej;s.onload=function(){var f=document.createElement('script');f.src='/vendor/xterm-fit.js';f.onload=res;f.onerror=rej;document.head.appendChild(f)};document.head.appendChild(s)});
  TERM.lib.catch(function(){TERM.lib=null});return TERM.lib}
function curTerm(){return TERM.tabs.find(function(t){return t.key===TERM.cur})}
function termLabel(host,session){var x=(S.sessions||[]).find(function(q){return q.host===host&&q.tmuxSession===session});var h=(S.hosts||[]).find(function(q){return q.id===host});
  return x?treeName(x.tree):session+(h&&!h.local?' · '+h.label:'')}
function openTerm(host,session,label){if(location.hash!=='#terms')location.hash='terms';
  loadXterm().then(function(){var k=host+'/'+session,t=TERM.tabs.find(function(x){return x.key===k});if(!t){t=newTerm(host,session,label||termLabel(host,session));TERM.tabs.push(t)}showTerm(k)},function(){toast('Could not load the terminal (xterm.js); see the pebtree log')})}
function newTerm(host,session,label){var el=document.createElement('div');el.className='xt';$('termhost').appendChild(el);
  var term=new Terminal({fontFamily:'ui-monospace,"SF Mono",Menlo,monospace',fontSize:13,cursorBlink:true,scrollback:5000,macOptionIsMeta:true,allowProposedApi:true,theme:{background:'#0a0a0a',foreground:'#f5f5f5',cursor:'#f5f5f5',selectionBackground:'rgba(255,255,255,.2)'}});
  var fit=new FitAddon.FitAddon();term.loadAddon(fit);term.open(el);
  var t={key:host+'/'+session,host:host,session:session,label:label,el:el,term:term,fit:fit,ws:null,alive:false,closed:false,retry:0,ended:false};
  term.onData(function(d){if(t.ws&&t.ws.readyState===1)t.ws.send(JSON.stringify({i:d}));else if(t.ended&&d==='\r'){t.ended=false;connectTerm(t)}});
  term.onResize(function(z){if(t.ws&&t.ws.readyState===1)t.ws.send(JSON.stringify({r:[z.cols,z.rows]}))});
  connectTerm(t);return t}
function fitTerm(t){try{t.fit.fit()}catch(e){}}
function connectTerm(t){fitTerm(t);clearTimeout(t.rt);var exit=null;
  var ws=new WebSocket((location.protocol==='https:'?'wss://':'ws://')+location.host+'/api/term?t='+TOKEN+'&host='+encodeURIComponent(t.host)+'&session='+encodeURIComponent(t.session)+'&cols='+t.term.cols+'&rows='+t.term.rows);
  ws.binaryType='arraybuffer';t.ws=ws;
  // the size it was measured at may be from before the page laid out, and a resize sent while connecting is lost: send it now
  ws.onopen=function(){t.alive=true;t.retry=0;paintTermTabs();fitTerm(t);ws.send(JSON.stringify({r:[t.term.cols,t.term.rows]}))};
  ws.onmessage=function(m){if(typeof m.data==='string'){try{var j=JSON.parse(m.data);if(j.exit!==undefined)exit=j.exit}catch(e){}return}t.term.write(new Uint8Array(m.data))};
  ws.onclose=function(){t.alive=false;t.ws=null;paintTermTabs();if(t.closed)return;
    var h=(S.hosts||[]).find(function(q){return q.id===t.host}),gone=h&&h.up&&!h.terms.some(function(q){return q.session===t.session});
    // tmux detached (Ctrl-b d, or the session ended): wait for you. A dropped connection (ssh gives 255): reattach by itself.
    if(gone||exit===0){t.ended=true;t.term.write('\r\n\x1b[2m['+(gone?'session ended':'detached')+(gone?'':' · press Enter to reattach')+']\x1b[0m\r\n');return}
    var wait=Math.min(15000,1000*Math.pow(2,t.retry++));t.term.write('\r\n\x1b[2m[connection lost · reattaching in '+Math.round(wait/1000)+'s]\x1b[0m\r\n');t.rt=setTimeout(function(){if(!t.closed)connectTerm(t)},wait)}}
function showTerm(k){TERM.cur=k;TERM.tabs.forEach(function(t){t.el.classList.toggle('on',t.key===k)});paintTermTabs();renderTerms();var t=curTerm();if(t)setTimeout(function(){fitTerm(t);t.term.focus()},0)}
function closeTermTab(k){var t=TERM.tabs.find(function(x){return x.key===k});if(!t)return;t.closed=true;clearTimeout(t.rt);try{t.ws&&t.ws.close()}catch(e){}t.term.dispose();t.el.remove();TERM.tabs=TERM.tabs.filter(function(x){return x!==t});
  if(TERM.cur===k)TERM.cur=TERM.tabs.length?TERM.tabs[TERM.tabs.length-1].key:null;showTerm(TERM.cur)}
function paintTermTabs(){var el=$('termtabs');if(!el)return;el.innerHTML=TERM.tabs.map(function(t){return '<div class="termtab'+(t.key===TERM.cur?' on':'')+'" data-termtab="'+esc(t.key)+'"><span class="tsdot '+(t.alive?'ok':'bad')+'"></span>'+esc(t.label)+'<button class="xbtn" data-closetab="'+esc(t.key)+'" data-tip="Close this tab · the session keeps running">×</button></div>'}).join('');$('termempty').hidden=TERM.tabs.length>0}
function focusTerm(tree){var x=(S.sessions||[]).find(function(q){return q.tree===tree});if(x&&x.term==='tmux'){if($('convo').open)$('convo').close();openTerm(x.host,x.tmuxSession,treeName(tree));return}
  act({op:'focus',tree:tree}).then(function(r){if(!r.ok)toast(r.error)})}
function cleanT(t){t=String(t||'').replace(/^[✳⠀-⣿◐-◓]\s*/,'');return /^[\w.-]+$/.test(t)&&(S.hosts||[]).some(function(h){return h.label===t})?'':t}
function presetTip(p){var h=(S.hosts||[]).find(function(q){return q.id===p.host})||{};return ({tree:'Claude in a fresh worktree of ',claude:'Claude in ',codex:'Codex in ',shell:p.cmd?p.cmd+' in ':'a shell in '})[p.kind]+(p.repo||'~')+' on '+(h.label||p.host)}
function startPreset(p){toast(p.kind==='tree'?'Leasing a worktree on '+p.host+'…':'Starting '+(p.label||p.id)+'…');
  act({op:'spawn',host:p.host,kind:p.kind,repo:p.repo,session:p.session,cmd:p.cmd,prompt:p.prompt||''}).then(function(r){if(!r.ok){toast('Not started: '+r.error);return}openTerm(r.host,r.session);refresh()})}
function resumeTree(tree){toast('Picking '+treeName(tree)+' back up…');act({op:'resume-tree',tree:tree}).then(function(r){if(!r.ok){toast('Could not resume: '+r.error);return}openTerm(r.host,r.session,treeName(tree));refresh()})}
function renderTermsBadge(){var n=(S.trees||[]).filter(function(t){return t.stale}).length,off=(S.hosts||[]).filter(function(h){return !h.up}).length,el=$('c-terms');if(!el)return;
  el.textContent=off?'!':n?String(n):'';el.classList.toggle('turn',!!(n||off));el.dataset.tip=off?'A host is unreachable':n?n+' tree'+(n>1?'s':'')+' you hold with nothing running in '+(n>1?'them':'it'):''}
function renderTerms(){if(!$('termside'))return;var stale=(S.trees||[]).filter(function(t){return t.stale});
  var h='<div><button class="primary" data-newsess="1" style="width:100%">New session</button></div>';
  if((S.presets||[]).length)h+='<div><div class="tshead">Quick start</div><div class="tspresets">'+S.presets.map(function(p,i){return '<button data-preset="'+i+'" data-tip="'+esc(presetTip(p))+'">'+esc(p.label||p.id)+'</button>'}).join('')+'</div></div>';
  if(stale.length)h+='<div><div class="tshead">Where you left off</div>'+stale.map(function(t){var last=t.last||{};return '<div class="tsstale">'+treeIcon(t.tree,22)+'<div class="grow"><b>'+esc(treeName(t.tree))+'</b><div class="small muted">'+esc(branchLabel(t.branch)||'no branch')+(t.dirty?' · '+t.dirty+' changed':'')+(last.at?' · '+ago(last.at):'')+'</div>'+(last.say||last.you?'<div class="small muted tsclip" title="'+esc(plain(last.say||last.you).slice(-600))+'">'+esc(plain(last.say||last.you).slice(-180))+'</div>':'')+
    '<div class="row" style="gap:6px;margin-top:6px"><button data-resume="'+esc(t.tree)+'" data-tip="'+(t.tmuxSession?'Its tmux session is still there: open it':'Start Claude --continue in it')+'">'+(t.tmuxSession?'Attach':'Resume')+'</button><button class="danger" data-closetree="'+esc(t.tree)+'" data-tip="Hand the worktree back to the pool">Return</button></div></div></div>'}).join('')+'</div>';
  (S.hosts||[]).forEach(function(ho){var mine=(S.sessions||[]).filter(function(x){return x.host===ho.id});
    h+='<div><div class="tshead"><span class="tsdot '+(ho.up?'ok':'bad')+'"></span>'+esc(ho.label)+(ho.up?'':'<span style="text-transform:none;letter-spacing:0;color:var(--bad)">· '+esc(ho.error||'offline')+', retrying</span>')+'</div>';
    var rows=ho.terms.map(function(q){var k=ho.id+'/'+q.session,x=mine.find(function(s){return s.tmuxSession===q.session}),st=x?(x.menu||x.claudeState==='waiting'?'claude':x.claudeState==='working'?'work':''):q.attached?'ok':'';
      return '<div class="tsterm'+(TERM.cur===k?' on':'')+'" data-term="'+esc(ho.id)+'|'+esc(q.session)+'"><span class="tsdot '+st+'"></span><div class="grow"><b>'+esc(x?treeName(x.tree).replace(' · '+ho.label,''):q.session)+'</b><div class="small muted tsclip">'+esc(x?(x.title||q.session):(cleanT(q.title)||q.cmd))+(q.windows>1?' · '+q.windows+' windows':'')+' · '+ago(q.activity)+'</div></div><button class="xbtn" data-killterm="'+esc(ho.id)+'|'+esc(q.session)+'" data-tip="End this tmux session">×</button></div>'});
    // sessions still in iTerm tabs on this Mac: one click brings their tab forward
    mine.filter(function(x){return x.term==='iterm'}).forEach(function(x){rows.push('<div class="tsterm" data-focus="'+esc(x.tree)+'"><span class="tsdot '+(x.menu||x.claudeState==='waiting'?'claude':x.claudeState==='working'?'work':'')+'"></span><div class="grow"><b>'+esc(treeName(x.tree))+'</b><div class="small muted tsclip">'+esc(x.title||'')+' · iTerm tab</div></div></div>')});
    h+=(rows.length?rows.join(''):'<div class="small muted">Nothing running.</div>')+'</div>'});
  $H('termside').html=h}
document.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('[data-newsess],[data-preset],[data-resume],[data-killterm],[data-closetab],[data-termtab],[data-term],.tsterm[data-focus]');if(!b)return;
  if(b.dataset.newsess){newSessionDialog();return}
  if(b.dataset.preset){startPreset(S.presets[+b.dataset.preset]);return}
  if(b.dataset.resume){resumeTree(b.dataset.resume);return}
  if(b.dataset.killterm){e.stopPropagation();var kv=b.dataset.killterm.split('|');if(!confirm('End tmux session '+kv[1]+'? Whatever runs in it stops'+(/^tw-/.test(kv[1])?', and its worktree goes back to the pool (kept if it has changes)':'')+'.'))return;
    act({op:'kill-term',host:kv[0],session:kv[1]}).then(function(r){toast(r.ok?'Ended '+kv[1]:r.error);if(r.ok)closeTermTab(kv[0]+'/'+kv[1]);refresh()});return}
  if(b.dataset.closetab){e.stopPropagation();closeTermTab(b.dataset.closetab);return}
  if(b.dataset.termtab){showTerm(b.dataset.termtab);return}
  if(b.dataset.term){var tv=b.dataset.term.split('|');openTerm(tv[0],tv[1]);return}
  if(b.dataset.focus){focusTerm(b.dataset.focus)}});
// refit whenever the pane changes size (window, sidebar, the page first laying out)
if(window.ResizeObserver)new ResizeObserver(function(){var t=curTerm();if(t&&view==='terms')fitTerm(t)}).observe($('termhost'));else window.addEventListener('resize',function(){var t=curTerm();if(t&&view==='terms')fitTerm(t)});
// New session: where (host), what (Claude in a fresh worktree or a checkout, Codex, a shell), which repo, and an optional first prompt.
function newSessionDialog(){var H=(S.hosts||[]).filter(function(h){return h.up});if(!H.length){toast('No host is reachable right now');return}
  var st={host:lsGet('treehouse-newhost')||H[0].id,kind:lsGet('treehouse-newkind')||'tree'};if(!H.some(function(h){return h.id===st.host}))st.host=H[0].id;
  var KINDS=[['tree','Claude','in a fresh worktree from the pool','Leases a free worktree from treehouse; it goes back to the pool when Claude exits or you end the session (kept while it has changes).'],
    ['claude','Claude','in a checkout you pick','Runs in a new tmux session; it survives disconnects.'],['codex','Codex','in a checkout you pick','Runs in a new tmux session; it survives disconnects.'],['shell','Shell','a login shell in tmux','A login shell in a new tmux session.']];
  $('dlgBody').innerHTML='<div class="dlghead"><h3>New session</h3><button class="xbtn" id="dlgCancelX" data-tip="Cancel · Esc"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>'+
    '<div class="ns">'+(H.length>1?'<div><span class="nsl">Where</span><div class="seg nswhere" id="nsHost"></div></div>':'')+'<div><span class="nsl">What</span><div class="nskinds" id="nsKind"></div></div>'+
    '<div class="nsrow"><div><label class="nsl" for="nsRepo">In</label><select id="nsRepo" class="ntin"></select></div><div id="nsTitleF"><label class="nsl" for="nsTitle">Name</label><input id="nsTitle" class="ntin" placeholder="Optional" maxlength="50"></div></div>'+
    '<div id="nsPromptF"><label class="nsl" for="nsPrompt">First prompt</label><textarea id="nsPrompt" class="ntin" rows="5" placeholder="Optional. What should it do? Files, the bug, what done looks like."></textarea></div></div>'+
    '<div class="nsfoot"><button id="dlgCancel">Cancel</button><button class="primary" id="dlgGo">Start<span class="nskbd">⌘↵</span></button></div>';
  function paint(){var h=H.find(function(x){return x.id===st.host});
    if($('nsHost'))$('nsHost').innerHTML=H.map(function(x){return '<button data-nshost="'+esc(x.id)+'" class="'+(x.id===st.host?'on':'')+'">'+esc(x.label)+'</button>'}).join('');
    $('nsKind').innerHTML=KINDS.map(function(k){return '<button data-nskind="'+k[0]+'" data-tip="'+esc(k[3])+'" class="'+(k[0]===st.kind?'on':'')+'"><b>'+k[1]+'</b><span>'+k[2]+'</span></button>'}).join('');
    var want=lsGet('treehouse-newrepo-'+st.host)||'',repos=(h.repos||[]).slice();
    if(st.kind==='tree')repos.sort(function(a,b){return (b.pool-a.pool)||(b.at-a.at)});
    $('nsRepo').innerHTML=repos.map(function(r){return '<option value="'+esc(r.path)+'"'+(r.path===want?' selected':'')+'>'+esc(r.name)+(r.pool?'  · has worktrees':'')+'</option>'}).join('')+(st.kind==='tree'?'':'<option value="~"'+(want==='~'?' selected':'')+'>~ (home)</option>');
    $('nsTitleF').hidden=$('nsPromptF').hidden=st.kind==='shell';
    segVars&&document.querySelectorAll('#dlgBody .seg').forEach(segVars)}
  paint();$('dlg').showModal();
  $('dlgBody').onclick=function(e){var b=e.target.closest('[data-nshost],[data-nskind]');if(!b)return;if(b.dataset.nshost)st.host=b.dataset.nshost;if(b.dataset.nskind)st.kind=b.dataset.nskind;paint()};
  $('dlgCancel').onclick=$('dlgCancelX').onclick=function(){$('dlg').close()};
  function go(){var repo=$('nsRepo').value;if(!repo){toast('No checkout to start in on that host');return}lsSet('treehouse-newhost',st.host);lsSet('treehouse-newkind',st.kind);lsSet('treehouse-newrepo-'+st.host,repo);$('dlg').close();
    toast(st.kind==='tree'?'Leasing a worktree…':'Starting…');
    act({op:'spawn',host:st.host,kind:st.kind,repo:repo,title:$('nsTitle').value.trim(),prompt:st.kind==='shell'?'':$('nsPrompt').value}).then(function(r){if(!r.ok){toast('Not started: '+r.error);return}openTerm(r.host,r.session);refresh()})}
  $('dlgGo').onclick=go;$('nsPrompt').onkeydown=function(e){if(e.key==='Enter'&&(e.metaKey||e.ctrlKey)){e.preventDefault();go()}};setTimeout(function(){st.kind==='shell'?$('dlgGo').focus():$('nsPrompt').focus()},0)}
</script></body></html>`;
