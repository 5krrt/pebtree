// New content never moves you: only when you are already at the bottom does the log follow it; otherwise
// you stay where you are reading and the jump button says there is something new.
function paintConvo(toBottom,keepTop,prepend){var tree=CONVO,x=S.sessions.find(function(s){return s.tree===tree});if(!tree||!x)return;var h=CHAT[tree],log=$('cvlog'),off=log?log.scrollHeight-log.scrollTop:0,wasBottom=!log||log.scrollHeight-log.scrollTop-log.clientHeight<40,oldH=log?log.scrollHeight:0;if(!toBottom&&!prepend){if(wasBottom)toBottom=true;else keepTop=true}
  var shown=h.items.slice(-h.n),norm2=function(t){return String(t||'').replace(/\s+/g,' ').trim()};
  // the newest reply may already be in the history (once you send, your message is last): mark it there, never add it twice
  var lastC=-1;shown.forEach(function(m,i){if(m.who==='claude'&&!m.kind)lastC=i});var inHist=lastC>=0&&norm2(shown[lastC].text)===norm2(x.lastSay);
  var seen={};shown.forEach(function(m){if(m.who==='you')seen[norm2(m.text)]=1});
  var headH=postTop(x)+''+headActs(x,true)+'<span class="small muted cvwhen">waiting '+ago(x.lastActive).replace(' ago','')+'</span><button class="iconbtn" data-closeconvo="1" data-tip="Close · Esc"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>',logH=(h.loading?'<p class="small muted">Loading…</p>':(h.n<h.items.length?'<button class="earlier more" data-more="'+tree+'"><svg viewBox="0 0 24 24"><path d="M6 15l6-6 6 6"/></svg>Load earlier</button>':'<div class="small muted cvstart">'+(h.items.length?'Start of recent history':'No earlier messages')+'</div>')+shown.map(function(m,i){return bubble(m,inHist&&i===lastC)}).join('')+(x.lastSay&&!inHist?bubble({who:'claude',text:x.lastSay,at:x.lastActive},true):'')+askBox(x)+decInline(x)+sentHtml(x,seen))+'<div class="cvlive'+(LIVEV.on?' on':'')+'" id="cvlive">'+LIVEV.html+'</div><div class="cvdraft'+(LIVEV.draft?' on':'')+'" id="cvdraft">'+LIVEV.dhtml,body=$('convoBody');
  if(body._tree!==tree){body._tree=tree;body.innerHTML='<div class="cvhead" id="cvhead"></div><div class="cvmain"><div class="cvchat"><div class="cvlog" id="cvlog"></div><button class="jumpbtn" id="cvjump" data-tip="Jump to the latest message">↓ Latest</button><div class="yt-reply cv-reply"><div class="attachrow" data-attach="'+tree+'"></div><div class="yt-row"><textarea placeholder="Reply to '+treeName(tree)+' · Enter to send · drop images, files or folders" data-reply="'+tree+'"></textarea><span class="ghosthint">Tab</span><button class="primary sendbtn" data-send="'+tree+'" data-tip="Send · Enter"><span>Send</span><svg viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6"/></svg></button></div></div></div><div class="cvsplit" id="cvsplit" data-tip="Drag to resize · double-click to reset"></div><aside class="cvside" id="cvside"></aside></div>';
    $('cvlog').addEventListener('scroll',syncJump);var sw=+lsGet('treehouse-cvside')||0;if(sw)body.querySelector('.cvmain').style.setProperty('--sidew',sw+'px');$('cvside').innerHTML=safeSide(x);toBottom=true;var nta=document.querySelector('#convo textarea');if(nta){nta.value=DRAFT[tree]||'';growBox(nta);setTimeout(function(){nta.focus();nta.setSelectionRange(nta.value.length,nta.value.length)},0)}}
  var hd=$('cvhead');if(hd._h!==headH&&(FORCEHEAD||!hd.matches(':hover')&&!hd.querySelector('.topicedit'))){hd._h=headH;hd.innerHTML=headH}FORCEHEAD=false;
  if(SUBVIEW&&SUBVIEW.tree===tree)logH=subLogH();
  if($('cvlog')&&$('cvlog').contains(document.activeElement)&&!FORCE[tree]&&!toBottom){syncJump();return} // you are typing in a box inside the conversation
  var nl=$('cvlog');if(nl._h===logH){syncJump();return}
  // never redraw under a selection or a press: it drops what you are copying and eats the click on a link
  if(!FORCE[tree]&&(CVHOLD||selIn(nl))){nl._stale=1;syncJump();return}
  var oldTop=nl.scrollTop;nl._h=logH;nl._stale=0;nl.innerHTML=logH;nl.scrollTop=toBottom?nl.scrollHeight:keepTop?oldTop:nl.scrollHeight-off;if(keepTop&&nl.scrollHeight>oldH+4)NEWBELOW=true;syncJump()}
var NEWBELOW=false;
function syncJump(){var l=$('cvlog'),b=$('cvjump');if(!l||!b)return;var away=l.scrollHeight-l.scrollTop-l.clientHeight;if(away<40)NEWBELOW=false;b.classList.toggle('on',away>120||NEWBELOW&&away>=40);b.classList.toggle('new',NEWBELOW);var t=NEWBELOW?'↓ New messages':'↓ Latest';if(b.textContent!==t)b.textContent=t}
function postComposer(x){
