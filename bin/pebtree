addEventListener('scroll',closePathMenu,true);
function md(t){
  var out=[],list=null,code=null,table=null,lang='';
  function inline(x){return esc(x).replace(/\x60([^\x60]+)\x60/g,'<code>$1</code>').replace(/\*\*([^*]+)\*\*/g,'<b>$1</b>').replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g,'<a href="$2" target="_blank">$1</a>').replace(/(^|\s)(https?:\/\/[^\s<]+)/g,'$1<a href="$2" target="_blank">$2</a>')}
  function cells(l){return l.trim().replace(/^\|/,'').replace(/\|$/,'').split('|').map(function(c){return c.trim()})}
  function closeTable(){if(table){out.push('<div class="mdtable"><table><thead><tr>'+table[0].map(function(c){return '<th>'+inline(c)+'</th>'}).join('')+'</tr></thead><tbody>'+table.slice(1).map(function(r){return '<tr>'+r.map(function(c){return '<td>'+inline(c)+'</td>'}).join('')+'</tr>'}).join('')+'</tbody></table></div>');table=null}}
  function close(){if(list){out.push('</'+list+'>');list=null}closeTable()}
  String(t||'').split('\n').forEach(function(line){
    var m;
    if(code!==null){if(/^\s*\x60\x60\x60/.test(line)){out.push(codeBlock(code.join('\n'),lang));code=null}else code.push(line);return}
    if(/^\s*\x60\x60\x60/.test(line)){close();code=[];lang=(line.trim().slice(3).trim().split(/\s/)[0]||'').toLowerCase();return}
    if(/^\s*\|.*\|\s*$/.test(line)){if(list){out.push('</'+list+'>');list=null}if(/^\s*\|?[\s:|-]+\|?\s*$/.test(line)&&line.indexOf('-')>=0)return;(table=table||[]).push(cells(line));return}
    closeTable();
    if((m=line.match(/^\s*[-*]\s+(.*)/))){if(list!=='ul'){close();out.push('<ul>');list='ul'}out.push('<li>'+inline(m[1])+'</li>')}
    else if((m=line.match(/^\s*\d+[.)]\s+(.*)/))){if(list!=='ol'){close();out.push('<ol>');list='ol'}out.push('<li>'+inline(m[1])+'</li>')}
    else if((m=line.match(/^#{1,6}\s+(.*)/))){close();out.push('<p><b>'+inline(m[1])+'</b></p>')}
    else if(!line.trim()){close()}
    else{close();out.push('<p>'+inline(line)+'</p>')}
  });
  if(code!==null)out.push(codeBlock(code.join('\n'),lang));
  close();return linkPaths(out.join(''));
}
