function submitAsk(tree){var x=S.sessions.find(function(q){return q.tree===tree});if(!x||!x.ask)return;var sel=ASKSEL[tree];ASKDONE[tree]=x.ask.id;repaintAsk(tree);toast('Answering '+treeName(tree)+'…');
