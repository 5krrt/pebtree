function sessionCard(x){var st=sessState(x),since=x.claudeState==='working'?'active '+ago(x.lastActive):x.claudeState==='none'?'':(st.cls==='waiting'?'waiting ':'idle ')+ago(x.lastActive).replace(' ago','');
