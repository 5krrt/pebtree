function pressure(){var s=S.sys,sp=s.swapTotalMB?s.swapUsedMB/s.swapTotalMB*100:0;return (s.freePct<15||sp>60)?['bad','under heavy pressure']:(s.freePct<35||sp>25)?['warn','under pressure']:['ok','healthy']}

function renderAlert(){
  var s=S.sys,sp=s.swapTotalMB?s.swapUsedMB/s.swapTotalMB*100:0,servers=S.servers.filter(function(x){return x.kind==='next'||x.kind==='metro'}),orph=S.servers.filter(function(x){return x.orphan}),msgs=[];
  if(sp>50||s.freePct<15)msgs.push('<b>Your Mac is swapping '+gb(s.swapUsedMB)+'.</b> Dev processes use '+gb(S.servers.reduce(function(a,x){return a+x.memMB},0))+'.');
  if(S.settings.serverBudget&&servers.length>S.settings.serverBudget)msgs.push('<b>'+servers.length+' dev servers running</b>, over your budget of '+S.settings.serverBudget+'.');
  if(S.pool&&S.pool.max&&S.pool.inUse>=S.pool.max)msgs.push('<b>Tree pool is full</b> ('+S.pool.inUse+' of '+S.pool.max+'). The next new session cannot get a tree.');
  if(orph.length)msgs.push('<b>'+orph.length+' orphaned process group'+(orph.length>1?'s':'')+'</b> ('+gb(orph.reduce(function(a,x){return a+x.memMB},0))+') whose terminal is gone.');
  $H('alert').html=msgs.length?'<div class="panel alert"><div class="grow">'+msgs.join('<br>')+'</div><button class="primary roundbtn" data-cleanup="all" data-tip="Clean up dev servers" aria-label="Clean up dev servers"><svg viewBox="0 0 24 24"><path d="M15 3.5L12 12" stroke-width="2.2"/><rect x="4" y="12" width="16" height="3.6" rx="1.5" fill="currentColor" stroke="none"/><path d="M6 15.6v4.9M9 15.6v4.9M12 15.6v4.9M15 15.6v4.9M18 15.6v4.9" stroke-width="1.6"/></svg></button></div>':'';
}
var SENT={},LOCKH={},FORCE={},SECT={},RSEQ=0,ARCHOPEN=!!lsGet('treehouse-archopen');
function sortKey(x){return SENT[x.tree]?SENT[x.tree].key:x.lastActive}
// Claude has responded once it posts a new reply, puts a question or permission prompt on screen, or is waiting again
// with activity after your message (a question never changes the reply text, so that alone is not enough).
function settleSent(){S.sessions.forEach(function(x){var m=SENT[x.tree];if(!m)return;if(x.menu&&Date.now()-m.at>1500||x.claudeState==='waiting'&&(x.lastSay!==m.prevSay||x.lastActive>m.at+2000))delete SENT[x.tree]})}
function turnList(){settleSent();return S.sessions.filter(function(x){return !isCrew(x)&&(x.claudeState==='waiting'||x.menu||SENT[x.tree]||(x.pending&&x.pending.length))}).sort(function(a,b){return sortKey(b)-sortKey(a)})}
function plain(t){return String(t||'').replace(/\*\*/g,'').replace(/\x60/g,'')}
function tail(t,n){t=plain(t);return t.length>n?'\u2026'+t.slice(-n):t}
// Light Markdown for Claude's messages: paragraphs, bullets, numbered lists, headings, bold, inline code, links.
// Code blocks carry a copy button (SQL gets "Copy SQL", recognised by its fence or its first keyword).
function codeBlock(c,lang){var sql=lang==='sql'||lang==='postgres'||lang==='psql'||(!lang&&/^\s*(select|with|insert|update|delete|create|alter|drop|begin|set|grant|revoke)\b/i.test(c));return '<div class="codewrap"><button class="codecopy" data-codecopy="1" data-tip="Copy to clipboard">'+(sql?'Copy SQL':'Copy')+'</button><pre class="mdcode"><code>'+esc(c)+'</code></pre></div>'}
// File paths in the chat: click copies, right-click offers Show in Finder / Open / Copy. Works on rendered HTML:
// only text between tags is touched, and never inside a link.
var PATHRE=/(^|[\s(\[>"'\x60:])((?:~|\/(?:Users|private|tmp|var|opt|Applications|Volumes|Library|usr|etc))(?:\/[^\s<>"'\x60)\]]*)?[^\s<>"'\x60)\].,;:!?])/g;
function linkPaths(html){var inA=0,prev='';return String(html).split(/(<[^>]+>)/).map(function(part){if(part.charAt(0)==='<'){if(/^<a[\s>]/i.test(part))inA++;else if(/^<\/a>/i.test(part))inA=Math.max(0,inA-1);prev=part;return part}
  var wasCode=/^<code>$/i.test(prev);prev='';if(inA||part.indexOf('/')<0)return part;
  // a code span that is just a path is the whole path, spaces included
  if(wasCode&&/^(~|\/)[^<>]*[^\s.,;:]$/.test(part)&&/^(~\/|\/(Users|private|tmp|var|opt|Applications|Volumes|Library|usr|etc)\b)/.test(part))return '<span class="fpath" data-fpath="'+part.replace(/&amp;/g,'&').replace(/"/g,'&quot;')+'">'+part+'</span>';return part.replace(PATHRE,function(m,pre,p){if(p==='~'||p.length<3)return m;var raw=p.replace(/&amp;/g,'&');return pre+'<span class="fpath" data-fpath="'+raw.replace(/"/g,'&quot;')+'">'+p+'</span>'})}).join('')}
var PMENU=null;function closePathMenu(){if(PMENU){PMENU.remove();PMENU=null}}
function pathAct(p,reveal){act({op:'path-open',path:p,reveal:reveal}).then(function(r){if(!r.ok)toast('Could not open: '+r.error)})}
function copyPath(p){(navigator.clipboard?navigator.clipboard.writeText(p):Promise.reject()).then(function(){toast('Copied '+p)},function(){toast('Copy failed')})}
document.addEventListener('click',function(e){var f=e.target.closest&&e.target.closest('[data-fpath]');if(f){e.preventDefault();e.stopPropagation();closePathMenu();copyPath(f.dataset.fpath);return}
  var m=e.target.closest&&e.target.closest('[data-pmenu]');if(m){e.stopPropagation();var pr=m.dataset.pmenu,p=PMENU&&PMENU.dataset.path;closePathMenu();if(!p)return;if(pr==='copy')copyPath(p);else pathAct(p,pr==='reveal');return}
  if(PMENU&&!e.target.closest('.pathmenu'))closePathMenu()},true);
document.addEventListener('contextmenu',function(e){var f=e.target.closest&&e.target.closest('[data-fpath]');if(!f){closePathMenu();return}e.preventDefault();closePathMenu();
  var host=f.closest('dialog[open]')||document.body;PMENU=document.createElement('div');PMENU.className='pathmenu';PMENU.dataset.path=f.dataset.fpath;
  PMENU.innerHTML='<div class="pmh mono">'+esc(f.dataset.fpath.replace(/^\/Users\/[^/]+/,'~'))+'</div><button data-pmenu="reveal">Show in Finder</button><button data-pmenu="open">Open</button><button data-pmenu="copy">Copy path</button>';
  host.appendChild(PMENU);var w=PMENU.offsetWidth,h=PMENU.offsetHeight,x=Math.min(e.clientX,innerWidth-w-8),y=Math.min(e.clientY,innerHeight-h-8);PMENU.style.left=x+'px';PMENU.style.top=y+'px';
  var g=PMENU.getBoundingClientRect();if(Math.abs(g.left-x)>4||Math.abs(g.top-y)>4){PMENU.style.left=(2*x-g.left)+'px';PMENU.style.top=(2*y-g.top)+'px'}},true);
