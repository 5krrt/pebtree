  chart('ch-cpu-tree',{series:treeSeries('treeCpu','ch-cpu-tree'),stacked:true,fmt:function(v){return Math.round(v)+'%'}});
  chart('ch-servers',{series:[{name:'Dev servers',color:'var(--warn)',get:function(p){return p.servers||0}}],fmt:function(v){return (+v).toFixed(v%1?1:0)},yMax:4*Math.ceil((Math.max.apply(null,[0].concat(histFor('ch-servers').map(function(p){return p.servers||0})))+1)/4),area:true,height:130});
  chart('ch-working',{series:[{name:'Working',color:'var(--work)',get:function(p){return p.working||0}}],fmt:function(v){return (+v).toFixed(v%1?1:0)},yMax:4*Math.ceil((Math.max.apply(null,[0].concat(histFor('ch-working').map(function(p){return p.working||0})))+1)/4),area:true,height:130});
  var RH=histFor('res-table');var rows=treeSeries('trees','res-table').map(function(se){var id=se.name==='main'?'main':se.name.replace('tree ',''),vals=RH.map(se.get),cpu=RH.map(function(p){return (p.treeCpu||{})[id]||0}),now=S.sessions.find(function(x){return x.tree===id});
    return {id:id,now:now?now.memMB:0,peak:Math.max.apply(null,vals),avg:vals.reduce(function(a,b){return a+b},0)/vals.length,cpu:cpu.reduce(function(a,b){return a+b},0)/cpu.length}});
  $H('res-table').html='<table><thead><tr><th>Tree</th><th class="num">Now</th><th class="num">Typical</th><th class="num">Highest</th><th class="num">Typical CPU</th></tr></thead><tbody>'+rows.map(function(r){return '<tr><td>'+treeIcon(r.id,20)+'<b>'+treeName(r.id)+'</b></td><td class="num mono">'+gb(r.now)+'</td><td class="num mono">'+gb(r.avg)+'</td><td class="num mono">'+gb(r.peak)+'</td><td class="num mono">'+r.cpu.toFixed(1)+'%</td></tr>'}).join('')+'</tbody></table>';
}
