function isCaptain(x){var c=capSession();return !!(c&&x&&c.tree===x.tree)}
function crewList(){return (S.sessions||[]).filter(isCrew)}
function capBadge(x){if(!isCaptain(x))return '';var crew=crewList();
  var menu=crew.length?crew.map(function(w){var st=sessState(w),task=w.task?w.task.title:((w.tabNamed?w.title:humanize(w.title))||'');return '<button class="crewitem" data-convo="'+w.tree+'">'+treeIcon(w.tree,20)+'<span class="ci"><b>'+treeName(w.tree)+'</b><span>'+esc(task)+'</span></span><span class="pill '+st.cls+'">'+st.label+'</span>'+(w.menu?'<span class="pill waiting">?</span>':'')+'</button>'}).join(''):'<div class="small muted" style="padding:6px 8px">No crew working right now</div>';
  return '<span class="capic" data-tip="Captain">'+WHEEL+'</span><span class="crewpill"><span class="pill agentpill">'+crew.length+' crew</span><span class="crewmenu"><span class="crewh">Crew · click one to open it</span>'+menu+'</span></span>'}
// A captain's worker: on today's board with a tree, or named worker-N. Workers are the captain's to run, so the
// feed leaves them out; they live in the Captain page's crew column.
function isCrew(x){if(!x||x.tree==='main')return false;if(/^(✳\s*)?worker[-\s]?\d+$/i.test(String(x.title||'').trim()))return true;return !!(x.task&&capSession())}
function capSession(){return (S.sessions||[]).find(function(x){return x.claudeState!=='none'&&/^(✳\s*)?master$/i.test(String(x.title||'').trim())})}
function renderCaptain(){var box=$('captain');
  if(!box._built){box.innerHTML='<div class="cols2 capcols panes"><div class="col"><div class="panel cappanel" id="cap-top"></div></div><div class="col"><div class="panel" id="cap-workers"></div><div class="col" id="cap-board"></div></div></div>';box._built=1}
  var cap=capSession(),top=$('cap-top'),mode=cap?'run:'+cap.tree:'start';
  if(top._mode!==mode){top._mode=mode;top.classList.toggle('running',!!cap);top.innerHTML=cap?'<div class="yt" id="cap-me"></div>':
    '<div class="ptitle" style="margin-bottom:4px"><b>Start a captain</b></div><p class="small muted" style="margin:0 0 10px">One session that splits your list into tasks and runs a worker tree for each.</p><textarea id="capObj" class="ntin" rows="5" placeholder="Today\'s objectives, one per line&#10;Fix the leaderboard avatars on mobile&#10;Add the refund filter to admin withdrawals"></textarea><div class="row" style="justify-content:flex-end;gap:8px;margin-top:10px"><span class="small muted grow">It takes a free tree, shows you its plan and waits for your go-ahead before starting workers. ⌘Enter to start.</span><button class="primary" id="capGo">Start captain</button></div>'}
  // the captain is the same card as the feed's, with every feed interaction
  if(cap)syncPosts($('cap-me'),[cap],false,false);
  // Crew: the same cards as the feed, one per worker tree on the board, with every feed interaction.
  var b=S.board,tasks=b?b.tasks:[],wk=$('cap-workers');
  if(!wk._built){wk.innerHTML='<div class="ptitle"><b>Crew</b><span class="v muted small" id="cap-crew-sub"></span></div><div class="capqueued" id="cap-queued"></div><div class="yt" id="cap-crew-list"></div><div class="empty" id="cap-crew-empty"></div>';wk._built=1}
  var tnum=function(t){var m=String(t.tree).match(/\bmain\b|\d+/i);return m?m[0].toLowerCase():''},crew=[],seen={},queued=[];
  tasks.forEach(function(t){var x=(S.sessions||[]).find(function(q){return q.tree===tnum(t)});if(x&&!seen[x.tree]&&!/merged|dropped/.test(t.state)){seen[x.tree]=1;crew.push(x)}else if(!x&&!/merged|dropped/.test(t.state))queued.push(t)});
  // the captain names every worker worker-N, so a worker counts as crew even before its tree is on the board
  (S.sessions||[]).forEach(function(x){if(!seen[x.tree]&&x.claudeState!=='none'&&/^(✳\s*)?worker[-\s]?\d+$/i.test(String(x.title||'').trim())){seen[x.tree]=1;crew.push(x)}});
  var open=tasks.filter(function(t){return !/merged|dropped/.test(t.state)}).length;
  $('cap-crew-sub').textContent=b?crew.length+' at work · '+queued.length+' queued · '+(tasks.length-open)+' done · board '+ago(b.updated):'no board yet';
  $H('cap-queued').html=queued.length?'<div class="small muted" style="margin-bottom:6px">Queued, no tree yet</div>'+queued.map(function(t){return '<span class="pill" data-tip="'+esc(t.id+' · '+t.state+(t.update&&t.update!=='-'?' · '+t.update:''))+'">'+esc(t.title)+'</span>'}).join(' '):'';
  var list=$('cap-crew-list');CREWSEQ++;syncPosts(list,crew,false,false);
  [].slice.call(list.children).forEach(function(el){if(!crew.some(function(x){return x.tree===el.dataset.tree})&&!el.contains(document.activeElement))el.remove()});
  $('cap-crew-empty').textContent=crew.length||queued.length?'':(cap?'The captain has not started any workers yet.':'Its crew (one worker tree per task) shows here once a captain is running.');
  renderCaptainBoard();var pn=document.querySelector('#v-captain .panes');if(pn&&!pn.style.height)sizeFeed()}
