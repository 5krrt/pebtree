var TOKEN='__TOKEN__',BUILD='__BUILD__';
// pebtree was updated: reload into the new version once you are not mid-reply, and reopen the conversation you had open.
// It never reloads under you: right away only while the tab is in the background, otherwise after a minute
// with no mouse or keys, and meanwhile a small button lets you take the update when it suits you.
var LASTINPUT=Date.now(),LASTACT=0;['pointerdown','keydown','wheel','pointermove'].forEach(function(t){addEventListener(t,function(){LASTINPUT=Date.now();if(t!=='pointermove')LASTACT=LASTINPUT},{passive:true,capture:true})});
// Updates from pebtree never land in the middle of a keystroke or click: they wait until you pause (at most
// 500ms), then draw on the next frame. A hidden tab draws nothing until you come back to it.
var DRQ=0;function dataRender(){if(DRQ)return;DRQ=1;var since=Date.now();(function go(){if(document.hidden){DRQ=2;return}var q=Date.now()-LASTACT;if(q<150&&Date.now()-since<500){setTimeout(go,150-q);return}requestAnimationFrame(function(){DRQ=0;if(S&&!S.loading)render()})})()}
document.addEventListener('visibilitychange',function(){if(!document.hidden&&DRQ===2){DRQ=0;dataRender()}});
function doReload(){try{if($('convo').open&&CONVO)sessionStorage.setItem('pebtree-reopen',CONVO)}catch(e){}location.reload()}
function maybeReload(build){if(!build||build===BUILD)return;var b=$('updbtn');if(b)b.classList.add('on');
  var ae=document.activeElement,busy=!!(ae&&(ae.tagName==='TEXTAREA'||ae.tagName==='INPUT'))||$('dlg').open||$('cmdk').open;if(busy)return;
  if(document.hidden||Date.now()-LASTINPUT>60000)doReload()}
document.addEventListener('visibilitychange',function(){if(document.hidden&&S&&S.build&&S.build!==BUILD)maybeReload(S.build)});
// Trees and sessions are "<host>:<repo>:<slot>" (slot: a pool number, main for a checkout, dir for a plain folder);
// S.ids names each one ("cbc-ditto 24") and says which host it is on.
function idMeta(t){return (S&&S.ids&&S.ids[t])||null}
function slotOf(t){var m=idMeta(t);if(m)return m.slot;var p=String(t).split(':');return p.length>2?p[2]:String(t)}
function hashT(t){var h=0;t=String(t);for(var i=0;i<t.length;i++)h=(h*31+t.charCodeAt(i))|0;return Math.abs(h)}
function isMainT(t){var s=slotOf(t);return t==='main'||s==='main'||s==='dir'}
// the saturated series colors of Stacked's revenue chart
var PALETTE=['#22C55E','#3B82F6','#A855F7','#EC4899','#F59E0B','#14B8A6','#978DFF','#FF4259','#06B6D4','#84CC16','#F97316','#6366F1','#D946EF','#EAB308','#10B981','#60A5FA','#C084FC','#FB7185','#FBBF24','#2DD4BF'];
function colorFor(t){if(isMainT(t))return '#898989';var n=parseInt(slotOf(t),10);return PALETTE[((n||hashT(t)+1)-1)%PALETTE.length]}
function $(id){return document.getElementById(id)}
function $H(id){return {set html(v){var e=$(id);if(e&&e._h!==v){e._h=v;e.innerHTML=v}}}}
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function gb(mb){return mb>=1024?(mb/1024).toFixed(1)+' GB':Math.round(mb)+' MB'}
function ago(t){if(!t)return 'never';var s=(Date.now()-t)/1000;if(s<60)return 'just now';if(s<3600)return Math.floor(s/60)+'m ago';if(s<86400)return Math.floor(s/3600)+'h ago';return Math.floor(s/86400)+'d ago'}
function dur(s){return s<3600?Math.floor(s/60)+'m':s<86400?Math.floor(s/3600)+'h':Math.floor(s/86400)+'d'}
function simPills(x){return (x.sims||[]).map(function(m){return ' <span class="pill simpill'+(m.connected?'':' off')+'" title="'+esc(m.name+' · '+m.runtime+(m.metroPort?' · Metro :'+m.metroPort:' · app not connected to a dev server'))+'"><svg viewBox="0 0 24 24"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/></svg>'+esc(m.model)+(m.connected?'':' · not connected')+'</span>'}).join('')}
function treeName(t){var m=idMeta(t);if(m)return m.label+(m.local?'':' · '+m.hostLabel);var p=String(t).split(':');if(p.length>2){var loc=S&&S.hosts&&S.hosts.some(function(h){return h.local&&h.id===p[0]});return (p[2]==='main'||p[2]==='dir'?p[1]:p[1]+' '+p[2])+(loc?'':' · '+p[0])}return t==='main'?'main':'tree '+t}
var S=null,COARSE=[],coarseAt=0,CR=(function(){try{return JSON.parse(lsGet('treehouse-chart-ranges')||'{}')}catch(e){return {}}})(),view=(location.hash||'#overview').slice(1);
// Layout prefs live on the dashboard server (window.__UI) so any browser or window gets them; localStorage is only a fallback.
function lsGet(k){if(Object.prototype.hasOwnProperty.call(window.__UI,k))return window.__UI[k];try{return localStorage.getItem(k)}catch(e){return null}}
var UI_PENDING={},UI_TIMER=0;
function lsSet(k,v){v=v==null?'':String(v);try{localStorage.setItem(k,v)}catch(e){}if(v)window.__UI[k]=v;else delete window.__UI[k];UI_PENDING[k]=v;clearTimeout(UI_TIMER);UI_TIMER=setTimeout(function(){var set=UI_PENDING;UI_PENDING={};act({op:'uiprefs',set:set})},400)}
// one-time: carry over prefs this browser already had
// prefs for looks pebtree no longer has (light/dark theme, styles, theme profiles): forget them here and on the server
try{var mig={};['devdeck-theme','treehouse-style','treehouse-profiles'].forEach(function(k){if(Object.prototype.hasOwnProperty.call(window.__UI,k)||localStorage.getItem(k)!==null){mig[k]='';delete window.__UI[k];localStorage.removeItem(k)}});for(var i=0;i<localStorage.length;i++){var lk=localStorage.key(i);if(/^(treehouse|devdeck)-/.test(lk)&&!Object.prototype.hasOwnProperty.call(window.__UI,lk)){mig[lk]=localStorage.getItem(lk);window.__UI[lk]=mig[lk]}}if(Object.keys(mig).length)setTimeout(function(){act({op:'uiprefs',set:mig})},0)}catch(e){}
function toast(m){var t=$('toast');t.textContent=m;t.classList.add('on');clearTimeout(t._h);t._h=setTimeout(function(){t.classList.remove('on')},3500)}
// A failed connection means the request never reached pebtree (it finishes in-flight requests before it
// stops), so retrying through a restart cannot do anything twice.
function act(body,tries){body.token=TOKEN;tries=tries||0;return fetch('/api/action',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(function(r){return r.json().then(function(j){if(j&&j.locked){showLock();j.error='pebtree is locked'}return j})},function(err){if(tries>=8)throw err;if(tries===0)toast('pebtree is restarting…');return new Promise(function(res){setTimeout(res,700)}).then(function(){return act(body,tries+1)})}).then(function(r){if(r&&r.error==='token'){toast('Dashboard restarted, reloading…');setTimeout(function(){location.reload()},600)}return r})}

/* ---------- chart ---------- */
function niceMax(v){if(v<=0)return 1;var p=Math.pow(10,Math.floor(Math.log10(v))),n=v/p;return (n<=1?1:n<=2?2:n<=2.5?2.5:n<=5?5:10)*p}
function fmtTime(t,span){return new Date(t).toLocaleTimeString([],span<600000?{hour:'numeric',minute:'2-digit',second:'2-digit'}:{hour:'numeric',minute:'2-digit'})}
var RANGE_MS={'15m':900000,'1h':3600000,'6h':21600000,'24h':86400000};
function rangeOf(rid){return RANGE_MS[CR[rid]]?CR[rid]:'1h'}
function needCoarse(){return Object.keys(CR).some(function(k){return RANGE_MS[CR[k]]>RANGE_MS['1h']})}
function histFor(rid){var span=RANGE_MS[rangeOf(rid)],now=S.at||Date.now(),src=span<=RANGE_MS['1h']?S.history:COARSE.concat(S.history.length?[S.history[S.history.length-1]]:[]);return src.filter(function(p){return p.t>=now-span})}
// Tree memory adds up shared memory once per process, so it can spike past the Mac's RAM. Those charts use a
// fixed scale of 1.25x the RAM (30 GB on 24 GB): it never jumps as history loads, and a spike runs along the top.
function memCap(){return (S.sys&&S.sys.totalMB||24576)*1.25}
var CHART_RO=window.ResizeObserver?new ResizeObserver(function(es){var moved=false;es.forEach(function(e){var w=Math.round(e.contentRect.width);if(w&&w!==e.target._w){e.target._w=w;moved=true}});if(moved)dataRender()}):null;
function chart(id,opt){
  var el=$(id);if(!el)return;if(!el._ro&&CHART_RO){el._ro=1;CHART_RO.observe(el)}var w=el._w||(el._w=el.clientWidth)||600,h=Math.max(opt.height||Math.round(Math.min(340,Math.max(160,w*0.42))),opt.minHeight||0),padL=46,padB=20,padT=6,padR=6;
  var pts=histFor(opt.rid||id);if(pts.length<2){el._key='';$H(id).html='<div class="empty" style="height:'+h+'px">Collecting data. Wider ranges fill in over time.</div>';return}
  var t0=pts[0].t,t1=pts[pts.length-1].t,span=Math.max(1,t1-t0);
  var key=[w,h,pts.length,t0,t1,coarseAt,opt.yMax,opt.limit,opt.series.map(function(s){return s.name+s.color}).join()].join('|');if(el._key===key)return;el._key=key;
  var series=opt.series.map(function(s){return {name:s.name,color:s.color,vals:pts.map(s.get)}});
  var stackTop=pts.map(function(_,i){return 0});var maxV=0;
  if(opt.stacked){series.forEach(function(s){s.base=stackTop.slice();s.vals.forEach(function(v,i){stackTop[i]+=v||0});s.top=stackTop.slice()});maxV=Math.max.apply(null,stackTop)}
  else series.forEach(function(s){s.vals.forEach(function(v){if(v>maxV)maxV=v})});
  var yMax=opt.yMax||Math.min(niceMax(maxV*1.08),opt.yCap||Infinity);
  var X=function(t){return padL+(t-t0)/span*(w-padL-padR)},Y=function(v){return padT+(1-Math.min(v,yMax)/yMax)*(h-padT-padB)};
  var g='';for(var k=0;k<=4;k++){var v=yMax*k/4,y=Y(v);g+='<line class="gridl" x1="'+padL+'" x2="'+(w-padR)+'" y1="'+y+'" y2="'+y+'"/><text class="axis" x="'+(padL-6)+'" y="'+(y+3.5)+'" text-anchor="end">'+opt.fmt(v)+'</text>'}
  for(var j=0;j<=4;j+=(w<560?2:1)){var tt=t0+span*j/4;g+='<text class="axis" x="'+X(tt)+'" y="'+(h-4)+'" text-anchor="'+(j===0?'start':j===4?'end':'middle')+'">'+fmtTime(tt,span)+'</text>'}
  var paths='';
  series.forEach(function(s){
    if(opt.stacked){var top=s.top.map(function(v,i){return X(pts[i].t).toFixed(1)+','+Y(v).toFixed(1)}),bot=s.base.map(function(v,i){return X(pts[i].t).toFixed(1)+','+Y(v).toFixed(1)}).reverse();
      paths+='<path d="M'+top.join('L')+'L'+bot.join('L')+'Z" fill="'+s.color+'" fill-opacity=".72" stroke="'+s.color+'" stroke-width="1"/>'}
    else{var d=s.vals.map(function(v,i){return (i?'L':'M')+X(pts[i].t).toFixed(1)+','+Y(v||0).toFixed(1)}).join('');
      if(opt.area)paths+='<path d="'+d+'L'+X(t1)+','+Y(0)+'L'+X(t0)+','+Y(0)+'Z" fill="'+s.color+'" fill-opacity=".14"/>';
      paths+='<path d="'+d+'" fill="none" stroke="'+s.color+'" stroke-width="1.7"/>'}
  });
  if(opt.limit)paths+='<line x1="'+padL+'" x2="'+(w-padR)+'" y1="'+Y(opt.limit)+'" y2="'+Y(opt.limit)+'" stroke="var(--bad)" stroke-dasharray="4 4" stroke-width="1"/>';
  el._data={pts:pts,series:series,X:X,opt:opt,padL:padL,padR:padR,w:w,t0:t0,span:span};
  $H(id).html='<svg viewBox="0 0 '+w+' '+h+'" height="'+h+'">'+g+paths+'<line class="xh" x1="0" x2="0" y1="'+padT+'" y2="'+(h-padB)+'" stroke="var(--muted)" stroke-width="1" style="display:none"/></svg><div class="tip"></div>';
  if(!el._bound){el._bound=1;el.addEventListener('mousemove',hover);el.addEventListener('mouseleave',function(){var t=el.querySelector('.tip'),x=el.querySelector('.xh');if(t)t.style.display='none';if(x)x.style.display='none'})}
}
function hover(e){
  var el=e.currentTarget,d=el._data;if(!d)return;var r=el.getBoundingClientRect(),mx=(e.clientX-r.left)*(d.w/r.width);
  var t=d.t0+(mx-d.padL)/(d.w-d.padL-d.padR)*d.span,best=0;d.pts.forEach(function(p,i){if(Math.abs(p.t-t)<Math.abs(d.pts[best].t-t))best=i});
  var x=d.X(d.pts[best].t),xh=el.querySelector('.xh'),tip=el.querySelector('.tip');if(!xh||!tip)return;
  xh.setAttribute('x1',x);xh.setAttribute('x2',x);xh.style.display='';
  var rows=d.series.map(function(s){return {n:s.name,c:s.color,v:s.vals[best]||0}}).filter(function(x){return x.v>0||d.series.length<4});
  if(d.opt.stacked)rows.sort(function(a,b){return b.v-a.v});
  tip.innerHTML='<b>'+new Date(d.pts[best].t).toLocaleTimeString()+'</b>'+rows.slice(0,12).map(function(x){return '<div><i style="background:'+x.c+'"></i>'+esc(x.n)+' <span class="mono" style="float:right;margin-left:14px">'+d.opt.fmt(x.v)+'</span></div>'}).join('');
  tip.style.display='block';var left=x/d.w*r.width+12;if(left+tip.offsetWidth>r.width)left=x/d.w*r.width-tip.offsetWidth-12;tip.style.left=left+'px';tip.style.top='4px';
}
function treeSeries(key,rid){
  var H=histFor(rid);var ids={};H.forEach(function(p){Object.keys(p[key]||{}).forEach(function(k){ids[k]=1})});
  return Object.keys(ids).sort(function(a,b){return (a==='main'?-1:+a)-(b==='main'?-1:+b)}).map(function(k){return {name:treeName(k),color:colorFor(k),get:function(p){return (p[key]||{})[k]||0}}});
}

