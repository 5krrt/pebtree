(function(){var drag=null,from='',mark=null,tgt=null;
  var SECEL={pinned:'yt-pinned',fresh:'yt-list',parked:'yt-parked',archive:'yt-archive'};
  function secAt(el){if(!el||!el.closest)return '';return el.closest('#yt-pinned')?'pinned':el.closest('#yt-head,#yt-list,#yt-empty')?'fresh':el.closest('#yt-parked')?'parked':el.closest('#yt-archive')?'archive':''}
  function setTgt(sec){var el=sec&&sec!=='fresh'?$(SECEL[sec]):sec==='fresh'&&from!=='fresh'?$('yt-list'):null;if(tgt===el)return;if(tgt)tgt.classList.remove('droptgt');tgt=el;if(el)el.classList.add('droptgt')}
  document.addEventListener('pointerdown',function(e){var h=e.target.closest&&e.target.closest('#yourturn .post-head');if(!h||e.button!==0||e.target.closest('button,a,input,textarea')||h.closest('#yt-working-list'))return;var post=h.closest('.post');post.setAttribute('draggable','true');setTimeout(function(){if(!drag)post.removeAttribute('draggable')},800)});
  document.addEventListener('dragstart',function(e){var post=e.target.closest&&e.target.closest('#yourturn .post');if(!post||post.closest('#yt-working-list'))return;drag=post;from=PINS[post.dataset.tree]?'pinned':secOf(post);post.classList.add('dragging');document.body.classList.add('cardrag');e.dataTransfer.effectAllowed='move';e.dataTransfer.setData('text/plain',post.dataset.tree)});
  document.addEventListener('dragover',function(e){if(!drag)return;var sec=secAt(e.target);if(!sec){setTgt('');if(mark&&mark.parentNode)mark.parentNode.removeChild(mark);return}e.preventDefault();setTgt(sec);
    if(sec!=='fresh'||from!=='fresh'){if(mark&&mark.parentNode)mark.parentNode.removeChild(mark);return}
    var list=$('yt-list');mark=mark||Object.assign(document.createElement('div'),{className:'dropmark'});var before=null;
    [].slice.call(list.querySelectorAll('.post')).some(function(p){if(p===drag)return false;var r=p.getBoundingClientRect();if(e.clientY<r.top+r.height/2){before=p;return true}return false});
    list.insertBefore(mark,before)});
  document.addEventListener('drop',function(e){if(!drag)return;e.preventDefault();var sec=secAt(e.target),t=drag.dataset.tree;
    if(sec==='fresh'&&from==='fresh'){var list=$('yt-list');if(mark&&mark.parentNode===list)list.insertBefore(drag,mark);finish(true);return}
    finish(false);if(sec&&sec!==from)moveTo(t,sec)});
  document.addEventListener('dragend',function(){finish(false)});
  function finish(save){if(!drag)return;drag.classList.remove('dragging');drag.removeAttribute('draggable');document.body.classList.remove('cardrag');setTgt('');if(mark&&mark.parentNode)mark.parentNode.removeChild(mark);mark=null;
    if(save){ORDER=[].slice.call($('yt-list').querySelectorAll('.post')).map(function(p){return p.dataset.tree});lsSet('treehouse-cardorder',JSON.stringify(ORDER))}drag=null;from='';render()}})();
