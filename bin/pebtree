(function(){var tip=null,cur=null;document.addEventListener('mouseover',function(e){var t=e.target.closest&&e.target.closest('[data-tip]');if(t===cur)return;cur=t;tip=tip||$('tip');if(!t){tip.classList.remove('on');return}
  // an open <dialog> sits in the browser's top layer, above everything in the page: the tip has to live inside it
  var host=t.closest('dialog[open]')||document.body;if(tip.parentNode!==host)host.appendChild(tip);
  tip.textContent=t.dataset.tip;var r=t.getBoundingClientRect(),w=tip.offsetWidth,h=tip.offsetHeight,x=Math.max(8,Math.min(innerWidth-w-8,r.left+r.width/2-w/2)),y=r.top-h-7<8?r.bottom+7:r.top-h-7;
  tip.style.left=x+'px';tip.style.top=y+'px';var g=tip.getBoundingClientRect();if(Math.abs(g.left-x)>4||Math.abs(g.top-y)>4){tip.style.left=(2*x-g.left)+'px';tip.style.top=(2*y-g.top)+'px'}tip.classList.add('on')});
  document.addEventListener('scroll',function(){if(tip)tip.classList.remove('on');cur=null},true)})();
