function prBlock(p){if(p.state!=='open'&&p.state!=='draft')return '';var b=[];if(p.merge==='dirty')b.push('<span class="pill bad">conflicts</span>');else if(p.merge==='behind')b.push('<span class="pill warn">behind</span>');else if(p.merge==='clean')b.push('<span class="pill ok">ready</span>');else if(p.merge==='blocked')b.push('<span class="pill">blocked</span>');else if(p.merge==='unstable')b.push('<span class="pill warn">checks</span>');if(p.failing)b.push('<span class="pill bad">'+p.failing+' failing</span>');return b.join(' ')||'<span class="muted small">-</span>'}
