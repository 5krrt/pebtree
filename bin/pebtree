  var mm=lsGet('treehouse-memmode')==='bars'?'bars':'chart';
  document.querySelectorAll('.memMode button').forEach(function(b){b.classList.toggle('on',b.dataset.memmode===mm)});
  $('ch-mem-tree').style.display=mm==='chart'?'':'none';$('res-mem-bars').style.display=mm==='bars'?'':'none';
  if(mm==='chart')chart('ch-mem-tree',{series:treeSeries('trees','ch-mem-tree'),stacked:true,fmt:gb,yMax:memCap()});else memBars('res-mem-bars');
  chart('ch-mem-sys',{series:[{name:'Used',color:'var(--accent)',get:function(p){return p.used}},{name:'Swap',color:'var(--bad)',get:function(p){return p.swap}},{name:'Compressed',color:'var(--warn)',get:function(p){return p.comp||0}}],fmt:gb,limit:s.totalMB,yMax:Math.max(s.totalMB,s.swapTotalMB)*1.12});
  $H('cpu-v').html=Math.round(s.cpuUser+s.cpuSys)+'% now';
