function syncSplitters(){document.querySelectorAll('.view .cols2,.view .g2').forEach(function(g){if(!shown(g))return;g.classList.add('rz');
  var f=+lsGet(splitKey(g))||0;g.style.setProperty('--split',f?(f*100).toFixed(2)+'%':'');
