    (m.context?'<div class="codewrap"><button class="codecopy" data-codecopy="1" data-tip="Copy to clipboard">'+(/\b(select|insert|update|delete|create|alter|drop)\b/i.test(m.context)?'Copy SQL':'Copy')+'</button><pre class="askctx">'+esc(m.context)+'</pre></div>':'')+'<div class="askqt">'+esc(m.title).replace(/\n/g,'<br>')+'</div><div class="askopts">'+m.options.filter(function(o){return !o.free}).map(function(o){return '<button class="askopt" data-menupick="'+x.tree+'|'+o.n+'"><b><span class="optn">'+o.n+'</span>'+esc(o.label)+'</b>'+(o.desc&&o.desc!==o.label?'<span>'+esc(o.desc)+'</span>':'')+'</button>'}).join('')+'</div>'+
