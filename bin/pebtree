  if(i<0)i=cards.findIndex(function(c){return c.dataset.tree===STEPCUR});
  var n;if(i<0){var fs=document.querySelector('#yourturn .feedscroll'),top=fs?fs.getBoundingClientRect().top:0;n=cards.find(function(c){return c.getBoundingClientRect().bottom>top+8})||cards[0]}
  else n=cards[(i+d+cards.length)%cards.length];
