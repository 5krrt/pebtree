}
// ---- the captain's decisions as cards: one button per option (the recommended one is primary), a box for
// anything else. A choice types its reply into the captain's tab, and the card waits until the captain marks it answered.
var DECPEND=(function(){try{return JSON.parse(sessionStorage.getItem('pebtree-decpend')||'{}')}catch(e){return {}}})();
function saveDecPend(){try{sessionStorage.setItem('pebtree-decpend',JSON.stringify(DECPEND))}catch(e){}}
function openDecisions(){var d=S.decisions||[];if(d.length)return d;return ((S.board&&S.board.decisions)||[]).map(function(t,i){return {id:'board-'+i,title:t,why:'',context:'',options:[],board:true}})}
function decCard(d){var p=DECPEND[d.id],wt=d.worker&&String(d.worker).match(/\d+/),wk=wt&&S.sessions.find(function(q){return q.tree===wt[0]});
  return '<div class="deccard'+(p?' pending':'')+'" data-dec="'+esc(d.id)+'"><div class="dechead">'+(wk?'<span class="decwk" data-convo="'+wk.tree+'" data-tip="Open '+treeName(wk.tree)+'">'+treeIcon(wk.tree,18)+esc(d.worker)+'</span>':d.worker?'<span class="decwk">'+esc(d.worker)+'</span>':'<span class="decwk cap">'+WHEEL+'captain</span>')+'<b>'+esc(d.title)+'</b></div>'+
    (d.why?'<div class="decwhy">'+esc(d.why)+'</div>':'')+
    (d.context?'<details class="decctx"><summary>Details</summary>'+codeBlock(d.context,'')+'</details>':'')+
    (p?'<div class="decsent">Sent <span class="mono">'+esc(p.reply)+'</span> · waiting for the captain to pick it up <button class="linkbtn" data-decundo="'+esc(d.id)+'">change</button></div>':
     (d.options.length?'<div class="decopts">'+d.options.map(function(o,i){return '<button class="'+(o.recommended?'primary':'')+'" data-decopt="'+esc(d.id)+'|'+i+'"'+(o.recommended?' data-tip="Recommended"':'')+'>'+esc(o.label)+'</button>'}).join('')+'</div>':'')+
     (d.board?'':'<div class="decfree"><input data-decfree="'+esc(d.id)+'" placeholder="Something else… Enter to send"><button data-decsend="'+esc(d.id)+'">Send</button></div>'))+'</div>'}
// inside the captain's own card and detail view, where its questions show
function decInline(x){if(!isCaptain(x))return '';var ds=openDecisions();return ds.length?'<div class="decinline"><div class="parkedh">Captain needs you · '+ds.length+'</div><div class="declist">'+ds.map(decCard).join('')+'</div></div>':''}
function renderDecisions(el,panel){if(!el)return;var ds=openDecisions();
  Object.keys(DECPEND).forEach(function(k){if(!ds.some(function(d){return d.id===k}))delete DECPEND[k]});saveDecPend();
  var h=ds.length?(panel?'<div class="panel decpanel"><div class="ptitle"><b style="color:var(--wait)">Needs you</b><span class="pill waiting">'+ds.length+'</span></div>':'<div class="decfeed"><div class="parkedh">Captain needs you · '+ds.length+'</div>')+'<div class="declist">'+ds.map(decCard).join('')+'</div></div>':'';
  // never redraw under the pointer or while you type in its box
  if(el._h!==h&&(DECFORCE||!el.matches(':hover')&&!el.contains(document.activeElement))){el._h=h;el.innerHTML=h}}
var DECFORCE=false;
function sendDecision(id,reply){var cap=capSession();if(!cap){toast('No captain is running to send this to');return}DECPEND[id]={reply:reply,at:Date.now()};saveDecPend();FORCE[cap.tree]=1;if($('convo').open&&CONVO===cap.tree)paintConvo(false);
  DECFORCE=true;render();
  act({op:'send',tree:cap.tree,text:reply}).then(function(r){if(!r.ok){delete DECPEND[id];saveDecPend();render();toast('Not sent to the captain: '+r.error)}})}
document.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('[data-decopt],[data-decsend],[data-decundo]');if(!b)return;
  if(b.dataset.decundo){delete DECPEND[b.dataset.decundo];saveDecPend();DECFORCE=true;render();return}
  if(b.dataset.decopt){var pr=b.dataset.decopt.split('|'),d=(S.decisions||[]).find(function(x){return x.id===pr[0]}),o=d&&d.options[+pr[1]];if(o)sendDecision(d.id,o.reply);return}
  var inp=b.parentNode.querySelector('input[data-decfree]');if(inp&&inp.value.trim()){var id=b.dataset.decsend,v=inp.value.trim();inp.value='';inp.blur();sendDecision(id,'decision '+id+': '+v)}});
document.addEventListener('keydown',function(e){var t=e.target;if(e.key==='Enter'&&t.dataset&&t.dataset.decfree&&t.value.trim()){e.preventDefault();var id=t.dataset.decfree,v=t.value.trim();t.value='';t.blur();sendDecision(id,'decision '+id+': '+v)}});

