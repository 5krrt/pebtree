// The / command bar: every action as a row, filtered by what you type (all words must match).
var CMDK={rows:[],sel:0};
function cmdkCommands(){var out=[];
  out.push({label:'New session',sub:'Claude in a fresh worktree, a checkout, Codex or a shell',kind:'start',pri:3,run:function(){newSessionDialog()}});
  (S.presets||[]).forEach(function(p){out.push({label:'Start '+(p.label||p.id),sub:presetTip(p),kind:'start',pri:3,run:function(){startPreset(p)}})});
  (S.trees||[]).filter(function(t){return t.stale}).forEach(function(t){out.push({label:(t.tmuxSession?'Attach ':'Resume ')+treeName(t.tree),sub:branchLabel(t.branch)||'',kind:'left off',tree:t.tree,pri:3,run:function(){resumeTree(t.tree)}})});
  (S.sessions||[]).slice().sort(function(a,b){return treeOrder2(a.tree)-treeOrder2(b.tree)}).forEach(function(x){var topic=(x.tabNamed?x.title:humanize(x.title))||humanize(branchLabel(x.branch))||'',n=treeName(x.tree);
    out.push({label:'Open '+n,sub:topic,kind:'detail view',tree:x.tree,pri:3,run:function(){openConvo(x.tree)}});
    if(x.tty)out.push({label:'Terminal for '+n,sub:topic,kind:'terminal',tree:x.tree,pri:2,run:function(){focusTerm(x.tree)}});
    out.push({label:(PINS[x.tree]?'Unpin ':'Pin ')+n,sub:topic,kind:'pin',tree:x.tree,pri:1,run:function(){togglePin(x.tree)}});
    ['fresh','parked','archive'].forEach(function(k){out.push({label:'Move '+n+' to '+SECNAME[k],sub:topic,kind:'move',tree:x.tree,pri:1,run:function(){moveTo(x.tree,k)}})});
    if(x.tree!=='main')out.push({label:'Close '+n,sub:topic,kind:'close tree',tree:x.tree,pri:1,run:function(){closeTreeDialog(x.tree)}})});
  Object.keys(TITLES).forEach(function(v){out.push({label:'Go to '+TITLES[v],sub:'',kind:'tab',pri:2,run:function(){location.hash=v}})});
  out.push({label:'New task',sub:'Spin off a task to a fresh tree',kind:'⌘N',pri:2,run:function(){newTaskDialog()}});
  out.push({label:'Keyboard shortcuts',sub:'',kind:'?',pri:1,run:function(){showKeys()}});
  out.push({label:'Lock pebtree',sub:S.lock&&S.lock.enabled?'Lock now; unlock with your passcode':'Set a passcode first (Settings → Lock)',kind:'⌥L',pri:2,run:function(){if(S.lock&&S.lock.enabled)act({op:'lock-now'});else location.hash='settings'}});
  return out}
function treeOrder2(t){var i=S&&S.sessions?S.sessions.findIndex(function(q){return q.tree===t}):-1;return i<0?999:i}
function cmdkFilter(){var q=$('cmdkIn').value.trim().toLowerCase(),all=cmdkCommands(),words=q.split(/\s+/).filter(Boolean),num=/^\d+$/.test(q)?q:'';
  var rows=all.filter(function(c){var hay=(c.label+' '+c.sub+' '+c.kind).toLowerCase();return num?c.tree===num:words.every(function(w){return hay.indexOf(w)>=0})});
  rows.sort(function(a,b){var as=a.label.toLowerCase().indexOf(q)===0?1:0,bs=b.label.toLowerCase().indexOf(q)===0?1:0;return bs-as||b.pri-a.pri});
  CMDK.rows=rows.slice(0,40);CMDK.sel=0;cmdkPaint()}
function cmdkPaint(){var l=$('cmdkList');l.innerHTML=CMDK.rows.length?CMDK.rows.map(function(c,i){return '<div class="cmdkrow'+(i===CMDK.sel?' on':'')+'" data-cmdk="'+i+'">'+(c.tree?treeIcon(c.tree,20):'')+'<b>'+esc(c.label)+'</b><span class="sub">'+esc(c.sub)+'</span><span class="kind">'+esc(c.kind)+'</span></div>'}).join(''):'<div class="cmdkempty">No matching command.</div>';var on=l.querySelector('.on');if(on)on.scrollIntoView({block:'nearest'})}
function openCmdk(){var d=$('cmdk');$('cmdkIn').value='';cmdkFilter();if(!d.open)d.showModal();$('cmdkIn').focus()}
function runCmdk(i){var c=CMDK.rows[i];if(!c)return;$('cmdk').close();if($('convo').open&&!/^Open /.test(c.label))$('convo').close();c.run()}
document.addEventListener('input',function(e){if(e.target.id==='cmdkIn')cmdkFilter()});
document.addEventListener('keydown',function(e){if(e.target.id!=='cmdkIn')return;if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault();var n=CMDK.rows.length;if(n){CMDK.sel=(CMDK.sel+(e.key==='ArrowDown'?1:n-1))%n;cmdkPaint()}}else if(e.key==='Enter'){e.preventDefault();runCmdk(CMDK.sel)}});
document.addEventListener('click',function(e){var r=e.target.closest&&e.target.closest('[data-cmdk]');if(r){runCmdk(+r.dataset.cmdk);return}if(e.target.id==='cmdk')$('cmdk').close()});
// Under each PR's title: when it last moved, and for open ones whatever stands in the way of merging.
function prMeta(p){var bits=[];if(p.updatedAt)bits.push('<span>updated '+ago(p.updatedAt)+'</span>');
  if(p.state==='open'||p.state==='draft'){if(p.merge==='dirty')bits.push('<span class="bad">conflicts</span>');else if(p.merge==='behind')bits.push('<span class="warn">behind master</span>');if(p.failing)bits.push('<span class="bad">'+p.failing+' check'+(p.failing>1?'s':'')+' failing</span>');if(p.updatedAt&&Date.now()-p.updatedAt>7*864e5)bits.push('<span class="warn">stale</span>')}
  // pebtree has not fetched this PR's details yet (a new PR, until the next GitHub check about a minute later)
  if(!bits.length)bits.push('<span class="prsync">syncing with GitHub…</span>');
  return '<span class="prmeta">'+bits.join(' · ')+'</span>'}
// Subagents a session started: running ones first (still writing within 15 min), then what finished today.
function subRunning(x){return (x.subagents||[]).filter(function(a){return !a.finished&&Date.now()-a.lastAt<9e5})}
function subSec(x){var all=x.subagents||[];if(!all.length)return '';var run=subRunning(x);
  return '<div class="sdsec"><div class="sdh">'+'Subagents · '+(run.length?run.length+' running':'none running')+(all.length>run.length?', '+(all.length-run.length)+' done today':'')+'</div><div class="sublist">'+all.map(function(a){var on=run.indexOf(a)>=0,stalled=!a.finished&&!on;
    return '<div class="subrow'+(on?' on':'')+(SUBVIEW&&SUBVIEW.id===a.id?' sel':'')+'" data-sub="'+esc(a.id)+'" data-tip="Open this subagent\'s conversation"><div class="subh">'+(on?'<span class="dots"><i></i><i></i><i></i></span>':'<span class="subdot'+(stalled?' warn':'')+'"></span>')+'<b title="'+esc(a.desc)+'">'+esc(a.desc)+'</b><span class="small muted">'+esc(a.type)+' · '+(on?'active ':stalled?'quiet ':'done ')+ago(a.lastAt)+'</span></div>'+(a.doing?'<div class="subdoing" title="'+esc(a.doing)+'">'+esc(a.doing)+'</div>':'')+'</div>'}).join('')+'</div></div>'}
