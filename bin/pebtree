function startCap(){var ta=$('capObj'),v=ta?ta.value.trim():'';if(!v){if(ta)ta.focus();return}var bt=$('capGo');bt.disabled=true;bt.textContent='Finding a free tree…';
  act({op:'captain-start',objectives:v}).then(function(r){bt.disabled=false;bt.textContent='Start captain';if(r.ok){ta.value='';toast('Captain starting in '+treeName(r.tree)+'. Its plan shows here when it is ready.');refresh()}else toast('Not started: '+r.error)})}
function renderCaptainBoard(){
