  document.addEventListener('pointerdown',function(e){var sp=e.target.closest('.splitter');if(!sp)return;e.preventDefault();var g=sp.parentNode,key=splitKey(g);sp.classList.add('drag');document.body.classList.add('splitting');sp.setPointerCapture(e.pointerId);
    function mv(ev){var r=g.getBoundingClientRect(),f=Math.min(.75,Math.max(.25,(ev.clientX-r.left)/r.width));lsSet(key,f.toFixed(4));g.style.setProperty('--split',(f*100).toFixed(2)+'%');syncSplitters();later()}
    function up(){sp.classList.remove('drag');document.body.classList.remove('splitting');sp.removeEventListener('pointermove',mv);sp.removeEventListener('pointerup',up);render()}
