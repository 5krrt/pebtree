var PIC={next:'<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>',metro:'<svg viewBox="0 0 24 24"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/></svg>',mcp:'<svg viewBox="0 0 24 24"><path d="M9 7V3M15 7V3M7 7h10v4a5 5 0 0 1-10 0zM12 16v5"/></svg>',other:'<svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9l3 3-3 3M13 15h4"/></svg>',slow:'<svg viewBox="0 0 24 24"><path d="M12 6v6l3 3"/><circle cx="12" cy="12" r="9"/></svg>'};
function procKind(x){return x.kind==='next'?'next':x.kind==='metro'||(x.ports||[]).some(function(p){return p>=8081&&p<=8099})?'metro':x.kind==='mcp'?'mcp':'other'}
function renderServers(){var list=S.servers||[];
  if(!list.length){$H('servers').html='<div class="empty">No dev processes running.</div>';return}
  var max=Math.max.apply(null,[1].concat(list.map(function(x){return x.memMB}))),by={};list.forEach(function(x){(by[x.tree]=by[x.tree]||[]).push(x)});
  var trees=Object.keys(by).map(function(t){return {t:t,items:by[t],mem:by[t].reduce(function(a,x){return a+x.memMB},0),cpu:by[t].reduce(function(a,x){return a+x.cpu},0)}}).sort(function(a,b){return b.mem-a.mem});
  var tot=list.reduce(function(a,x){return a+x.memMB},0),cpu=list.reduce(function(a,x){return a+x.cpu},0),orph=list.filter(function(x){return x.orphan}),ip=S.sys.lanIp||'localhost';
  var stat=function(n,l,cls){return '<div class="thstat'+(cls?' '+cls:'')+'"><b>'+n+'</b><span>'+l+'</span></div>'};
  var h='<div class="panel procsum"><div class="thstats">'+stat(list.length,'dev process'+(list.length>1?'es':''))+stat(gb(tot),'memory, of '+gb(S.sys.usedMB)+' used')+stat(Math.round(cpu)+'%','CPU (one core = 100%)')+stat(trees.length,'tree'+(trees.length>1?'s':''))+(orph.length?stat(orph.length,'orphaned','warn'):'')+'</div><button class="primary" data-cleanup="all" data-tip="Review idle and orphaned servers before stopping any">Clean up…</button></div><div class="procgrid">'+
    trees.map(function(g){var se=S.sessions.find(function(q){return q.tree===g.t}),st=se&&se.claudeState!=='none'?sessState(se):null,topic=se?((se.tabNamed?se.title:humanize(se.title))||humanize(branchLabel(se.branch))):'';
      return '<div class="panel procgroup"><div class="pghead">'+treeIcon(g.t,30)+'<div class="pgt"><b>'+treeName(g.t)+'</b>'+(st?'<span class="pill '+st.cls+'">'+st.label+'</span>':'<span class="pill">no Claude session</span>')+'<div class="small muted pgtopic">'+esc(topic||'')+'</div></div><div class="pgmem"><b>'+gb(g.mem)+'</b><span class="small muted">'+Math.round(g.cpu)+'% CPU</span></div>'+(g.items.some(function(x){return x.killable})&&g.t!=='main'?'<button class="hact danger" data-stoptree="'+g.t+'" data-tip="Stop every dev process in '+treeName(g.t)+' (Claude keeps running)">'+ICO.stop+'</button>':'')+'</div>'+
        g.items.sort(function(a,b){return b.memMB-a.memMB}).map(function(x){var k=procKind(x),port=(x.ports||[])[0];
          var ports=(x.ports||[]).map(function(p){return k==='next'?'<a class="portlink" href="http://localhost:'+p+'" target="_blank" data-tip="Open in a new tab">:'+p+'</a>':k==='metro'?'<button class="portlink" data-copy="http://'+ip+':'+p+'" data-tip="Copy the Metro URL for a phone">:'+p+'</button>':'<span class="portlink">:'+p+'</span>'}).join('');
          return '<div class="procrow"><span class="pk '+k+'" data-tip="'+(k==='next'?'Web (Next.js)':k==='metro'?'Metro / Expo':k==='mcp'?'MCP server':'Other process')+'">'+PIC[k]+'</span><div class="prl"><b>'+esc(x.label.replace(/\s*:\d+$/,''))+'</b>'+(x.orphan?'<span class="pill bad" data-tip="Nothing is using it: its terminal is gone">orphaned</span>':'')+(x.throttled?'<span class="pill warn">throttled</span>':'')+'<div class="small muted">'+x.pids+' process'+(x.pids>1?'es':'')+' · up '+dur(x.age)+'</div></div><div class="prports">'+ports+'</div><div class="prmem"><span class="mono">'+gb(x.memMB)+'</span><span class="membar"><span style="width:'+(x.memMB/max*100)+'%;background:'+colorFor(x.tree)+'"></span></span></div><span class="mono small prcpu" data-tip="CPU now">'+x.cpu.toFixed(0)+'%</span>'+
            (x.killable?'<span class="practs"><button class="hact'+(x.throttled?' on':'')+'" data-throttle="'+x.id+'" data-on="'+(!x.throttled)+'" data-tip="'+(x.throttled?'Unthrottle: back to normal priority':'Throttle: lower its CPU and disk priority')+'">'+PIC.slow+'</button><button class="hact danger'+(STOPPING[x.id]?' stopping':'')+'" data-stop="'+x.id+'"'+(STOPPING[x.id]?' disabled':'')+' data-tip="Stop it">'+ICO.stop+'</button></span>':'<span class="practs"></span>')+'</div>'}).join('')+'</div>'}).join('')+'</div>';
  $H('servers').html=h}
