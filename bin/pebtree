// Image files named in a message show inline, from folders sessions save screenshots in.
function imgPaths(t){var out=[],seen={};String(t||'').replace(/(~?\/[^\s\x60'"()<>\]\[]+\.(?:png|jpe?g|gif|webp))\b/gi,function(m,p){if(!seen[p]){seen[p]=1;out.push(p)}return m});return out.slice(0,8)}
function imgStrip(t){var ps=imgPaths(t);return ps.length?'<div class="imgstrip">'+ps.map(function(p){var u='/api/img?t='+encodeURIComponent(TOKEN)+'&path='+encodeURIComponent(p);return '<a href="'+u+'" target="_blank" data-tip="'+esc(p)+'"><img loading="lazy" src="'+u+'" alt="" onerror="this.parentNode.remove()"></a>'}).join('')+'</div>':''}
