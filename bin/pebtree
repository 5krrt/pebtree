var POOL_TIP={free:'Free: no one is using this tree; the next new task can take it','in-use':'In use: a session or a lease holds this tree',orphan:'Orphan: leased, but nothing is running in it any more; Close tree frees it',dirty:'Dirty: the tree has files treehouse could not reset',empty:'Empty: no worktree here yet'};
function icoNum(ic,n,tip,cls){return '<span class="icn'+(n?'':' zero')+(cls?' '+cls:'')+'" data-tip="'+esc(tip)+'">'+ic+'<b>'+n+'</b></span>'}
