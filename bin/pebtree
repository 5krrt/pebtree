var RQ=0,CQ={};function soonRender(){if(RQ)return;RQ=setTimeout(function(){RQ=0;dataRender()},150)}function soonChat(t){if(CQ[t])return;CQ[t]=setTimeout(function(){CQ[t]=0;reloadChat(t)},250)}
(function(){var es,t=0;function open(){try{es=new EventSource('/api/events')}catch(e){return}
  es.onmessage=function(m){var ev;try{ev=JSON.parse(m.data)}catch(e){return}
    if(ev.type==='lock'){showLock();return}if(ev.type==='unlock'){if(LOCKED)hideLock();return}
    if(ev.type==='state'){clearTimeout(t);t=setTimeout(refresh,30)}
