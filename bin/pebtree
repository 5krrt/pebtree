  if(!sp){sp=document.createElement('div');sp.className='splitter';sp.title='Drag to resize · double-click to reset';g.appendChild(sp)}
  var first=[].slice.call(g.children).find(function(c){return !c.classList.contains('splitter')});
  if(innerWidth<=1100||!first){sp.style.display='none';return}var was=sp.style.display;sp.style.display='';g._sp=sp;
  // the handle moves only when a column changes size, so a ResizeObserver places it after layout instead of every render measuring
  if(!SPLIT_RO){placeSplit(g);return}if(!g._ro){g._ro=1;SPLIT_RO.observe(g)}if(g._first!==first){if(g._first)SPLIT_RO.unobserve(g._first);first._splitG=g;g._first=first;SPLIT_RO.observe(first)}else if(was==='none')placeSplit(g)})}
var SPLIT_RO=window.ResizeObserver?new ResizeObserver(function(es){es.forEach(function(e){placeSplit(e.target._splitG||e.target)})}):null;
