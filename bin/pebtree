function paintAttach(tree){setTimeout(syncGhosts,0);var a=ATTACH[tree]||[];document.querySelectorAll('[data-attach="'+tree+'"]').forEach(function(row){row.innerHTML=a.map(function(x,i){return '<span class="attach'+(x.path?'':' up')+'"><img src="'+(x.url||'')+'" alt=""><button data-unattach="'+tree+'|'+i+'" data-tip="Remove">×</button></span>'}).join('');row.classList.toggle('on',a.length>0)})}
function attachFiles(tree,files){[].slice.call(files||[]).filter(function(f){return /^image\/(png|jpeg|gif|webp)$/.test(f.type)}).forEach(function(f){var item={url:URL.createObjectURL(f),path:''};(ATTACH[tree]=ATTACH[tree]||[]).push(item);paintAttach(tree);
  fetch('/api/upload',{method:'POST',headers:{'Content-Type':f.type,'x-pebtree-token':TOKEN,'x-pebtree-tree':tree},body:f}).then(function(r){return r.json()}).then(function(r){if(r.ok){item.path=r.path;paintAttach(tree)}else{ATTACH[tree]=(ATTACH[tree]||[]).filter(function(x){return x!==item});paintAttach(tree);toast('Image not added: '+(r.error||'upload failed'))}}).catch(function(){ATTACH[tree]=(ATTACH[tree]||[]).filter(function(x){return x!==item});paintAttach(tree);toast('Image not added: dashboard unreachable')})})}
document.addEventListener('paste',function(e){var ta=e.target;if(!(ta.dataset&&ta.dataset.reply))return;var fs=[].slice.call((e.clipboardData&&e.clipboardData.files)||[]).filter(function(f){return /^image\//.test(f.type)});if(!fs.length)return;e.preventDefault();attachFiles(ta.dataset.reply,fs)});
// Drop an image anywhere in the detail view, on a feed card, or on the captain panel: it attaches to that reply box.
function dropZone(t){if(!t||!t.closest)return null;return t.closest('#convo .cvchat')||t.closest('.cappanel.running')||t.closest('#yourturn .post')||t.closest('.yt-reply')}
function hasFiles(e){return !!(e.dataTransfer&&[].slice.call(e.dataTransfer.types||[]).indexOf('Files')>=0)}
var DROPZ=null;function setDrop(z){if(DROPZ&&DROPZ!==z)DROPZ.classList.remove('dropping');DROPZ=z;if(z)z.classList.add('dropping')}
document.addEventListener('dragover',function(e){if(!hasFiles(e))return;var z=dropZone(e.target);if(z){e.preventDefault();e.dataTransfer.dropEffect='copy'}setDrop(z)});
document.addEventListener('dragleave',function(e){if(DROPZ&&!DROPZ.contains(e.relatedTarget))setDrop(null)});
document.addEventListener('drop',function(e){var z=dropZone(e.target);setDrop(null);if(!z||!e.dataTransfer||!e.dataTransfer.files.length)return;e.preventDefault();var ta=z.querySelector('textarea[data-reply]');if(!ta)return;
  // images attach as images; folders and other files are copied into the session's tree and their paths go in
  var items=[].slice.call(e.dataTransfer.items||[]),files=[].slice.call(e.dataTransfer.files),imgs=[],names=[];
  files.forEach(function(f,i){var it=items[i],en=it&&it.webkitGetAsEntry&&it.webkitGetAsEntry(),dir=en&&en.isDirectory;if(!dir&&/^image\/(png|jpeg|gif|webp)$/.test(f.type))imgs.push(f);else names.push(f.name)});
  if(imgs.length)attachFiles(ta.dataset.reply,imgs);
  if(names.length)uploadDrop(ta,items.filter(function(it,i){return names.indexOf(files[i]&&files[i].name)>=0}));
  ta.focus()});
// Reads every file in the dropped items (folders included) in the browser and uploads them into the session's tree,
// so it works wherever the item came from. Paths of the top-level items go into the reply.
function readEntry(en,prefix,out){return new Promise(function(res){if(en.isFile){en.file(function(f){out.push({rel:prefix+f.name,file:f});res()},function(){res()})}else if(en.isDirectory){var rd=en.createReader(),all=[];(function more(){rd.readEntries(function(batch){if(!batch.length){Promise.all(all.map(function(c){return readEntry(c,prefix+en.name+'/',out)})).then(res)}else{all=all.concat(batch);more()}},function(){res()})})()}else res()})}
function uploadDrop(ta,items){var tree=ta.dataset.reply,entries=items.map(function(it){return it.webkitGetAsEntry&&it.webkitGetAsEntry()}).filter(Boolean),out=[];
  var batch=new Date().toISOString().slice(0,19).replace(/[:T]/g,'-')+'-'+Math.random().toString(36).slice(2,6);
  toast('Reading what you dropped…');
  Promise.all(entries.map(function(en){return readEntry(en,'',out)})).then(function(){
    out=out.filter(function(o){return !/(^|\/)(node_modules|\.git|\.DS_Store)(\/|$)/.test(o.rel)});
    var total=out.reduce(function(a,o){return a+o.file.size},0);
    if(!out.length){toast('Not added: nothing readable in that drop');return}
    if(total>1024*1024*1024||out.length>5000){toast('Not added: '+out.length+' files, '+(total/1048576).toFixed(0)+' MB; drops are limited to 1 GB and 5,000 files');return}
    var done=0,failed=0,dir='';toast('Copying '+out.length+' file'+(out.length>1?'s':'')+' into '+treeName(tree)+'…');
    var queue=out.slice(),run=function(){var o=queue.shift();if(!o)return Promise.resolve();return fetch('/api/drop-file?tree='+encodeURIComponent(tree)+'&batch='+batch+'&rel='+encodeURIComponent(o.rel),{method:'POST',headers:{'x-pebtree-token':TOKEN},body:o.file}).then(function(r){return r.json()}).then(function(r){if(r.ok){done++;dir=r.dir}else failed++}).catch(function(){failed++}).then(run)};
    Promise.all([run(),run(),run(),run()]).then(function(){if(!done){toast('Not added: the copy failed');return}
      var tops=entries.map(function(en){var p=dir+'/'+en.name;return /[\s'"()&;]/.test(p)?"'"+p.replace(/'/g,"'\\''")+"'":p});
      insertAtCursor(ta,tops.join(' ')+' ');toast('Copied '+done+' file'+(done>1?'s':'')+' into '+treeName(tree)+'/.pebtree-drops'+(failed?' · '+failed+' failed':''))})})}
function insertAtCursor(ta,txt){setTimeout(syncGhosts,0);var a=ta.selectionStart==null?ta.value.length:ta.selectionStart,b=ta.selectionEnd==null?a:ta.selectionEnd,pre=ta.value.slice(0,a);if(pre&&!/\s$/.test(pre))txt=' '+txt;ta.value=pre+txt+ta.value.slice(b);var c=(pre+txt).length;ta.focus();ta.setSelectionRange(c,c);growBox(ta);if(ta.dataset.reply)setDraft(ta.dataset.reply,ta.value,ta)}
// a file dropped outside a drop zone must not navigate the tab away to the image
