var PROOF=null,JOURNAL=null,proofTree=lsGet('devdeck-proof-tree')||'all';
function loadProof(){return fetch('/api/proof').then(function(r){return r.json()}).then(function(d){PROOF=d.entries;countProof();if(view==='proof')renderProof()})}
function loadJournal(){return fetch('/api/journal').then(function(r){return r.json()}).then(function(d){JOURNAL=d;if(view==='journal')renderJournal()})}
function countProof(){var seen=+(lsGet('devdeck-proof-seen')||0),n=(PROOF||[]).filter(function(e){return e.at>seen}).length;$H('c-proof').html=view==='proof'?'':(n||'')}
function fileUrl(e,f){return '/proof/'+encodeURIComponent(e.tree)+'/'+encodeURIComponent(e.id)+'/'+encodeURIComponent(f)}
function renderProof(){
  if(!PROOF){$H('proof').html='<div class="panel empty">Loading...</div>';return}
  if(PROOF.length)lsSet('devdeck-proof-seen',String(PROOF[0].at));countProof();
  var trees=[];PROOF.forEach(function(e){if(trees.indexOf(e.tree)<0)trees.push(e.tree)});trees.sort(function(a,b){return (+a||0)-(+b||0)});
  var list=PROOF.filter(function(e){return proofTree==='all'||e.tree===proofTree});
  $H('proofbar').html='<b>Proof from your trees</b><span class="muted small">screenshots, recordings and test runs, newest first</span><span class="grow"></span><label class="small">Tree <select id="proofTree"><option value="all">All trees</option>'+trees.map(function(t){return '<option value="'+esc(t)+'"'+(t===proofTree?' selected':'')+'>'+esc(treeName(t))+'</option>'}).join('')+'</select></label>';
  $H('proof').html=list.length?list.map(function(e){
    var media=e.files.filter(function(f){return /^(image|video)\//.test(f.type)}),texts=e.files.filter(function(f){return !/^(image|video)\//.test(f.type)});
    return '<div class="panel proof-card"><div class="row">'+treeIcon(e.tree,20)+'<b>'+esc(treeName(e.tree))+'</b><b>'+esc(e.title)+'</b>'+(e.run?'<span class="pill '+(e.run.exit?'bad':'ok')+'">'+(e.run.exit?'failed (exit '+e.run.exit+')':'passed')+'</span>':'')+'<span class="grow"></span><span class="mono small muted">'+esc(e.branch||'')+'</span><span class="small muted" title="'+new Date(e.at).toLocaleString()+'">'+ago(e.at)+'</span></div>'+
      (e.note?'<div class="small" style="white-space:pre-wrap">'+esc(e.note)+'</div>':'')+
      (media.length?'<div class="shots">'+media.map(function(f){var u=fileUrl(e,f.name);return '<a href="'+u+'" target="_blank">'+(/^video/.test(f.type)?'<video src="'+u+'" controls preload="metadata"></video>':'<img src="'+u+'" loading="lazy" alt="'+esc(f.name)+'">')+'<div class="cap">'+esc(f.name)+'</div></a>'}).join('')+'</div>':'')+
      (e.run?'<details><summary class="small mono">$ '+esc(e.run.cmd)+' <span class="muted">('+(e.run.ms/1000).toFixed(1)+'s)</span></summary><pre class="out">'+esc(e.run.output.slice(-20000))+'</pre></details>':'')+
      (texts.length?'<div class="small">'+texts.map(function(f){return '<a href="'+fileUrl(e,f.name)+'" target="_blank" class="mono">'+esc(f.name)+'</a>'}).join(' · ')+'</div>':'')+'</div>'}).join(''):
    '<div class="panel"><b>No proof yet.</b><p class="small muted">From any tree, a session (or you) runs:</p><pre class="out">pebtree proof shot-390.png shot-1440.png --title "Pack page fits at phone width" --note "before/after"\npebtree proof --title "Rarity tier tests" --run "pnpm test:rarity-tier"</pre><p class="small muted">Files are copied to ~/.config/pebtree/proof/&lt;tree&gt;/ and show up here with the tree and branch they came from.</p></div>';
}
function renderJournal(){
  if(!JOURNAL){$H('journal').html='<div class="panel empty">Loading...</div>';return}
  var j=JOURNAL;
  var md=j.missing||[];
  $H('journalbar').html='<b>Daily dev journal</b><span class="muted small">'+(j.enabled?'one entry per day, written at '+j.hour+':00 from your commits and PRs':'automatic entries are off')+'</span><span class="grow"></span>'+
    (j.running?'<span class="pill working">writing '+esc(j.running.date||'')+'…</span><button class="danger" id="journalCancel">Cancel</button>':(md.length?'<button id="journalFill" data-tip="'+esc(md.join(', '))+'">Fill '+md.length+' missing day'+(md.length>1?'s':'')+'</button>':'')+'<button class="primary" id="journalNow">Write today so far</button>')+'<label class="small"><input type="checkbox" id="journalAuto"'+(j.enabled?' checked':'')+'> every day at '+j.hour+':00</label>';
  $H('journal').html=j.entries.length?j.entries.map(function(e,i){return '<div class="panel journal-entry"><div class="ptitle"><b>'+esc(new Date(e.date+'T12:00:00').toLocaleDateString([],{weekday:'long',month:'long',day:'numeric'}))+'</b>'+(e.partial?'<span class="pill waiting">so far</span>':'')+'<span class="v"><span class="small muted">'+(e.trigger==='manual'?'written by hand':'written at 7am')+' · '+ago(e.at)+'</span> <button data-copyj="'+i+'">Copy</button> <button data-rewritej="'+esc(e.date)+'"'+(j.running?' disabled':'')+'>Rewrite</button> <button class="danger" data-deletej="'+esc(e.date)+'">Delete</button></span></div>'+(e.text?'<pre>'+esc(e.text.replace(/^\s*\d{1,2}\/\d{1,2}\s*\n/,''))+'</pre>':'<div class="small" style="color:var(--bad)">'+esc(e.error)+'</div>')+'</div>'}).join(''):'<div class="panel empty">No entries yet. They are written each day at '+j.hour+':00, or press "Write today so far".</div>';
}
var TITLES={terms:'Terminals',tickets:'Tickets',prs:'PRs',overview:'Overview',resources:'Resources',trees:'Trees',processes:'Processes',captain:'Captain',cleanup:'Cleanup',settings:'Settings',proof:'Proof',journal:'Journal'};
function placeAlert(){var a=$('alert'),home=$('alerthome'),dash=document.querySelector('#v-overview .dashcol');if(!a||!dash)return;if(view==='overview'){if(a.parentNode!==dash)dash.insertBefore(a,dash.firstChild)}else if(home&&a.parentNode!==home.parentNode)home.parentNode.insertBefore(a,home)}
function setView(v){if(v==='sessions')v='trees';if(!TITLES[v])v='overview';view=v;setTimeout(placeAlert,0);document.body.classList.toggle('still',v==='overview'||v==='captain'||v==='terms');if(v==='terms')setTimeout(function(){var t=curTerm();if(t){fitTerm(t);t.term.focus()}},0);window.scrollTo(0,0);setTimeout(sizeFeed,0);document.querySelectorAll('nav a').forEach(function(a){a.classList.toggle('on',a.dataset.v===v)});document.querySelectorAll('.view').forEach(function(s){s.classList.toggle('on',s.id==='v-'+v)});$('vtitle').textContent=TITLES[v];if(S&&!S.loading)render()}
function render(){render0();syncGhosts();renderTermsBadge();if(view==='terms')renderTerms()}
function render0(){
  var servers=S.servers.filter(function(x){return x.kind==='next'||x.kind==='metro'});
  $('sub').textContent='· '+new Date(S.at).toLocaleTimeString([],{hour:'numeric',minute:'2-digit',second:'2-digit'});$('sub').dataset.tip='Last updated';
  $H('c-trees').html=S.pool.inUse+'<span class="lbl">/'+(S.pool.max||S.trees.length)+'</span>';
  var cp=$('c-procs');cp.textContent=servers.length;cp.classList.toggle('hot',!!(S.settings.serverBudget&&servers.length>S.settings.serverBudget));
  var turn=turnList().filter(function(x){return Date.now()-x.lastActive<7200000}).length;$H('c-turn').html=turn||'';document.title=(turn?'('+turn+') ':'')+'pebtree';setFavicon(turn>0);
  $H('c-captain').html=openDecisions().length||'';$H('c-tickets').html=(S.tickets&&S.tickets.newCount)||'';$('locknav').hidden=!(S.lock&&S.lock.enabled);
  renderAlert();
  if(view==='overview')renderOverview();else if(view==='resources')renderResources();else if(view==='sessions')renderSessions();else if(view==='trees')renderTrees();else if(view==='processes')renderServers();else if(view==='captain')renderCaptain();else if(view==='cleanup'){renderControls();renderActions()}else if(view==='settings')renderSettings();else if(view==='proof')renderProof();else if(view==='journal')renderJournal();else if(view==='prs')renderPRs();else if(view==='tickets')renderTickets();
  syncSegs()
}
// ---- lock screen: shown whenever the server says it is locked; nothing else renders until it unlocks
var LOCKED=false;
function showLock(){if(LOCKED)return;LOCKED=true;['convo','dlg','cmdk'].forEach(function(id){var d=$(id);if(d&&d.open)d.close()});document.body.classList.add('islocked');$('lockscreen').hidden=false;$('lockmsg').textContent='';setTimeout(function(){$('lockpass').focus()},50)}
function hideLock(){LOCKED=false;document.body.classList.remove('islocked');$('lockscreen').hidden=true;$('lockpass').value='';refresh(true)}
function tryUnlock(){var v=$('lockpass').value;if(!v)return;fetch('/api/unlock',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:TOKEN,passcode:v})}).then(function(r){return r.json()}).then(function(r){if(r.ok)hideLock();else{$('lockmsg').textContent=r.error;$('lockpass').select()}}).catch(function(){$('lockmsg').textContent='pebtree is not answering'})}
document.addEventListener('click',function(e){if(e.target.id==='lockgo')tryUnlock()});
document.addEventListener('keydown',function(e){if(e.target.id==='lockpass'&&e.key==='Enter'){e.preventDefault();tryUnlock()}},true);
// tell pebtree you are here (at most every 30s) so it does not auto-lock while you use it
