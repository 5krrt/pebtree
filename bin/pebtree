function refresh(force){var wc=needCoarse()&&(force||Date.now()-coarseAt>60000);return fetch('/api/state'+(wc?'?coarse=1':'')).then(function(r){return r.json()}).then(function(d){if(d&&d.locked){showLock();return}if(LOCKED)hideLock();if(d.coarse){COARSE=d.coarse;coarseAt=Date.now()}S=d;maybeReload(d.build);$('live').style.background='var(--ok)';$('liveText').textContent='live';if(!S.loading)dataRender()}).then(function(){FAILS=0},function(){FAILS++;var down=FAILS>=12;$('live').style.background=down?'var(--bad)':'var(--warn)';$('liveText').textContent=down?'pebtree is not running':'reconnecting…';if(!down)setTimeout(refresh,1000)})}
