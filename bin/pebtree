function findSvc(id){return S.servers.find(function(s){return s.id===id})}
var STOPPING={},STOPJOB=null;
function stopMany(ids,reason){ids=ids.filter(function(id){return !STOPPING[id]});if(!ids.length)return;
  var job=STOPJOB&&!STOPJOB.finished?STOPJOB:(STOPJOB={items:[],freed:0,finished:false});
  ids.forEach(function(id){var x=findSvc(id)||{};STOPPING[id]=1;job.items.push({id:id,label:(x.tree?treeName(x.tree)+' · ':'')+(x.label||('process '+id)),state:'run'})});
  drawStopper();render();
  ids.forEach(function(id){act({op:'stop',id:id,reason:reason}).then(function(r){var it=job.items.find(function(i){return i.id===id});it.state=r.ok?'ok':'bad';it.err=r.error;if(r.ok)job.freed+=r.freedMB||0;delete STOPPING[id];drawStopper();refresh()})})}
function drawStopper(){var job=STOPJOB,el=$('stopper');if(!job)return;var n=job.items.length,d=job.items.filter(function(i){return i.state!=='run'}).length,bad=job.items.filter(function(i){return i.state==='bad'}).length;
  job.finished=d===n;el.classList.toggle('done',job.finished);el.classList.add('on');
  el.innerHTML='<div class="h">'+(job.finished?'Stopped '+(n-bad)+' of '+n:'Stopping '+n+' dev server'+(n>1?'s':''))+'<span>'+d+' / '+n+(job.freed?' · freed '+gb(job.freed):'')+'</span></div><div class="track"><div class="fill" style="width:'+Math.max(6,d/n*100)+'%"></div></div><div class="items">'+job.items.map(function(i){return '<div class="'+(i.state==='run'?'':i.state)+'">'+(i.state==='run'?'…':i.state==='ok'?'✓':'✕')+' '+esc(i.label)+(i.err?' ('+esc(i.err)+')':'')+'</div>'}).join('')+'</div>';
  clearTimeout(el._h);if(job.finished)el._h=setTimeout(function(){el.classList.remove('on');STOPJOB=null},bad?9000:4000)}
function stop(id){stopMany([id])}
function stopTree(t){var se=S.sessions.find(function(x){return x.tree===t});var ids=se?se.services.filter(function(v){return v.killable&&v.kind!=='claude'}).map(function(v){return v.id}):[];if(!ids.length){toast('Nothing to stop in '+treeName(t));return}if(!confirm('Stop '+ids.length+' dev process'+(ids.length>1?'es':'')+' in '+treeName(t)+'? The Claude session keeps running.'))return;stopMany(ids,'stop tree '+t)}
function cleanup(mode,minutes){
  minutes=minutes||+(($('idleMin')||{}).value||30);
  Promise.all([act({op:'cleanup-preview',mode:'orphans',minutes:minutes}),act({op:'cleanup-preview',mode:'idle',minutes:minutes})]).then(function(rs){
    var O=rs[0].candidates||[],oid={};O.forEach(function(x){oid[x.id]=1});var I=(rs[1].candidates||[]).filter(function(x){return !oid[x.id]});
    function rows(list,reason){return list.length?'<table class="cl"><tbody>'+list.map(function(x){return '<tr><td><label><input type="checkbox" checked value="'+x.id+'" data-mb="'+x.memMB+'" data-reason="'+reason+'"> '+treeIcon(x.tree,18)+'<b>'+treeName(x.tree)+'</b> '+esc(x.label)+'</label></td><td class="num mono">'+gb(x.memMB)+'</td></tr>'}).join('')+'</tbody></table>':'<p class="small muted cl-none">None right now.</p>'}
    function sum(l){return gb(l.reduce(function(a,x){return a+x.memMB},0))}
    $('dlgBody').innerHTML='<h3 style="margin:0 0 4px">Clean up dev servers</h3><p class="small muted" style="margin:0 0 14px">Claude sessions are never stopped. Your code and branches are untouched; restart a server whenever you need it.</p>'+
      '<div class="clsec"><div class="clh"><span class="pill bad">Orphaned</span><b>Nothing is using these</b><span class="mono small muted">'+O.length+' · '+sum(O)+'</span></div><p class="small muted">The tree has no Claude session and whatever started the server has exited.</p>'+rows(O,'cleanup: orphan')+'</div>'+
      '<div class="clsec"><div class="clh"><span class="pill waiting">Idle</span><b>Tree quiet for <input type="number" id="dlgMin" min="5" value="'+minutes+'"> min</b><span class="mono small muted">'+I.length+' · '+sum(I)+'</span></div><p class="small muted">The tree\'s Claude session has not done anything in that time.</p>'+rows(I,'cleanup: idle '+minutes+' min')+'</div>'+
      '<div class="row" style="justify-content:flex-end;margin-top:14px"><button id="dlgCancel">Cancel</button><button class="primary" id="dlgGo"></button></div>';
    if(!$('dlg').open)$('dlg').showModal();
    function upd(){var c=[].slice.call($('dlgBody').querySelectorAll('input[type=checkbox]:checked')),mb=c.reduce(function(a,i){return a+(+i.dataset.mb)},0);$('dlgGo').textContent=c.length?'Stop '+c.length+' · frees '+gb(mb):'Nothing selected';$('dlgGo').disabled=!c.length}
    upd();$('dlgBody').onchange=function(e){if(e.target.id==='dlgMin'){var m=Math.max(5,+e.target.value||30);cleanup(mode,m)}else upd()};
    $('dlgCancel').onclick=function(){$('dlg').close()};
    $('dlgGo').onclick=function(){var c=[].slice.call($('dlgBody').querySelectorAll('input[type=checkbox]:checked'));$('dlg').close();
      var by={};c.forEach(function(i){(by[i.dataset.reason]=by[i.dataset.reason]||[]).push(+i.value)});Object.keys(by).forEach(function(r){stopMany(by[r],r)})};
  });
}
