}
// Posts are keyed by tree and patched one at a time, so the 4s refresh never touches a reply being typed.
function renderYourTurn(){
  var box=$('yourturn');
  if(!box._built){box.innerHTML='<div class="panel feed"><div class="ptitle"><b>Feed</b><span class="pill waiting" id="yt-count"></span><span class="v muted small" id="yt-sub"></span><button class="newtask" data-newtask="1" data-tip="Spin off a task to a fresh tree · ⌘N"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New task</button></div><div class="feedmap" id="yt-map"></div><div class="feedscroll"><div class="parked pinned" id="yt-pinned"><div class="parkedh"><span class="secl"></span><button class="foldall" data-foldall="pinned"></button></div><div class="yt" id="yt-pinned-list"></div></div><div class="parkedh ythead" id="yt-head"><span class="secl"></span><button class="foldall" data-foldall="fresh"></button></div><div class="yt" id="yt-list"></div><div id="yt-empty" class="empty"></div><div class="parked" id="yt-working"><div class="parkedh"><span class="secl"></span><button class="foldall" data-foldall="working"></button></div><div class="yt" id="yt-working-list"></div></div><div class="parked" id="yt-parked"><div class="parkedh"><span class="secl"></span><button class="foldall" data-foldall="parked"></button></div><div class="yt" id="yt-parked-list"></div></div><div class="parked archive" id="yt-archive"><div class="parkedh archh" data-archtoggle="1" data-tip="Show or hide archived sessions"><span class="secl"></span><button class="foldall" data-foldall="archive"></button></div><div class="yt" id="yt-archive-list"></div></div></div></div>';box._built=1}
  // One place decides each card's section; a change only lands after it has held for 1.5s, so a flickering
  // tab-title state cannot bounce a card between sections. Your own actions (send, typing) move it at once.
  var inCard=function(t){var a=document.activeElement,p=a&&a.closest&&a.closest('.post');return !!(p&&p.dataset.tree===t)};
  var mine=function(x){return !!(SENT[x.tree]||(x.pending&&x.pending.length))};
  function want(x){
    var waiting=x.claudeState==='waiting'||!!x.menu,hasText=!!(x.lastSay&&x.lastSay.trim())||!!x.menu;
    if(mine(x))return {sec:'working',now:!!SENT[x.tree]};
    if(x.claudeState==='working')return {sec:'working'};
    if(waiting&&hasText){var pl=placed(x);
      // a question or permission prompt always comes to Your turn; otherwise your placement wins, and a
      // session nobody has touched for a week files itself under Archive
      if(x.menu)return {sec:'fresh',now:inCard(x.tree)};
      if(pl&&pl.sec!=='fresh')return {sec:pl.sec,now:true};
      if(inCard(x.tree))return {sec:'fresh',now:true};
      return {sec:Date.now()-touchedAt(x)>WEEK?'archive':'fresh',now:!!pl}}
    return {sec:null};
  }
  var groups={pinned:[],fresh:[],working:[],parked:[],archive:[]},skipped=0,unsettled=false,nowT=Date.now();
  // While you type in a card, the feed holds still: cards keep their section and order, nothing leaves,
  // new cards join at the bottom, and the scroll is corrected so your card stays where it is.
  var ae=document.activeElement,hold=!!(ae&&ae.matches&&ae.matches('#yourturn textarea[data-reply]')),domIx={},holdCard=hold&&ae.closest('.post'),holdTop=hold?ae.getBoundingClientRect().top:0;
  if(hold)document.querySelectorAll('#yourturn .post').forEach(function(p,i){domIx[p.dataset.tree]={sec:secOf(p),i:i}});
  Object.keys(CLOSING).forEach(function(t){if(Date.now()-CLOSING[t]>120000||!S.sessions.some(function(q){return q.tree===t}))delete CLOSING[t]});
  S.sessions.forEach(function(x){if(CLOSING[x.tree]||isCrew(x))return;var w=want(x),st=SECT[x.tree];
    if(hold&&domIx[x.tree]){groups[domIx[x.tree].sec].push(x);return}
    if(PINS[x.tree]){groups.pinned.push(x);return}
    var fresh0=w.sec==='fresh'&&st&&st.say!==undefined&&st.say!==sayKey(x);
    if(!st||w.now||!st.cur||fresh0){st=SECT[x.tree]={cur:w.sec,want:w.sec,since:nowT}}
    else if(w.sec!==st.cur){if(w.sec!==st.want){st.want=w.sec;st.since=nowT}if(nowT-st.since>=1500)st.cur=w.sec;else unsettled=true}
    else{st.want=st.cur}
    st.say=sayKey(x);
    if(st.cur==='skip')skipped++;else if(st.cur&&groups[st.cur])groups[st.cur].push(x)});
  if(unsettled){clearTimeout(SECT._t);SECT._t=setTimeout(soonRender,1600)}
  var fresh=groups.fresh.sort(function(a,b){var la=laterAt(a),lb=laterAt(b);return (la?1:0)-(lb?1:0)||la-lb||sortKey(b)-sortKey(a)}) /* newest first; Later cards at the bottom; while you type, new cards land below your card (syncPosts) */,working=groups.working.sort(function(a,b){return youAt(b)-youAt(a)||(+a.tree||0)-(+b.tree||0)}),parked=groups.parked.sort(function(a,b){return b.lastActive-a.lastActive}),archive=groups.archive.sort(function(a,b){return touchedAt(b)-touchedAt(a)});
  if(hold)[fresh,working,parked,archive].forEach(function(g){g.sort(function(a,b){var A=domIx[a.tree],B=domIx[b.tree];return (A?A.i:1e6)-(B?B.i:1e6)})});
  $('yt-count').textContent=fresh.length;
  $('yt-sub').innerHTML=(ORDER.length?'your order · <a href="#" data-resetorder="1">reset</a>':'newest first')+(skipped?' · '+skipped+' skipped':'');
  $('yt-empty').textContent=fresh.length?'':'Nothing is waiting on you.';$('yt-head').querySelector('.secl').textContent='Your turn · '+fresh.length+' waiting for you';
  var pinned=groups.pinned.sort(function(a,b){return PINS[a.tree]-PINS[b.tree]});if(hold)pinned.sort(function(a,b){var A=domIx[a.tree],B=domIx[b.tree];return (A?A.i:1e6)-(B?B.i:1e6)});
  // cards slide only when the order or sections change; measuring them on every update cost two full layouts
  var order=[pinned,fresh,working,parked,archive].map(function(g){return g.map(function(x){return x.tree}).join()}).join('|'),moved=!hold&&box._order!==undefined&&box._order!==order;box._order=order;
  var before={};if(moved)document.querySelectorAll('#yourturn .post').forEach(function(p){before[p.dataset.tree]=p.getBoundingClientRect().top});RSEQ++;
  syncPosts($('yt-pinned-list'),pinned,false,hold);syncPosts($('yt-list'),fresh,false,hold);syncPosts($('yt-working-list'),working,true,hold);syncPosts($('yt-parked-list'),parked,true,hold);syncPosts($('yt-archive-list'),archive,true,hold);
  if(!hold)document.querySelectorAll('#yourturn .post').forEach(function(p){if(p._seq!==RSEQ&&!p.querySelector('textarea:focus'))p.remove()});
  var wk0=$('yt-working'),pk0=$('yt-parked');wk0.style.display=working.length?'':'none';pk0.style.display=parked.length?'':'none';
  if(holdCard){var fs=box.querySelector('.feedscroll'),dyH=ae.getBoundingClientRect().top-holdTop;if(fs&&Math.abs(dyH)>0.5)fs.scrollTop+=dyH}
  if(moved)document.querySelectorAll('#yourturn .post').forEach(function(p){var b=before[p.dataset.tree];if(b===undefined||!p.animate)return;var dy=b-p.getBoundingClientRect().top;if(Math.abs(dy)>2)p.animate([{transform:'translateY('+dy+'px)'},{transform:'none'}],{duration:280,easing:'cubic-bezier(.2,.8,.2,1)'})});
  var wk=$('yt-working');wk.style.display=working.length?'':'none';wk.querySelector('.parkedh .secl').textContent='Working · '+working.length+' busy right now';
  var pn=$('yt-pinned');pn.style.display=pinned.length?'':'none';pn.querySelector('.parkedh .secl').textContent='Pinned · '+pinned.length;
  feedMap([['Pinned',pinned],['Your turn',fresh],['Working',working],['Pending',parked],['Archive',archive]]);
  var pk=$('yt-parked');pk.style.display=parked.length?'':'none';pk.querySelector('.parkedh .secl').textContent='Pending · '+parked.length+' waiting on someone else';
  var ar=$('yt-archive');ar.style.display=archive.length?'':'none';ar.classList.toggle('open',ARCHOPEN);$('yt-archive-list').style.display=ARCHOPEN?'':'none';
  ar.querySelector('.parkedh .secl').innerHTML='<svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>Archive · '+archive.length+' untouched for over a week';
  syncFoldAll();
}
var CARDFOLD=(function(){try{return JSON.parse(lsGet('treehouse-cardfold')||'{}')}catch(e){return {}}})();
// Your open/closed choice holds while the card stays in its section. The one automatic change: a card you
// collapsed in Your turn opens again when its session posts a new reply. (Keying on lastActive made a
// working card snap shut again within a second, since its activity time moves constantly.)
// Expand or collapse every card in one feed section. The button reads Collapse all while any card there is open.
var FOLDLIST={pinned:'yt-pinned-list',fresh:'yt-list',working:'yt-working-list',parked:'yt-parked-list',archive:'yt-archive-list'};
function foldAll(sec){var list=$(FOLDLIST[sec]);if(!list)return;var posts=[].slice.call(list.querySelectorAll('.post')),anyOpen=posts.some(function(p){return !p.classList.contains('cardfold')});
  posts.forEach(function(p){var x=S.sessions.find(function(q){return q.tree===p.dataset.tree});if(x)CARDFOLD[x.tree]={sec:sec,say:sayKey(x),folded:anyOpen}});
  lsSet('treehouse-cardfold',JSON.stringify(CARDFOLD));if(sec==='archive'&&!ARCHOPEN){ARCHOPEN=true;lsSet('treehouse-archopen','1')}render()}
function syncFoldAll(){Object.keys(FOLDLIST).forEach(function(sec){var list=$(FOLDLIST[sec]),b=document.querySelector('[data-foldall="'+sec+'"]');if(!list||!b)return;var posts=list.querySelectorAll('.post'),open=[].some.call(posts,function(p){return !p.classList.contains('cardfold')});
  b.hidden=!posts.length||(sec==='archive'&&!ARCHOPEN);var t=open?'Collapse all':'Expand all';if(b.textContent!==t){b.textContent=t;b.dataset.tip=open?'Fold every card in this section':'Open every card in this section'}})}
function secOf(el){return !el?'fresh':el.closest('#yt-pinned-list')?'pinned':el.closest('#yt-working-list')?'working':el.closest('#yt-parked-list')?'parked':el.closest('#yt-archive-list')?'archive':'fresh'}
function sayKey(x){var t=x.lastSay||'';return t.length+':'+t.slice(-40)}
function isFolded(x,sec){var f=CARDFOLD[x.tree];if(f&&f.sec===sec&&!(sec==='fresh'&&f.folded&&f.say!==sayKey(x)))return f.folded;if(sec==='crew')return false;return sec!=='fresh'&&sec!=='pinned'}
function toggleCard(tree,card){var x=S.sessions.find(function(q){return q.tree===tree});if(!x)return;var el=card||document.querySelector('#yourturn .post[data-tree="'+tree+'"]'),sec=el&&el.closest('#captain')?'crew':secOf(el);CARDFOLD[tree]={sec:sec,say:sayKey(x),folded:!isFolded(x,sec)};lsSet('treehouse-cardfold',JSON.stringify(CARDFOLD));render()}
var ORDER=(function(){try{return JSON.parse(lsGet('treehouse-cardorder')||'[]')}catch(e){return []}})();
function manualSort(items){if(!ORDER.length)return items;var pos={};ORDER.forEach(function(t,i){pos[t]=i});return items.map(function(x,i){return {x:x,k:pos[x.tree]===undefined?1e6+i:pos[x.tree]}}).sort(function(a,b){return a.k-b.k}).map(function(o){return o.x})}
// Working is ordered by when you last wrote to each tree, newest first, so Claude's replies never shuffle it.
function youAt(x){var m=SENT[x.tree];return Math.max(x.lastUserAt||0,m?m.at:0,LAST_SENT&&LAST_SENT.tree===x.tree?LAST_SENT.at:0)}
// Whether a card's text overflows its clip is read once per frame for every changed card, not once per card.
var CLIPQ=[];function clipCheck(cb){if(CLIPQ.push(cb)>1)return;requestAnimationFrame(function(){var q=CLIPQ;CLIPQ=[];q.forEach(function(c){c._over=c.scrollHeight>c.clientHeight+2});q.forEach(function(c){c.classList.toggle('over',c._over)})})}
function syncPosts(container,items,parked,hold){if(container.id==='yt-list'&&!hold)items=manualSort(items);
  var keep={},act=hold?null:[].slice.call(container.children).find(function(el){var ta=el.querySelector('textarea');return ta&&(ta===document.activeElement||ta.value.trim())});
  if(act){var have={};[].slice.call(container.children).forEach(function(el){have[el.dataset.tree]=1});var old=[],fresh=[];items.forEach(function(x){(have[x.tree]?old:fresh).push(x)});
    old.sort(function(a,b){return [].indexOf.call(container.children,container.querySelector('.post[data-tree="'+a.tree+'"]'))-[].indexOf.call(container.children,container.querySelector('.post[data-tree="'+b.tree+'"]'))});
    var at=old.findIndex(function(x){return x.tree===act.dataset.tree});items=at<0?old.concat(fresh):old.slice(0,at+1).concat(fresh,old.slice(at+1))}
  items.forEach(function(x,idx){
    keep[x.tree]=1;
    var el=(container.closest('#captain')||document.getElementById('yourturn')).querySelector('.post[data-tree="'+x.tree+'"]');el&&(el._seq=RSEQ);
    if(!el){el=document.createElement('div');el.className='post entering';setTimeout(function(){el.classList.remove('entering')},400);el.dataset.tree=x.tree;el.style.setProperty('--tcol',colorFor(x.tree));el._seq=RSEQ;el.innerHTML='<div class="post-main"></div><div class="post-latest"></div>'+postComposer(x);var dta=el.querySelector('textarea');if(dta&&DRAFT[x.tree]){dta.value=DRAFT[x.tree];growBox(dta)}}
    if(container.children[idx]!==el&&!el.contains(document.activeElement))container.insertBefore(el,container.children[idx]||null);
    var fold=isFolded(x,container.closest('#captain')?'crew':secOf(container));el.classList.toggle('cardfold',fold);
    var head=postTop(x),main=el.querySelector('.post-main'),lat=postLatest(x),le=el.querySelector('.post-latest');
    // never swap a card part out from under the pointer: a redraw between press and release eats the click
    if(main._h!==head&&!main.querySelector('.topicedit')&&!main.matches(':hover')){main._h=head;main.innerHTML=head}
    if(SENT[x.tree]&&LOCKH[x.tree]){le.classList.add('locked');le.style.height=LOCKH[x.tree]+'px'}else if(le.classList.contains('locked')){le.classList.remove('locked');le.style.height='';delete LOCKH[x.tree]}
    if(le._h!==lat&&(!le.matches(':hover')&&!le.contains(document.activeElement)&&!selIn(le)||FORCE[x.tree])){delete FORCE[x.tree];var had=le._h;le._h=lat;le.innerHTML=lat;if(le.classList.contains('locked'))le.scrollTop=le.scrollHeight;var cb=le.querySelector('.clip');if(cb)clipCheck(cb);if(had&&CONVO===x.tree&&$('convo').open)soonChat(x.tree)}
  });
}
// After a card leaves (skip), bring the next one to the top of the feed. The scroll is worked out after the
// card is gone and the feed has re-laid out, so the removal cannot leave you halfway into a card.
function nextPostAfter(fromTree){var posts=[].slice.call(document.querySelectorAll('#yt-list .post')),i=posts.findIndex(function(p){return p.dataset.tree===fromTree});return posts[i+1]||posts.filter(function(p){return p.dataset.tree!==fromTree})[0]||null}
function scrollPostToTop(post){if(!post||!post.isConnected)return;var fs=document.querySelector('#yourturn .feedscroll');if(!fs)return;var top=-8,el=post;while(el&&el!==fs){top+=el.offsetTop;el=el.offsetParent}if(el!==fs)return;fs.scrollTo({top:Math.max(0,top),behavior:'smooth'});var ta=post.querySelector('textarea');if(ta)ta.focus({preventScroll:true})}
function focusNextPost(fromTree){scrollPostToTop(nextPostAfter(fromTree))}
function renderOverview(){
  renderYourTurn();requestAnimationFrame(function(){document.querySelectorAll('#tiles .tile .s').forEach(function(el){if(el.scrollWidth>el.clientWidth+1)el.dataset.tip=el.textContent;else delete el.dataset.tip})},0);
  var s=S.sys,p=pressure(),sp=s.swapTotalMB?s.swapUsedMB/s.swapTotalMB*100:0;
  var servers=S.servers.filter(function(x){return x.kind==='next'||x.kind==='metro'});
  var working=S.sessions.filter(function(x){return x.claudeState==='working'}).length,turn=S.sessions.filter(function(x){return sessState(x).cls==='waiting'&&!isCrew(x)}).length;
  var devMem=S.servers.reduce(function(a,x){return a+x.memMB},0);
  var cpu=Math.round(s.cpuUser+s.cpuSys),memPct=s.usedMB/s.totalMB*100,budget=S.settings.serverBudget||0;
  var claude=S.sessions.filter(function(x){return x.claudeState!=='none'}),idle=claude.length-working-turn;
  function lvl(p,w,b){return p>=b?'bad':p>=w?'warn':'ok'}
  function meter(p,cls){return '<div class="meter"><span class="'+cls+'" style="width:'+Math.min(100,Math.max(2,p)).toFixed(1)+'%"></span></div>'}
  function chip(text,cls){return '<span class="chip '+cls+'">'+text+'</span>'}
  function num(main,of){return '<div class="n">'+main+(of?'<span class="of">'+of+'</span>':'')+'</div>'}
  function unitless(mb){return mb>=1024?(mb/1024).toFixed(1):String(Math.round(mb))}
  function unit(mb){return mb>=1024?'GB':'MB'}
  var memL=s.freePct<15||sp>60?'bad':s.freePct<35||sp>25?'warn':'ok';
  var serverBlocks=servers.map(function(x,i){return '<i class="'+(budget&&i>=budget?'over':'')+'" title="'+esc(treeName(x.tree)+' '+x.label+' · '+gb(x.memMB))+'" style="--c:'+colorFor(x.tree)+'"></i>'}).join('')+(budget>servers.length?new Array(budget-servers.length+1).join('<i class="empty"></i>'):'');
  $H('tiles').html=
    '<div class="tile t2"><div class="k">Memory'+chip(p[1].replace('under ',''),memL)+'</div>'+num(unitless(s.usedMB),' / '+gb(s.totalMB))+meter(memPct,memL)+'<div class="s">'+Math.round(memPct)+'% used'+(s.appMB?' · apps '+gb(s.appMB)+' · compressed '+gb(s.compressorMB)+' · '+gb(s.cachedMB||0)+' cache':' · '+gb(Math.max(0,s.totalMB-s.usedMB))+' free')+'</div></div>'+
    '<div class="tile t2"><div class="k">Swap'+chip(Math.round(sp)+'%',lvl(sp,25,60))+'</div>'+num(unitless(s.swapUsedMB),' / '+gb(s.swapTotalMB))+meter(sp,lvl(sp,25,60))+'<div class="s">memory spilled to disk</div></div>'+
    '<div class="tile t2"><div class="k">CPU'+chip(cpu+'%',lvl(cpu,60,85))+'</div>'+num(cpu+'%','')+meter(cpu,lvl(cpu,60,85))+'<div class="s">'+s.cores+' cores · load '+s.load[0].toFixed(1)+'</div></div>'+
    '<div class="tile t3"><div class="k">Dev servers'+(budget?chip(servers.length>budget?(servers.length-budget)+' over':'within limit',servers.length>budget?'bad':'ok'):'')+'</div>'+num(String(servers.length),budget?' / '+budget+' budget':'')+'<div class="blocks">'+serverBlocks+'</div><div class="s">'+gb(devMem)+' of '+gb(s.usedMB)+' used is dev processes</div></div>'+
    '<div class="tile t3"><div class="k">Claude sessions'+chip(turn+' your turn',turn?'waiting':'ok')+'</div>'+num(String(claude.length),' / '+((S.pool&&S.pool.max)||claude.length)+' trees')+
      '<div class="stack">'+(working?'<span style="flex:'+working+';background:var(--work)"></span>':'')+(turn?'<span style="flex:'+turn+';background:var(--wait)"></span>':'')+(idle>0?'<span style="flex:'+idle+';background:var(--other)"></span>':'')+'</div>'+
      '<div class="s legendrow"><span><i style="background:var(--work)"></i>'+working+' working</span><span><i style="background:var(--wait)"></i>'+turn+' your turn</span><span><i style="background:var(--other)"></i>'+Math.max(0,idle)+' idle</span></div></div>';
  var ts=treeSeries('trees','ch-ov-mem');
  var legendRows=S.sessions.filter(function(x){return x.memMB>50}).length;
  var memMode=lsGet('treehouse-memmode')==='bars'?'bars':'chart';
  document.querySelectorAll('.memMode button').forEach(function(b){b.classList.toggle('on',b.dataset.memmode===memMode)});
  $('ov-mem-chartrow').style.display=memMode==='chart'?'':'none';$('ov-mem-bars').style.display=memMode==='bars'?'':'none';
  if(memMode==='chart')chart('ch-ov-mem',{series:ts,stacked:true,fmt:gb,minHeight:legendRows*22+8,yMax:memCap()});
  else memBars('ov-mem-bars');
  $H('ov-mem-v').html=gb(S.sessions.reduce(function(a,x){return a+x.memMB},0)).replace(/ GB$/,'')+' of '+gb(S.sys.usedMB)+' in trees';
  $H('ov-mem-legend').html=S.sessions.filter(function(x){return x.memMB>50}).sort(function(a,b){return b.memMB-a.memMB}).map(function(x){return '<div><i style="background:'+colorFor(x.tree)+'"></i><span>'+treeName(x.tree)+'</span><b>'+gb(x.memMB)+'</b></div>'}).join('');
  chart('ch-ov-swapcpu',{series:[{name:'Swap used',color:'var(--bad)',get:function(p){return p.swap}},{name:'Compressed',color:'var(--warn)',get:function(p){return p.comp||0}}],fmt:gb,yMax:niceMax(Math.max(s.swapTotalMB,1)),area:true});
  var max=Math.max.apply(null,[1].concat(S.sessions.map(function(x){return x.memMB})));
  $H('ov-trees').html='<table class="ovtrees"><thead><tr><th>Tree</th><th>State</th><th>Working on</th><th class="num">Memory</th><th>Dev servers</th><th>Last active</th><th></th></tr></thead><tbody>'+S.sessions.map(function(x){var st=sessState(x),sv=x.services.filter(function(v){return v.kind==='next'||v.kind==='metro'});return '<tr data-go="sessions"><td>'+treeIcon(x.tree,20)+'<b>'+treeName(x.tree)+'</b></td><td><span class="pill '+st.cls+'">'+st.label+'</span></td><td>'+esc(x.title||'-')+'</td><td class="num mono">'+gb(x.memMB)+'<span class="membar"><span style="width:'+(x.memMB/max*100)+'%;background:'+colorFor(x.tree)+'"></span></span></td><td class="small">'+(sv.map(function(v){return esc(v.label.replace('Next dev server','Next').replace('Metro / Expo','Metro'))+(v.orphan?' <span class="pill bad">orphan</span>':'')}).join(', ')||(x.sims&&x.sims.length?'':'<span class="muted">-</span>'))+simPills(x)+'</td><td class="small muted">'+ago(x.lastActive)+'</td><td class="rowicons">'+treeActs(x)+'</td></tr>'}).join('')+'</tbody></table>';
}
function memBars(id){var s=S.sys;var bt=S.sessions.filter(function(x){return x.memMB>50}).sort(function(a,b){return b.memMB-a.memMB}),bmax=Math.max.apply(null,[1].concat(bt.map(function(x){return x.memMB}))),bsum=bt.reduce(function(a,x){return a+x.memMB},0);
    $H(id).html=bt.map(function(x){return '<div class="r" title="'+esc(treeName(x.tree)+(x.title?' · '+x.title:''))+'">'+treeIcon(x.tree,20)+'<b>'+treeName(x.tree)+'</b><div class="t"><span style="width:'+(x.memMB/bmax*100)+'%;background:'+colorFor(x.tree)+'"></span></div><span class="gb">'+gb(x.memMB)+'</span><span class="pc">'+Math.round(x.memMB/s.totalMB*100)+'% RAM</span></div>'}).join('')+'<div class="foot">'+gb(bsum)+' of '+gb(s.totalMB)+' RAM is in trees right now ('+Math.round(bsum/s.totalMB*100)+'%). Live, not affected by chart history.</div>'}
function renderResources(){
  var s=S.sys,trees=S.sessions.filter(function(x){return x.memMB>50}).sort(function(a,b){return b.memMB-a.memMB}),sum=trees.reduce(function(a,x){return a+x.memMB},0),other=Math.max(0,s.usedMB-sum),free=Math.max(0,s.totalMB-s.usedMB);
  function seg(mb,c,t){return '<span style="width:'+(mb/s.totalMB*100)+'%;background:'+c+'" title="'+esc(t)+'"></span>'}
  $H('res-now-v').html=gb(s.usedMB)+' of '+gb(s.totalMB)+' used'+(s.appMB?' (apps '+gb(s.appMB)+', wired '+gb(s.wiredMB)+', compressed '+gb(s.compressorMB)+')':'')+(s.cachedMB?' · '+gb(s.cachedMB)+' cached files':'')+' · swap '+gb(s.swapUsedMB);
  $H('res-bar').html=trees.map(function(x){return seg(x.memMB,colorFor(x.tree),treeName(x.tree)+': '+gb(x.memMB))}).join('')+seg(other,'var(--other)','everything else: '+gb(other));
