    '<div class="row scacts">'+(x.tty?'<button class="hact" data-focus="'+x.tree+'" data-tip="Open its terminal">'+ICO.term+'</button>':'')+(x.services.some(function(v){return v.killable&&v.kind!=='claude'})?'<button class="hact danger" data-stoptree="'+x.tree+'" data-tip="Stop its dev servers (Claude keeps running)">'+ICO.stop+'</button>':'')+(x.tree!=='main'?'<button class="hact danger" data-closetree="'+x.tree+'" data-tip="Close tree: stop everything, end its Claude session, close its tab, return the tree">'+ICO.close+'</button>':'')+'</div></div>'}
document.addEventListener('click',function(e){var c=e.target.closest&&e.target.closest('[data-cardopen]');if(!c||e.target.closest('button,a,input,textarea')||String(window.getSelection()||''))return;openConvo(c.dataset.cardopen)});
function renderSessions(){
  var groups=[['waiting','Your turn','var(--wait)'],['working','Working','var(--work)'],['idle','Idle','var(--faint)'],['none','No Claude session','var(--line)']];
  var by={waiting:[],working:[],idle:[],none:[]};
  S.sessions.forEach(function(x){var c=x.claudeState==='none'?'none':sessState(x).cls;(by[c]||by.idle).push(x)});
  by.waiting.sort(function(a,b){return b.lastActive-a.lastActive});
  $H('sessions-wrap').html=groups.filter(function(g){return by[g[0]].length}).map(function(g){return '<div class="group-h"><span class="dotlg" style="background:'+g[2]+'"></span>'+g[1]+'<span class="n">'+by[g[0]].length+'</span></div><div class="sessions">'+by[g[0]].map(sessionCard).join('')+'</div>'}).join('')||'<div class="empty">No sessions.</div>';
}
// The treehouse: one tile per pool slot in tree order, so each tree keeps its place; the avatar's glow is its state.
function slotState(t){return t.status==='empty'?'empty':t.status==='available'?'free':t.claudeState==='none'?'idle':sessState(t).cls}
function renderSlots(){
  var all=S.trees.slice().sort(function(a,b){return TREE_GET.tree(a)-TREE_GET.tree(b)}),top=Math.max.apply(null,[0].concat(all.filter(function(t){return t.status!=='empty'}).map(function(t){return +t.tree||0}))),list=all.filter(function(t){return t.status!=='empty'||+t.tree<top}),spare=all.length-list.length,mainS=S.sessions.find(function(q){return q.tree==='main'});
  if(mainS&&!list.some(function(t){return t.tree==='main'}))list.unshift(Object.assign({status:'main',servers:(mainS.services||[]).filter(function(v){return v.kind!=='claude'&&v.kind!=='mcp'}).length},mainS));
  var maxMem=Math.max.apply(null,[1].concat(list.map(function(t){return t.memMB||0})));
  var LBL={waiting:'your turn',working:'working',idle:'idle',free:'free',empty:'empty'};
  $H('slots').html='<div class="ptitle"><b>Treehouse</b><span class="v small muted">click a tree to open it · hover anything for details</span></div><div class="thgrid">'+list.map(function(t){
    var st=slotState(t),x=S.sessions.find(function(q){return q.tree===t.tree}),open=x&&x.claudeState!=='none';
    if(st==='empty')return '<div class="th empty" data-tip="'+esc(treeName(t.tree))+' · no worktree yet; treehouse creates it when a tree is needed"><div class="thav"><span class="thnum">'+esc(isMainT(t.tree)?'M':slotOf(t.tree))+'</span></div><div class="thname">'+treeName(t.tree)+'</div><div class="thtopic muted">empty</div></div>';
    var topic=x?((x.tabNamed?x.title:humanize(x.title))||humanize(branchLabel(x.branch))):(t.title||'');
    var sims=x&&x.sims||[],prs=(x&&x.prs||[]).filter(function(p){return p.state==='open'||p.state==='draft'}),subs=x?subRunning(x):[],srv=t.servers||0;
    var badges=(srv?'<span class="thb" data-tip="'+srv+' dev server'+(srv>1?'s':'')+' running">'+TIC.srv+srv+'</span>':'')+
      (sims.length?'<span class="thb" data-tip="'+esc(sims.map(function(m){return m.name+(m.connected?' · connected':' · not connected')}).join(', '))+'">'+TIC.phone+sims.length+'</span>':'')+
      (prs.length?'<span class="thb" data-tip="'+prs.length+' open PR'+(prs.length>1?'s':'')+': '+esc(prs.map(function(p){return '#'+p.number}).join(' '))+'">'+TIC.br+prs.length+'</span>':'')+
      (subs.length?'<span class="thb work" data-tip="'+subs.length+' subagent'+(subs.length>1?'s':'')+' running">'+TIC.agent+subs.length+'</span>':'')+
      (t.dirty?'<span class="thb warn" data-tip="'+t.dirty+' uncommitted file'+(t.dirty>1?'s':'')+'">'+TIC.edit+t.dirty+'</span>':'')+
      (t.ahead?'<span class="thb" data-tip="'+t.ahead+' commit'+(t.ahead>1?'s':'')+' not on master">'+TIC.up+t.ahead+'</span>':'');
    return '<div class="th '+st+(open?' open':'')+(x&&x.menu?' asks':'')+'"'+(open?' data-cardopen="'+t.tree+'"':'')+' data-tip="'+esc(treeName(t.tree)+' · '+(LBL[st]||st)+(t.lastActive?' · active '+ago(t.lastActive):'')+(t.branch?' · '+t.branch:''))+'">'+
      '<div class="thav">'+treeIcon(t.tree,52)+(x&&x.menu?'<span class="thq">?</span>':'')+'</div>'+
      '<div class="thname">'+treeName(t.tree)+(x&&isCaptain(x)?'<span class="capic" data-tip="Captain">'+WHEEL+'</span>':'')+'<span class="thst">'+(LBL[st]||st)+'</span>'+(isCrew(x)?'<span class="pill agentpill" data-tip="Run by the captain; it shows on the Captain page, not in your feed">crew</span>':'')+'</div>'+
      '<div class="thtopic">'+esc(topic||(st==='free'?'free for the next task':'-'))+'</div>'+
      (t.memMB?'<div class="thmem" data-tip="'+gb(t.memMB)+' in use"><span style="width:'+Math.max(4,t.memMB/maxMem*100)+'%;background:'+colorFor(t.tree)+'"></span></div><div class="thmemv">'+gb(t.memMB)+'</div>':'')+
      (badges?'<div class="thbadges">'+badges+'</div>':'')+
      '<div class="thacts">'+(open?'<button class="hact" data-convo="'+t.tree+'" data-tip="Open the conversation">'+TIC.chat+'</button>':'')+(x&&x.tty?'<button class="hact" data-focus="'+t.tree+'" data-tip="Open its terminal">'+ICO.term+'</button>':'')+(t.stoppable?'<button class="hact danger" data-stoptree="'+t.tree+'" data-tip="Stop its dev servers, Metro, Jest and stray node processes. Never touches Claude or the files.">'+ICO.stop+'</button>':'')+(t.status==='in-use'||t.status==='orphan'?'<button class="hact danger" data-closetree="'+t.tree+'" data-tip="Close tree: stop everything, end its Claude session, close its tab, return the tree">'+ICO.close+'</button>':'')+'</div></div>'}).join('')+(spare?'<div class="th empty more" data-tip="'+spare+' more slot'+(spare>1?'s':'')+' under your limit of '+(S.pool.max||'?')+'; treehouse creates a tree in one when it is needed"><div class="thav"><span class="thnum">+'+spare+'</span></div><div class="thname">more slots</div><div class="thtopic muted">room under your limit</div></div>':'')+'</div>';
}
function renderPool(){
  renderSlots();
  if($('pool').querySelector('input:focus'))return;
  var p=S.pool,full=p.max&&p.inUse>=p.max,list=S.trees.slice().sort(function(a,b){return TREE_GET.tree(a)-TREE_GET.tree(b)}),cnt={waiting:0,working:0,idle:0,free:0,empty:0};
  list.forEach(function(t){var k=slotState(t);cnt[k]=(cnt[k]||0)+1});
  var mem=S.sessions.reduce(function(a,x){return a+(x.memMB||0)},0);
  var stat=function(k,label,n){return '<div class="thstat '+k+'"><b>'+n+'</b><span>'+label+'</span></div>'};
  $H('pool').html='<div class="thsum"><div class="thsuml"><div class="thhead"><b>'+p.inUse+' of '+(p.max||'?')+' trees in use</b><span class="small" style="color:var(--'+(full?'bad':p.max&&p.inUse>=p.max-2?'warn':'faint')+')">'+(full?'· full: the next new task cannot get a tree':'· '+(p.max-p.inUse)+' more under your limit')+'</span></div>'+
    '<div class="thcap">'+list.filter(function(t){return slotState(t)!=='empty'}).map(function(t){var k=slotState(t);return '<span class="thseg '+k+'" data-tip="'+esc(treeName(t.tree)+' · '+k)+'"></span>'}).join('')+(p.max&&p.max>p.total?'<span class="thseg empty" style="flex:'+(p.max-p.total)+'" data-tip="'+(p.max-p.total)+' more slots under your limit"></span>':'')+'</div>'+
    '<div class="thstats">'+stat('waiting','your turn',cnt.waiting)+stat('working','working',cnt.working)+stat('idle','idle',cnt.idle)+stat('free','free',cnt.free)+'<div class="thstat mem"><b>'+gb(mem)+'</b><span>in trees of '+gb(S.sys.usedMB)+' used</span></div></div></div>'+
    '<div class="thsumr"><div class="thlimit"><span class="thlimitl" data-tip="The limit treehouse itself enforces (max_trees in ~/.config/treehouse/config.toml). A limit below the trees in use is refused, never applied.">Tree limit</span><input type="number" class="maxtrees" min="1" max="100" value="'+(p.max||'')+'" data-orig="'+(p.max||'')+'"><button class="primary" data-savemax="1" hidden>Save</button></div></div></div>';
}

var SORT={prs:JSON.parse(lsGet('devdeck-sort-prs')||'null')||{k:'updated',d:-1},trees:JSON.parse(lsGet('devdeck-sort-trees')||'null')||{k:'tree',d:1},procs:JSON.parse(lsGet('devdeck-sort-procs')||'null')||{k:'tree',d:1}};
var STATE_RANK={working:0,waiting:1,idle:2,unknown:2,none:3};
var POOL_RANK={'in-use':0,available:1,empty:2};
function sortRows(rows,table,getters){var s=SORT[table],g=getters[s.k]||getters.tree;return rows.slice().sort(function(a,b){var x=g(a),y=g(b),c=typeof x==='string'?x.localeCompare(y):x-y;return c*s.d||getters.tree(a)-getters.tree(b)})}
function th(table,key,label,num){var s=SORT[table],on=s.k===key;return '<th class="sortable'+(num?' num':'')+(on?' sorted':'')+'" data-sort="'+table+':'+key+'">'+label+'<span class="arrow">'+(on?(s.d>0?'\u25B2':'\u25BC'):'')+'</span></th>'}
var TREE_GET={tree:function(t){return t.tree==='main'?-1:+t.tree},pool:function(t){return POOL_RANK[t.status]==null?3:POOL_RANK[t.status]},claude:function(t){return t.claudeState==='none'?9:STATE_RANK[sessState(t).cls]},branch:function(t){return t.branch||'\uffff'},dirty:function(t){return t.dirty},ahead:function(t){return t.ahead},mem:function(t){return t.memMB},servers:function(t){return t.servers},active:function(t){return t.lastActive||0}};
var PROC_GET={tree:function(x){return x.tree==='main'?-1:+x.tree},process:function(x){return x.label},ports:function(x){return x.ports[0]||99999},mem:function(x){return x.memMB},cpu:function(x){return x.cpu},up:function(x){return x.age},active:function(x){var se=S.sessions.find(function(s){return s.tree===x.tree});return se&&se.claudeState==='working'?Date.now():se?se.lastActive||0:0}};
