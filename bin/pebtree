function moveTo(t,sec){var x=S.sessions.find(function(q){return q.tree===t});if(!x||!SECNAME[sec])return;
  if(sec==='pinned'){if(!PINS[t])togglePin(t);else toast(treeName(t)+' is already pinned');return}
  if(x.claudeState==='working'||SENT[x.tree]){toast(treeName(t)+' is working; move it once it answers');return}
  if(PINS[t]){delete PINS[t];lsSet('treehouse-pins',JSON.stringify(PINS))}
  if(LATER[t]){delete LATER[t];lsSet('treehouse-later',JSON.stringify(LATER))}
  delete SENT[t];PLACE[t]={sec:sec,at:Date.now(),la:x.lastActive};lsSet('treehouse-place',JSON.stringify(PLACE));delete SECT[t];
  document.querySelectorAll('.post[data-tree="'+t+'"] .post-main').forEach(function(m){m._h=''});
  render();if($('convo').open&&CONVO===t)paintConvo(false);
  toast('Moved '+treeName(t)+' to '+SECNAME[sec]+(sec==='fresh'?'':' · it comes back to Your turn when it says something new'))}
