#!/usr/bin/env node
// pebtree - local web dashboard for treehouse worktrees: Claude sessions, the tree each one
// uses, every dev process (Next, Metro/Expo, Jest, MCP) with its real memory, the Mac's
// memory/swap/CPU over time, the swarm captain's board, and stop/throttle/cleanup controls.
//
// This fork follows Claude sessions on this Mac and on other machines over ssh (config.json "hosts"),
// in iTerm2 tabs or tmux, and starts new ones (a fresh treehouse worktree, a checkout, Codex, a shell)
// in tmux, with a terminal for each right in the page.
//
// Usage: pebtree [--port 4777]      then open http://localhost:4777
//        pebtree new <preset> | <host> <kind> [repo] [--prompt "..."]   start a session (kinds: tree, claude, codex, shell)
//        pebtree agent                                 what runs on each ssh host; spoken to over stdin/stdout
//        pebtree init [--main <repo>] [--pool <dir>]   write ~/.config/pebtree/config.json for this machine
//        pebtree doctor                                check every dependency and say how to fix what is missing
//        pebtree tickets-key [url]                     save the tickets API key from the clipboard into config.json
//        pebtree proof [files...] --title "..." [--note "..."] [--run "cmd"]
//        pebtree spinoff [--title "short name"] [--from <tree>] (--brief-file brief.md | "task text")
//          run from inside a tree: files and command output land on the dashboard's Proof tab
// Binds to 127.0.0.1 only. Actions need the per-run token embedded in the page.

'use strict';
const http = require('http');
const fs = require('fs');
const path = require('path');
const os = require('os');
const crypto = require('crypto');
const { execFile, spawn } = require('child_process');

const HOME = os.homedir();
const AGENT = process.argv[2] === 'agent'; // running on another host for the dashboard, over ssh
// tmux, treehouse, claude and codex live in these, whatever started pebtree (a LaunchAgent, ssh without a login shell)
process.env.PATH = [...new Set([path.join(HOME, '.local/bin'), path.join(HOME, 'bin'), '/opt/homebrew/bin', '/usr/local/bin', ...(process.env.PATH || '/usr/bin:/bin').split(':')])].join(':');
if (!/utf-?8/i.test(process.env.LANG || '')) process.env.LANG = process.platform === 'darwin' ? 'en_US.UTF-8' : 'C.UTF-8'; // tmux draws ✳ and box lines as _ without it
const CONF_DIR = path.join(HOME, '.config/pebtree');
// Per-machine setup lives in ~/.config/pebtree/config.json (written by `pebtree init`; see docs/pebtree.md).
// Env vars override it. Without either, `pebtree init` has to be run first.
const CONFIG_FILE = path.join(CONF_DIR, 'config.json');
const CONFIG = (() => { try { return JSON.parse(fs.readFileSync(CONFIG_FILE, 'utf8')); } catch { return {}; } })();
const tilde = (p) => (p ? String(p).replace(/^~(?=$|\/)/, HOME) : p);
const MAIN = tilde(process.env.TREEHOUSE_MAIN || CONFIG.main) || '';
const POOL = tilde(process.env.TREEHOUSE_POOL || CONFIG.pool) || '';
const REPO_DIR = CONFIG.repoDir || (MAIN ? path.basename(MAIN) : ''); // the checkout's folder name inside each pool slot: <pool>/<N>/<repoDir>
// stops a tree's dev servers before it is returned; by default treehouse-dev's teardown when it is installed, else nothing
const TEARDOWN = CONFIG.teardown !== undefined ? CONFIG.teardown : ((process.env.PATH || '').split(':').some((d) => d && fs.existsSync(path.join(d, 'treehouse-dev'))) ? 'treehouse-dev teardown {tree}' : '');
const JOURNAL_SKILL = CONFIG.journalSkill || '/daily-standup';
const LOCAL_HOST = CONFIG.localHost || 'mac'; // this Mac's id in session ids; others come from config.json "hosts"
// what sessions pebtree starts run with; skipping permission prompts is something config.json opts into, never the default
const CLAUDE_ARGS = Array.isArray(CONFIG.claudeArgs) ? CONFIG.claudeArgs.map(String) : [];
const SWARM = path.join(HOME, '.claude/swarm');
const SETTINGS_FILE = path.join(CONF_DIR, 'settings.json');
const UI_FILE = path.join(CONF_DIR, 'ui.json'); // page layout prefs (splits, ranges, font...) so every browser and window gets the same layout
const TITLES_FILE = path.join(CONF_DIR, 'titles.json'); // names you gave sessions, keyed by Claude pid so a new session in the tree starts fresh
const LOG_FILE = path.join(CONF_DIR, 'actions.jsonl');
const PORT = Number((process.argv.find((a, i) => process.argv[i - 1] === '--port')) || 4777);
// Kept across restarts (owner-only file) so open tabs keep working; it only stops other sites from posting actions.
const TOKEN = AGENT ? '' : (() => {
  const f = path.join(os.homedir(), '.config/pebtree/token');
  try { const t = fs.readFileSync(f, 'utf8').trim(); if (/^[0-9a-f]{32}$/.test(t)) return t; } catch { /* first run */ }
  const t = crypto.randomBytes(16).toString('hex');
  try { fs.mkdirSync(path.dirname(f), { recursive: true }); fs.writeFileSync(f, t, { mode: 0o600 }); } catch { /* fall back to a per-run token */ }
  return t;
})();
const TOTAL_RAM_MB = os.totalmem() / 1048576;
const FAST_MS = 4000;
const SLOW_MS = 15000;
const FINE_POINTS = 900; // 1 hour at 4s
const COARSE_POINTS = 1440; // 24 hours at 1 min, persisted
const HISTORY_FILE = path.join(CONF_DIR, 'history.jsonl');
const TREEHOUSE_CONFIG = path.join(HOME, '.config/treehouse/config.toml');

function readMaxTrees() {
  try { const m = fs.readFileSync(TREEHOUSE_CONFIG, 'utf8').match(/^\s*max_trees\s*=\s*(\d+)/m); return m ? +m[1] : null; } catch { return null; }
}
function writeMaxTrees(n) {
  let text = '';
  try { text = fs.readFileSync(TREEHOUSE_CONFIG, 'utf8'); } catch { /* new file */ }
  text = /^\s*max_trees\s*=/m.test(text) ? text.replace(/^(\s*max_trees\s*=\s*)\d+/m, `$1${n}`) : `max_trees = ${n}\n` + text;
  fs.mkdirSync(path.dirname(TREEHOUSE_CONFIG), { recursive: true });
  fs.writeFileSync(TREEHOUSE_CONFIG, text);
}

const DEFAULT_SETTINGS = { autoStopIdleMinutes: 0, serverBudget: 3, journalEnabled: true, journalLastRun: '' };
let settings = { ...DEFAULT_SETTINGS, ...readJson(SETTINGS_FILE, {}) };
let customTitles = readJson(TITLES_FILE, {});
let uiPrefs = readJson(UI_FILE, {});

function readJson(file, fallback) {
  try { return JSON.parse(fs.readFileSync(file, 'utf8')); } catch { return fallback; }
}
function run(cmd, args, opts = {}) {
  return new Promise((resolve) => {
    execFile(cmd, args, { maxBuffer: 32 * 1024 * 1024, timeout: 20000, ...opts }, (err, stdout) => resolve(err && !stdout ? '' : String(stdout)));
  });
}
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

// ---------- process model ----------

// Which tree a path on this Mac belongs to: a slot of any treehouse pool (<host>:<repo>:<N>), or a checkout a
// session runs in (<host>:<repo>:main). Ids are the same strings sessions are keyed by everywhere.
const POOL_RE = /\/\.treehouse\/([^/\s]+)\/(\d+)\/([^/\s]+)(?=\/|\s|$)/;
let LOCAL_TOPS = []; // git checkouts local sessions run in, longest first
function treeOf(cwd) {
  if (!cwd) return null;
  const m = cwd.match(POOL_RE);
  if (m) return `${LOCAL_HOST}:${m[3]}:${m[2]}`;
  const top = LOCAL_TOPS.find((t) => cwd === t || cwd.startsWith(t + '/'));
  return top ? `${LOCAL_HOST}:${path.basename(top)}:main` : null;
}

function kindOf(args, comm) {
  if (/^claude(\s|$)/.test(args) || /^\d+\.\d+\.\d+$/.test(comm)) return 'claude';
  if (/caffeinate/.test(args)) return null;
  if (/mcp-server|\bmcp\b/.test(args)) return 'mcp';
  if (/treehouse-dev|next dev|next-server|next\/dist|next start/.test(args)) return 'next';
  if (/expo(\/bin\/cli)? start|expo start|metro|react-native start/.test(args)) return 'metro';
  if (/jest/.test(args)) return 'jest';
  if (/tsserver|typescript\/lib/.test(args)) return 'tsserver';
  if (/^(\S*\/)?(node|npm|npx|pnpm|tsx)\b/.test(args)) return 'node';
  return null;
}

const KILLABLE = new Set(['next', 'metro', 'jest', 'node', 'tsserver', 'mcp']);
const SERVER_KINDS = new Set(['next', 'metro']);

function parseMem(s) {
  const m = String(s).match(/^([\d.]+)([BKMG])/);
  if (!m) return 0;
  const v = parseFloat(m[1]);
  return m[2] === 'G' ? v * 1024 : m[2] === 'M' ? v : m[2] === 'K' ? v / 1024 : v / 1048576;
}

function etimeSeconds(e) {
  const m = String(e).trim().match(/^(?:(\d+)-)?(?:(\d+):)?(\d+):(\d+)$/);
  if (!m) return 0;
  return (+(m[1] || 0)) * 86400 + (+(m[2] || 0)) * 3600 + (+m[3]) * 60 + (+m[4]);
}

async function readProcesses() {
  const out = await run('ps', ['-axo', 'pid=,ppid=,rss=,%cpu=,etime=,tty=,comm=,args=']);
  const procs = new Map();
  for (const line of out.split('\n')) {
    const m = line.match(/^\s*(\d+)\s+(\d+)\s+(\d+)\s+([\d.]+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(.*)$/);
    if (!m) continue;
    const comm = path.basename(m[7]);
    procs.set(+m[1], { pid: +m[1], ppid: +m[2], rssMB: +m[3] / 1024, cpu: +m[4], age: etimeSeconds(m[5]), tty: m[6] === '??' || m[6] === '?' ? null : m[6], comm, args: m[8].trim() });
  }
  return procs;
}

async function readCwds(pids) {
  const cwds = new Map();
  if (!pids.length) return cwds;
  if (process.platform === 'linux') { for (const pid of pids) try { cwds.set(pid, fs.readlinkSync(`/proc/${pid}/cwd`)); } catch { /* gone, or not ours */ } return cwds; }
  const out = await run('lsof', ['-a', '-d', 'cwd', '-p', pids.join(','), '-Fpn']);
  let pid = null;
  for (const line of out.split('\n')) {
    if (line[0] === 'p') pid = +line.slice(1);
    else if (line[0] === 'n' && pid) cwds.set(pid, line.slice(1));
  }
  return cwds;
}

async function readListeners() {
  const out = await run('lsof', ['-nP', '-iTCP', '-sTCP:LISTEN', '-Fpn']);
  const ports = new Map();
  let pid = null;
  for (const line of out.split('\n')) {
    if (line[0] === 'p') pid = +line.slice(1);
    else if (line[0] === 'n' && pid) {
      const port = +line.slice(line.lastIndexOf(':') + 1);
      if (port) { if (!ports.has(pid)) ports.set(pid, new Set()); ports.get(pid).add(port); }
    }
  }
  return ports;
}

// "Used" the way Activity Monitor counts it: app memory + wired + compressed. top's PhysMem "used" also counts
// cached files macOS drops the moment anything needs the room, so it sits near the total on every Mac.
async function readVm(sys) {
  const v = await run('vm_stat', []), ps = +((v.match(/page size of (\d+)/) || [])[1] || 16384), g = (k) => +((v.match(new RegExp(k + ':\\s+(\\d+)')) || [])[1] || 0) * ps / 1048576;
  const anon = g('Anonymous pages'), purge = g('Pages purgeable'), wired = g('Pages wired down'), comp = g('Pages occupied by compressor'), file = g('File-backed pages');
  if (!anon) return; // vm_stat unreadable: keep top's numbers
  Object.assign(sys, { appMB: Math.max(0, anon - purge), wiredMB: wired, compressorMB: comp, cachedMB: file + purge, usedMB: Math.max(0, anon - purge) + wired + comp });
}
async function readTop() {
  const out = await run('top', ['-l', '1', '-o', 'mem', '-n', '150', '-stats', 'pid,mem']);
  const foot = new Map();
  const sys = { cpuUser: 0, cpuSys: 0, usedMB: 0, wiredMB: 0, compressorMB: 0 };
  for (const line of out.split('\n')) {
    let m;
    if ((m = line.match(/CPU usage:\s*([\d.]+)% user,\s*([\d.]+)% sys/))) { sys.cpuUser = +m[1]; sys.cpuSys = +m[2]; }
    else if ((m = line.match(/PhysMem:\s*(\S+) used \((\S+) wired(?:, (\S+) compressor)?/))) {
      sys.usedMB = parseMem(m[1]); sys.wiredMB = parseMem(m[2]); sys.compressorMB = parseMem(m[3] || '0M');
    } else if ((m = line.match(/^\s*(\d+)\s+(\d[\d.]*[BKMG])/))) foot.set(+m[1], parseMem(m[2]));
  }
  await readVm(sys).catch(() => {});
  return { foot, sys };
}

async function readSwapAndPressure() {
  const [swap, level] = await Promise.all([run('sysctl', ['-n', 'vm.swapusage']), run('sysctl', ['-n', 'kern.memorystatus_level'])]);
  const m = swap.match(/total = ([\d.]+)M\s+used = ([\d.]+)M/);
  return { swapTotalMB: m ? +m[1] : 0, swapUsedMB: m ? +m[2] : 0, freePct: +level.trim() || 0 };
}

const tabNames = new Map(), TABSEEN = new Map(); // tty -> { name, since }: when a hand-set tab name last changed
// The name shown for a session: whichever was set last, a name you gave it in pebtree or one you typed on its iTerm tab.
// c: { id: '<host>:<pid>', tabName, tabSince, name (one Claude Code was given with /rename or -n) }
function pickTitle(c, title) {
  if (!c) return { title: cleanTitle(title), customTitle: false, tabNamed: false };
  const ct = customTitles[c.id], ctName = typeof ct === 'string' ? ct : ct && ct.name, ctAt = ct && typeof ct === 'object' ? ct.at : 0;
  const tab = c.tabName, tabSince = c.tabSince || 0;
  if (ctName && (!tab || ctAt >= tabSince)) return { title: ctName, customTitle: true, tabNamed: false };
  if (tab) return { title: tab, customTitle: !!ctName, tabNamed: true };
  return { title: ctName || cleanTitle(title) || c.name || '', customTitle: !!ctName, tabNamed: false };
}
let lastTitles = new Map();
async function readItermTitles() {
  const script = `if application "iTerm2" is running then
  tell application "iTerm2"
    set out to ""
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          try
            set tabTitle to ""
            -- not every iTerm version has a tab title; without this the whole row was dropped
            try
              set tabTitle to (title of t)
            end try
            set out to out & (tty of s) & (ASCII character 9) & (name of s) & (ASCII character 9) & tabTitle & linefeed
          end try
        end repeat
      end repeat
    end repeat
    return out
  end tell
end if`;
  const out = await run('osascript', ['-e', script]);
  // A read that fails (iTerm busy, or a tab closing mid-read) would make every session look idle for a cycle
  // and empty the feed; keep the last good read instead.
  if (!out.trim()) return lastTitles;
  const titles = new Map();
  tabNames.clear();
  for (const line of out.split('\n')) {
    const [tty, title, tabTitle] = line.split('\t');
    if (tty && title !== undefined) titles.set(tty.replace('/dev/', ''), title.trim());
    // a tab you named by hand shows its own title; Claude's title only shows when you haven't
    if (tty && tabTitle && cleanTitle(tabTitle) && cleanTitle(tabTitle) !== cleanTitle(title)) { const k = tty.replace('/dev/', ''), v = tabTitle.trim(), seen = TABSEEN.get(k); tabNames.set(k, v); if (!seen || seen.name !== v) TABSEEN.set(k, { name: v, since: seen ? Date.now() : 0 }); }
  }
  lastTitles = titles;
  return titles;
}

function claudeStateFromTitle(title) {
  if (!title) return 'unknown';
  const c = title.codePointAt(0);
  if (title.startsWith('✳')) return 'waiting';
  if ((c >= 0x2800 && c <= 0x28ff) || '\u25D0\u25D1\u25D2\u25D3'.includes(title[0])) return 'working';
  return 'unknown';
}
function cleanTitle(title) {
  return (title || '').replace(/^[✳⠀-⣿◐-◓]\s*/, '').replace(/\s*\((node|claude|zsh|-zsh|bash|python|ssh|tmux)\)\s*$/, '').trim();
}

// Groups attributed processes into services: a service is the topmost ancestor chain in the
// same tree with the same kind (npm exec -> next dev -> next-server, jest -> jest workers).
// MCP servers fold into the Claude session that launched them.
function buildServices(procs, cwds, listeners, foot) {
  const attributed = new Map();
  for (const p of procs.values()) {
    const kind = kindOf(p.args, p.comm);
    if (!kind || p.pid === process.pid) continue;
    const tree = treeOf(cwds.get(p.pid)) || treeOf((p.args.match(/\S*\/\.treehouse\/[^/\s]+\/\d+\/[^/\s]+/) || [])[0]);
    if (!tree) continue;
    attributed.set(p.pid, { ...p, kind, tree, memMB: foot.get(p.pid) ?? p.rssMB });
  }
  // Workers a dev server spawns (Metro's jest-worker transformers, Next's helpers) belong to that server.
  for (const p of attributed.values()) {
    if (!['jest', 'node', 'tsserver'].includes(p.kind)) continue;
    for (let a = attributed.get(p.ppid); a; a = attributed.get(a.ppid)) {
      if (a.tree !== p.tree) break;
      if (SERVER_KINDS.has(kindOf(a.args, a.comm))) { p.kind = kindOf(a.args, a.comm); break; }
      if (a.kind === 'claude') break;
    }
  }
  const rootOf = (p) => {
    let cur = p;
    for (;;) {
      const parent = attributed.get(cur.ppid);
      if (!parent || parent.tree !== p.tree || parent.kind !== p.kind) return cur;
      cur = parent;
    }
  };
  const services = new Map();
  for (const p of attributed.values()) {
    const root = rootOf(p);
    if (!services.has(root.pid)) {
      services.set(root.pid, { id: root.pid, tree: p.tree, kind: p.kind, rootPid: root.pid, ppid: root.ppid, tty: root.tty, args: root.args, age: root.age, pids: [], memMB: 0, cpu: 0, ports: [], mcpCount: 0 });
    }
    const s = services.get(root.pid);
    s.pids.push(p.pid); s.memMB += p.memMB; s.cpu += p.cpu;
    for (const port of listeners.get(p.pid) || []) if (!s.ports.includes(port)) s.ports.push(port);
  }
  // fold MCP servers into their Claude session
  for (const s of [...services.values()]) {
    if (s.kind !== 'mcp') continue;
    let a = attributed.get(s.ppid) || procs.get(s.ppid);
    while (a && a.kind !== 'claude' && kindOf(a.args, a.comm) !== 'claude') a = attributed.get(a.ppid) || procs.get(a.ppid);
    const owner = a && services.get(a.pid);
    if (owner) { owner.memMB += s.memMB; owner.cpu += s.cpu; owner.pids.push(...s.pids); owner.mcpCount += 1; services.delete(s.id); }
  }
  // ppid 1 alone is not enough: treehouse-dev detaches the servers it starts on purpose
  const treesWithClaude = new Set([...services.values()].filter((s) => s.kind === 'claude').map((s) => s.tree));
  for (const s of services.values()) {
    s.orphan = s.kind !== 'claude' && s.ppid === 1 && !treesWithClaude.has(s.tree);
    s.ports.sort((a, b) => a - b);
    s.label = labelFor(s);
    s.throttled = throttled.has(s.id);
  }
  return services;
}

function labelFor(s) {
  const port = s.ports.find((p) => p >= 3000 && p < 9000) || s.ports[0];
  switch (s.kind) {
    case 'claude': return 'Claude session';
    case 'next': return `Next dev server${port ? ` :${port}` : ''}`;
    case 'metro': return `Metro / Expo${port ? ` :${port}` : ''}`;
    case 'jest': return `Jest (${s.pids.length} process${s.pids.length === 1 ? '' : 'es'})`;
    case 'mcp': return 'MCP server';
    case 'tsserver': return 'TypeScript server';
    default: return s.args.split(/\s+/).slice(0, 3).map((a) => path.basename(a)).join(' ');
  }
}
function escapeRe(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

// ---------- hosts and terminals ----------
// Every host answers the same questions (AGENT_OPS below): this Mac in-process, every other one through
// `pebtree agent`, this same file run there over one long-lived ssh connection. A session lives in a tmux pane
// (addressed by pane id, on any host) or an iTerm2 tab (by tty, this Mac only).

const SAFE_NAME = /^[\w.@-]{1,80}$/; // tmux session names pebtree attaches to or kills
function runOk(cmd, args, opts = {}) {
  const { input, ...o } = opts;
  return new Promise((resolve) => {
    const c = execFile(cmd, args, { maxBuffer: 32 * 1024 * 1024, timeout: 20000, ...o }, (err, stdout, stderr) => resolve({ ok: !err, out: String(stdout || ''), err: err ? (String(stderr || '').trim() || err.message) : '' }));
    if (c.stdin) { c.stdin.on('error', () => {}); if (input != null) c.stdin.end(input); }
  });
}
const shq = (s) => `'${String(s).replace(/'/g, `'\\''`)}'`;

const TMUX_F = ['pane_id', 'pane_tty', 'pane_pid', 'session_name', 'window_index', 'session_attached', 'session_activity', 'pane_current_command', 'pane_current_path', 'pane_title', 'session_windows', 'window_active', 'pane_active'];
async function readTmuxPanes() {
  const r = await runOk('tmux', ['list-panes', '-a', '-F', TMUX_F.map((f) => `#{${f}}`).join('\t')], { timeout: 5000 });
  if (!r.ok) return []; // no tmux server running
  const panes = [];
  for (const line of r.out.split('\n')) {
    const v = line.split('\t');
    if (v.length < TMUX_F.length) continue;
    panes.push({ pane: v[0], tty: v[1].replace('/dev/', ''), pid: +v[2], session: v[3], window: +v[4], attached: +v[5], activity: +v[6] * 1000, cmd: v[7], cwd: v[8], title: v[9], windows: +v[10], active: v[11] === '1' && v[12] === '1' });
  }
  return panes;
}
// One row per tmux session for the Terminals page. A window linked into several sessions (the `codex` session
// holds a window of each tw-* one) counts in each, but its Claude belongs to the tw-* one.
function tmuxSessions(panes, claudePanes) {
  const by = new Map();
  for (const p of panes) {
    let s = by.get(p.session);
    if (!s) by.set(p.session, (s = { session: p.session, windows: p.windows, attached: p.attached, activity: p.activity, claude: 0, cmd: p.cmd, cwd: p.cwd, title: p.title }));
    if (claudePanes.get(p.pane) === p.session) s.claude++;
    if (p.active) Object.assign(s, { cmd: p.cmd, cwd: p.cwd, title: p.title });
  }
  return [...by.values()].sort((a, b) => b.activity - a.activity);
}

// treehouse keeps each pool's slots in ~/.treehouse/<pool>/treehouse-state.json: v3 marks a lease, v2 an owner pid.
function readPools() {
  const root = path.join(HOME, '.treehouse'), out = [];
  let dirs = []; try { dirs = fs.readdirSync(root, { withFileTypes: true }).filter((d) => d.isDirectory()).map((d) => d.name); } catch { return out; }
  const alive = (pid) => { try { process.kill(pid, 0); return true; } catch (e) { return e.code === 'EPERM'; } };
  for (const d of dirs) {
    const st = readJson(path.join(root, d, 'treehouse-state.json'), null);
    for (const w of (st && st.worktrees) || []) {
      if (!w || !w.path || !/^\d+$/.test(String(w.name))) continue;
      out.push({ pool: d, slot: String(w.name), path: w.path, repo: path.basename(w.path), status: w.leased ? 'leased' : w.owner_pid && alive(w.owner_pid) ? 'in-use' : 'available', holder: w.lease_holder || '' });
    }
  }
  return out;
}

const topCache = new Map(), gitCache = new Map();
async function gitTop(dir) {
  if (!dir) return '';
  const hit = topCache.get(dir);
  if (hit && Date.now() - hit.at < 300000) return hit.top;
  const top = (await run('git', ['-C', dir, 'rev-parse', '--show-toplevel'], { timeout: 5000 })).trim();
  topCache.set(dir, { top, at: Date.now() });
  return top;
}
// Branch, uncommitted files, commits ahead of the default branch, upstream and GitHub slug; re-read every 15s.
async function gitInfoCached(dir) {
  const hit = gitCache.get(dir);
  if (hit && Date.now() - hit.at < 15000) return hit.v;
  const base = (hit && hit.v.base) || (await run('git', ['-C', dir, 'symbolic-ref', '--short', 'refs/remotes/origin/HEAD'], { timeout: 5000 })).trim() || 'origin/master';
  const [branch, status, ahead, upstream, origin] = await Promise.all([
    run('git', ['-C', dir, 'branch', '--show-current']),
    run('git', ['-C', dir, 'status', '--porcelain']),
    run('git', ['-C', dir, 'rev-list', '--count', `${base}..HEAD`]),
    run('git', ['-C', dir, 'rev-parse', '--abbrev-ref', '--symbolic-full-name', '@{u}']),
    run('git', ['-C', dir, 'remote', 'get-url', 'origin']),
  ]);
  const v = { branch: branch.trim() || '(detached)', dirty: status.split('\n').filter(Boolean).length, ahead: +ahead.trim() || 0, upstream: upstream.trim(), base, slug: (origin.trim().match(/github[\w.-]*[:/]([\w.-]+\/[\w.-]+?)(\.git)?\/?$/) || [])[1] || '' };
  gitCache.set(dir, { v, at: Date.now() });
  return v;
}
const dropCache = new Map();
async function dropsCached(dir) {
  const hit = dropCache.get(dir);
  if (hit && Date.now() - hit.at < 15000) return hit.v;
  const v = dir ? await dropsFor(dir) : [];
  dropCache.set(dir, { v, at: Date.now() });
  return v;
}
function sysStats() {
  const s = { totalMB: os.totalmem() / 1048576, usedMB: (os.totalmem() - os.freemem()) / 1048576, load: os.loadavg(), cores: os.cpus().length };
  try { const mi = fs.readFileSync('/proc/meminfo', 'utf8'), g = (k) => +((mi.match(new RegExp('^' + k + ':\\s+(\\d+)', 'm')) || [])[1] || 0) / 1024; if (g('MemAvailable')) s.usedMB = g('MemTotal') - g('MemAvailable'); } catch { /* not Linux */ }
  return s;
}
function sessionFile(cwd, sessionId) {
  const f = path.join(HOME, '.claude/projects', cwd.replace(/[/.]/g, '-'), `${sessionId}.jsonl`);
  return fs.existsSync(f) ? f : null;
}

// Every interactive Claude Code session on this host, with its terminal, checkout, git state and transcript.
// pre: what the dashboard already read this cycle on its own Mac (processes, cwds, iTerm titles).
// known: pid -> transcript rev the caller already has; those transcripts are left out.
const CLAUDE_SKIP = /\bbg-(spare|pty-host)\b|\bdaemon\b|--chrome-native-host|(^|\s)(-p|--print)(\s|$)/;
async function scanHost(pre = {}) {
  const procs = pre.procs || await readProcesses();
  const claudes = [...procs.values()].filter((p) => p.tty && kindOf(p.args, p.comm) === 'claude' && !CLAUDE_SKIP.test(p.args));
  const [cwds, panes, titles] = await Promise.all([pre.cwds || readCwds(claudes.map((p) => p.pid)), readTmuxPanes(), pre.titles || (process.platform === 'darwin' ? readItermTitles() : new Map())]);
  // a pane shown in several sessions (linked windows) is addressed through its own tw-* session
  const rank = (p) => (/^(tw|cl|cx|sh)-/.test(p.session) ? 0 : 1000) + p.windows;
  const byTty = new Map();
  for (const p of panes) { const cur = byTty.get(p.tty); if (!cur || rank(p) < rank(cur)) byTty.set(p.tty, p); }
  const known = pre.known || {};
  const sessions = (await Promise.all(claudes.map(async (p) => {
    const rec = readJson(path.join(HOME, '.claude/sessions', `${p.pid}.json`), null);
    if (rec && rec.kind && rec.kind !== 'interactive') return null;
    if (procs.get(p.ppid) && kindOf(procs.get(p.ppid).args, procs.get(p.ppid).comm) === 'claude') return null; // a claude another one runs
    const cwd = (rec && rec.cwd) || cwds.get(p.pid) || '';
    if (!cwd) return null;
    const pane = byTty.get(p.tty), iterm = !pane && titles.has(p.tty);
    const top = await gitTop(cwd), git = top ? await gitInfoCached(top) : null;
    const tfile = rec && rec.sessionId ? sessionFile(cwd, rec.sessionId) : null;
    const tr = transcriptInfoCached(cwd, tfile, git && git.slug);
    const m = cwd.match(POOL_RE);
    const s = {
      pid: p.pid, cwd, top, tty: p.tty, args: p.args, memMB: p.rssMB, cpu: p.cpu, age: p.age,
      status: (rec && rec.status) || '', name: rec && rec.nameSource !== 'derived' ? rec.name || '' : '',
      term: pane ? 'tmux' : iterm ? 'iterm' : '', pane: pane ? pane.pane : '', session: pane ? pane.session : '', attached: pane ? pane.attached : 0,
      title: pane ? pane.title : iterm ? titles.get(p.tty) : '', tabName: iterm ? tabNames.get(p.tty) || '' : '', tabSince: iterm ? (TABSEEN.get(p.tty) || {}).since || 0 : 0,
      pool: m ? { pool: m[1], slot: m[2], repo: m[3] } : null, git, transcriptFile: tfile, subagents: subagentsFor(tfile || (tr && tr.file)), drops: await dropsCached(top || cwd),
    };
    if (tr && known[p.pid] === tr.rev) s.trRev = tr.rev; else s.transcript = tr;
    return s;
  }))).filter(Boolean);
  // A leased slot with no Claude in it is where you were when ssh dropped or Claude exited: say what was going on there,
  // and whether a tmux session still holds it, so it can be picked up again (or handed back).
  const pools = readPools(), inside = (p, dir) => p === dir || p.startsWith(dir + '/');
  await Promise.all(pools.map(async (w) => {
    if (w.status === 'available' || !fs.existsSync(w.path)) return;
    w.git = await gitInfoCached(w.path);
    w.claude = sessions.some((s) => inside(s.cwd, w.path));
    const pane = panes.find((p) => inside(p.cwd, w.path));
    w.tmux = pane ? pane.session : '';
    if (!w.claude) { const tr = transcriptInfoCached(w.path, null, w.git.slug); if (tr) w.last = { at: tr.lastActive, say: String(tr.lastSay || '').slice(-600), you: tr.lastUser || '' }; }
  }));
  const claudePanes = new Map(sessions.filter((s) => s.pane).map((s) => [s.pane, s.session]));
  return { host: os.hostname(), platform: process.platform, home: HOME, at: Date.now(), sessions, terms: tmuxSessions(panes, claudePanes), pools, sys: sysStats() };
}

// ---- talking to a session's terminal, whichever kind it is: { term: 'tmux', pane } or { term: 'iterm', tty }
async function screensOf(targets) {
  const out = {}, it = targets.filter((t) => t && t.term === 'iterm').map((t) => t.tty);
  const [im] = await Promise.all([it.length ? readScreens(it) : new Map(),
    ...targets.filter((t) => t && t.term === 'tmux').map(async (t) => { const r = await runOk('tmux', ['capture-pane', '-p', '-t', t.pane], { timeout: 4000 }); if (r.ok) out[t.pane] = r.out; })]);
  for (const [k, v] of im) out[k] = v;
  return out;
}
async function keysTo(t, keys) {
  if (t.term === 'iterm') return typeKeys(t.tty, keys);
  if (t.term !== 'tmux') return '';
  for (const k of keys) {
    const r = await runOk('tmux', k.cr ? ['send-keys', '-t', t.pane, 'Enter'] : ['send-keys', '-t', t.pane, '-l', '--', String(k.text || '')], { timeout: 4000 });
    if (!r.ok) return '';
    await sleep((k.wait || 0.35) * 1000);
  }
  return 'ok';
}
// A bracketed paste (as iTerm's write text is), so newlines stay inside the message; then Enter on its own sends it.
async function writeTo(t, text) {
  if (t.term === 'iterm') return writeToTty(t.tty, text);
  if (t.term !== 'tmux') return '';
  const buf = `pebtree-${process.pid}`;
  if (!(await runOk('tmux', ['load-buffer', '-b', buf, '-'], { timeout: 4000, input: text })).ok) return '';
  if (!(await runOk('tmux', ['paste-buffer', '-p', '-r', '-d', '-b', buf, '-t', t.pane], { timeout: 4000 })).ok) return '';
  await sleep(150);
  return (await runOk('tmux', ['send-keys', '-t', t.pane, 'Enter'], { timeout: 4000 })).ok ? 'ok' : '';
}

// ---- starting sessions (what `tw`, `cx` and `hx` used to do), each in its own detached tmux session:
//   tree    Claude in a fresh treehouse worktree of a repo; the worktree goes back to the pool when Claude exits
//           or the session is killed (the same contract as tw: treehouse keeps it leased if it has changes)
//   claude  Claude in a checkout or folder;  codex  Codex there;  shell  a shell, or `cmd`, in tmux session `session`
const LAUNCH_DIR = path.join(HOME, '.local/share/pebtree/launch');
async function spawnSession(spec) {
  const kind = String(spec.kind || ''), at = tilde(String(spec.repo || spec.cwd || '~'));
  if (!['tree', 'resume', 'claude', 'codex', 'shell'].includes(kind)) return { ok: false, error: `unknown kind ${kind}` };
  if (!fs.existsSync(at)) return { ok: false, error: `${at} does not exist on ${os.hostname()}` };
  const rand = crypto.randomBytes(2).toString('hex'), slug = (p) => path.basename(p).replace(/[^\w.-]+/g, '-').slice(0, 30) || 'home';
  fs.mkdirSync(LAUNCH_DIR, { recursive: true });
  let prompt = '';
  if (String(spec.prompt || '').trim()) { const pf = path.join(LAUNCH_DIR, `${Date.now()}-${rand}.md`); fs.writeFileSync(pf, String(spec.prompt)); prompt = ` "$(cat ${shq(pf)})"`; }
  // a prompt written by someone else (a ticket) gets none of config.json's flags, only Claude's default permission prompts
  const args = spec.untrusted ? ['--permission-mode', 'default'] : CLAUDE_ARGS;
  const claude = ['claude', ...args, ...(spec.title ? ['-n', String(spec.title).slice(0, 50)] : [])].map(shq).join(' ') + prompt;
  const shell = 'exec "${SHELL:-/bin/sh}" -l';
  const has = async (n) => (await runOk('tmux', ['has-session', '-t', `=${n}`], { timeout: 4000 })).ok;
  let cwd = at, name, lines, treePath = '', tree = '';
  const pm = at.match(POOL_RE);
  if (kind === 'resume' && pm) {
    // back into a worktree you already hold: its own tmux session if one is left, else Claude picks up its last conversation
    const left = (await readTmuxPanes()).find((p) => p.cwd === at || p.cwd.startsWith(at + '/'));
    if (left) return { ok: true, session: left.session, path: at, tree: pm[2], existed: true };
    treePath = at; tree = pm[2]; name = `tw-${pm[3]}-${tree}`;
    // --continue with no earlier conversation exits at once (and the worktree would go straight back): start fresh then
    let had = false; try { had = fs.readdirSync(path.join(HOME, '.claude/projects', at.replace(/[/.]/g, '-'))).some((f) => f.endsWith('.jsonl')); } catch { /* none */ }
    lines = [`tw_path=${shq(treePath)}`, `trap 'treehouse return "$tw_path" </dev/null >/dev/null 2>&1; exit 129' HUP`, claude.replace(prompt, '') + (had ? " '--continue'" : ''),
      `echo; echo 'Claude exited. Returning this worktree to the pool...'`, `treehouse return "$tw_path" || { echo "Kept it. Return it later with: treehouse return $tw_path"; ${shell}; }`];
    treePath = ''; // it was leased before this; a failed start must not hand it back
  } else if (kind === 'resume') { name = `cl-${slug(at)}-${rand}`; lines = [claude + " '--continue'", shell]; }
  else if (kind === 'tree') {
    const top = await gitTop(at);
    if (!top) return { ok: false, error: `${at} is not a git checkout` };
    const r = await runOk('treehouse', ['get', '--lease', '--lease-holder', `tmux:${os.userInfo().username}`], { cwd: top, timeout: 600000 });
    treePath = r.out.trim().split('\n').pop() || '';
    if (!treePath || !fs.existsSync(treePath)) return { ok: false, error: `treehouse gave no worktree: ${(r.err || r.out).trim().split('\n').pop() || 'no output'}` };
    cwd = treePath; tree = path.basename(path.dirname(treePath));
    name = `tw-${slug(top)}-${tree}`;
    lines = [`tw_path=${shq(treePath)}`, `trap 'treehouse return "$tw_path" </dev/null >/dev/null 2>&1; exit 129' HUP`, claude,
      `echo; echo 'Claude exited. Returning this worktree to the pool...'`, `treehouse return "$tw_path" || { echo "Kept it. Return it later with: treehouse return $tw_path"; ${shell}; }`];
  } else if (kind === 'claude') { name = `cl-${slug(at)}-${rand}`; lines = [claude, shell]; }
  else if (kind === 'codex') { name = `cx-${slug(at)}-${rand}`; lines = ['codex' + prompt, shell]; }
  else {
    name = spec.session && SAFE_NAME.test(spec.session) ? spec.session : `sh-${slug(at)}-${rand}`;
    if (await has(name)) return { ok: true, session: name, path: at, existed: true }; // like tmux new-session -A
    lines = [spec.cmd ? 'exec ' + String(spec.cmd).replace(/^~(?=\/)/, '"$HOME"') : shell];
  }
  if (await has(name)) name += `-${rand}`;
  const script = path.join(LAUNCH_DIR, `${name}.sh`);
  fs.writeFileSync(script, ['#!/bin/sh', `# started by pebtree ${new Date().toISOString()}`, `export PATH=${shq(process.env.PATH)}`, `cd ${shq(cwd)} || exit 1`, ...lines, ''].join('\n'), { mode: 0o755 });
  const r = await runOk('tmux', ['new-session', '-d', '-s', name, '-n', name.slice(0, 40), '-x', '200', '-y', '50', '-c', cwd, `/bin/sh ${shq(script)}`], { timeout: 8000 });
  if (!r.ok) { if (treePath) await runOk('treehouse', ['return', treePath], { cwd: treePath, timeout: 60000 }); return { ok: false, error: `tmux: ${r.err}` }; }
  return { ok: true, session: name, path: cwd, tree };
}

// Ends a tmux session the way `tw --close` does: its Claude can take a minute to act on the hangup, so it is
// stopped too. Windows linked into other sessions survive kill-session, and so does their Claude.
async function killTerm({ session }) {
  if (!SAFE_NAME.test(session || '')) return { ok: false, error: 'bad session name' };
  const panes = await readTmuxPanes(), mine = panes.filter((p) => p.session === session);
  if (!mine.length) return { ok: false, error: `no tmux session ${session}` };
  const ttys = new Set(mine.filter((p) => !panes.some((q) => q.pane === p.pane && q.session !== session)).map((p) => p.tty));
  const claudes = [...(await readProcesses()).values()].filter((p) => ttys.has(p.tty) && kindOf(p.args, p.comm) === 'claude').map((p) => p.pid);
  const r = await runOk('tmux', ['kill-session', '-t', `=${session}`], { timeout: 8000 });
  for (const pid of claudes) try { process.kill(pid, 'SIGTERM'); } catch { /* gone */ }
  setTimeout(() => { for (const pid of claudes) try { process.kill(pid, 'SIGKILL'); } catch { /* gone */ } }, 5000).unref();
  return r.ok ? { ok: true, stopped: claudes.length } : { ok: false, error: r.err };
}

// What closing a session's tree would lose, and closing it: end its terminal, then hand a pool worktree back.
async function closeInfo({ path: p }) {
  if (!p || !fs.existsSync(p)) return { ok: false, error: `${p} is gone` };
  const g = await gitInfoCached(p), porcelain = await run('git', ['-C', p, 'status', '--porcelain']);
  return { ok: true, path: p, branch: g.branch, ahead: g.ahead, base: g.base, pool: POOL_RE.test(p), changes: porcelain.split('\n').filter(Boolean).map((l) => l.slice(3)).filter((f) => !/(^|\/)node_modules\//.test(f)) };
}
async function closeSession({ path: p, term, pane, session, tty, discard }) {
  const info = await closeInfo({ path: p });
  if (!info.ok) return info;
  if (info.changes.length && !discard) return { ok: false, error: `${info.changes.length} uncommitted change(s) would be discarded` };
  let closedTab = false;
  if (term === 'tmux' && session) {
    // a window of a bigger session (the codex one) closes alone; a session of its own ends whole
    const panes = (await readTmuxPanes()).filter((x) => x.session === session);
    if (panes.length && panes[0].windows > 1 && !/^(tw|cl|cx)-/.test(session)) { await runOk('tmux', ['kill-pane', '-t', pane]); closedTab = true; }
    else closedTab = (await killTerm({ session })).ok;
  } else if (term === 'iterm' && tty) {
    const out = await run('osascript', ['-e', 'on run argv', '-e', 'tell application "iTerm2"', '-e', 'repeat with w in windows', '-e', 'repeat with t in tabs of w', '-e', 'repeat with s in sessions of t',
      '-e', 'if tty of s is ("/dev/" & item 1 of argv) then', '-e', 'close s', '-e', 'return "closed"', '-e', 'end if', '-e', 'end repeat', '-e', 'end repeat', '-e', 'end repeat', '-e', 'end tell', '-e', 'end run', tty]);
    closedTab = out.trim() === 'closed' || out.trim() === '';
  }
  let returned = '';
  if (info.pool) {
    await sleep(1500); // the window's own hangup trap returns it first when it can
    const r = await runOk('treehouse', ['return', p, '--force'], { cwd: p, timeout: 60000 });
    returned = (r.out || r.err).trim().split('\n').slice(-1)[0] || '';
  }
  return { ok: true, closedTab, branch: info.branch, ahead: info.ahead, returned };
}

// Files the dashboard copies into a remote tree (a drop, a pasted image) and images it shows from one.
const IMG_TYPES = { '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.gif': 'image/gif', '.webp': 'image/webp' };
function putFile({ path: p, b64 }) {
  const f = path.resolve(tilde(String(p || '')));
  if (!f.includes(`${path.sep}.pebtree-drops${path.sep}`)) return { ok: false, error: 'only into a tree\'s .pebtree-drops' };
  const root = f.slice(0, f.indexOf(`${path.sep}.pebtree-drops${path.sep}`) + 15);
  fs.mkdirSync(path.dirname(f), { recursive: true });
  if (!fs.existsSync(path.join(root, '.gitignore'))) fs.writeFileSync(path.join(root, '.gitignore'), '*\n');
  fs.writeFileSync(f, Buffer.from(String(b64 || ''), 'base64'));
  dropCache.clear();
  return { ok: true, path: f };
}
function getFile({ path: p }) {
  let f; try { f = fs.realpathSync(tilde(String(p || ''))); } catch { return { ok: false, error: 'not found' }; }
  const roots = [HOME, '/tmp', '/private/tmp'].map((r) => { try { return fs.realpathSync(r); } catch { return r; } });
  if (!IMG_TYPES[path.extname(f).toLowerCase()] || !roots.some((r) => f.startsWith(r + path.sep))) return { ok: false, error: 'not an image in an allowed folder' };
  const st = fs.statSync(f);
  if (!st.isFile() || st.size > 25 * 1024 * 1024) return { ok: false, error: 'not found' };
  return { ok: true, type: IMG_TYPES[path.extname(f).toLowerCase()], b64: fs.readFileSync(f).toString('base64') };
}
function deleteDropsAt({ path: p, id }) {
  const root = path.join(String(p || ''), '.pebtree-drops');
  if (id !== 'all' && !/^[\w-]{3,60}$/.test(id)) return { ok: false, error: 'bad drop' };
  const targets = id === 'all' ? (fs.existsSync(root) ? fs.readdirSync(root).filter((n) => n !== '.gitignore').map((n) => path.join(root, n)) : []) : [path.join(root, id)];
  for (const d of targets) if (d.startsWith(root + path.sep)) fs.rmSync(d, { recursive: true, force: true });
  dropCache.clear();
  return { ok: true };
}
// Git checkouts a new session can start in: the folders right under each root (worktrees, whose .git is a file,
// are left out), most recently used first; `pool` when treehouse already has a pool of worktrees for it.
function listRepos(roots) {
  const out = new Map(), pooled = new Set(readPools().map((w) => w.repo));
  const dflt = process.platform === 'darwin' ? ['~', '~/Developer', '~/src', '~/code', '~/projects'] : ['~/workspace', '~'];
  for (const r of (Array.isArray(roots) && roots.length ? roots : dflt).map(tilde)) {
    let ents = []; try { ents = fs.readdirSync(r, { withFileTypes: true }); } catch { continue; }
    for (const e of ents) {
      if (!e.isDirectory() || e.name.startsWith('.')) continue;
      const p = path.join(r, e.name), g = path.join(p, '.git');
      let st; try { st = fs.statSync(g); } catch { continue; }
      if (!st.isDirectory()) continue;
      let at = st.mtimeMs; try { at = Math.max(at, fs.statSync(path.join(g, 'index')).mtimeMs); } catch { /* no index yet */ }
      out.set(p, { path: p, name: e.name, at: Math.round(at), pool: pooled.has(e.name) });
    }
  }
  return [...out.values()].sort((a, b) => b.at - a.at);
}

const AGENT_OPS = {
  hello: async () => ({ host: os.hostname(), platform: process.platform, home: HOME, node: process.versions.node }),
  scan: (a) => scanHost({ known: a.known }),
  screens: (a) => screensOf(a.targets || []),
  keys: (a) => keysTo(a.target || {}, a.keys || []),
  write: (a) => writeTo(a.target || {}, String(a.text || '')),
  transcript: (a) => transcriptInfo(String(a.dir || ''), a.file || null, a.slug || ''),
  chat: (a) => chatHistory(String(a.dir || ''), Math.min(300, +a.limit || 60), a.file || null, { side: !!a.side }),
  skills: (a) => listSkills(a.path || ''),
  repos: (a) => listRepos(a.roots),
  spawn: (a) => spawnSession(a),
  kill: (a) => killTerm(a),
  closeInfo: (a) => closeInfo(a),
  close: (a) => closeSession(a),
  putFile: (a) => putFile(a),
  getFile: (a) => getFile(a),
  deleteDrops: (a) => deleteDropsAt(a),
};
// `pebtree agent`: one JSON request per line on stdin ({ id, op, args }), one answer per line on stdout.
function agentMain() {
  const rl = require('readline').createInterface({ input: process.stdin, crlfDelay: Infinity });
  const out = (o) => process.stdout.write(JSON.stringify(o) + '\n');
  let busy = 0, closed = false;
  const done = () => { if (closed && !busy) process.stdout.write('', () => process.exit(0)); };
  rl.on('line', async (line) => {
    let m; try { m = JSON.parse(line); } catch { return; }
    const fn = AGENT_OPS[m.op];
    busy++;
    try { if (!fn) throw new Error(`unknown op ${m.op}`); out({ id: m.id, ok: true, result: await fn(m.args || {}) }); }
    catch (e) { out({ id: m.id, ok: false, error: String((e && e.message) || e) }); }
    busy--; done();
  });
  // the dashboard went away (ssh dropped): finish what is running, then exit
  rl.on('close', () => { closed = true; done(); });
}

// ---- the hosts the dashboard follows: this Mac, plus config.json "hosts": { "<id>": { "ssh": "<ssh host>", "label", "repoRoots" } }.
// The agent is this same file, copied to ~/.local/share/pebtree on the host whenever it changes.
const SELF_SHA = crypto.createHash('sha1').update(fs.readFileSync(__filename)).digest('hex').slice(0, 12);
const HOSTS = new Map();
const sshOpts = ['-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', '-o', 'ServerAliveInterval=15', '-o', 'ServerAliveCountMax=3', '-o', 'RemoteCommand=none'];
function makeHost(id, conf) {
  const h = { id, label: conf.label || (conf.ssh ? id : 'Mac'), local: !conf.ssh, ssh: conf.ssh || '', roots: conf.repoRoots || null, up: !conf.ssh, error: '', scan: null, repos: [], reposAt: 0, revs: {}, home: conf.ssh ? '' : HOME, seq: 0, pending: new Map(), child: null, retry: 0 };
  h.call = (op, args, ms) => (h.local ? Promise.resolve().then(() => AGENT_OPS[op](args || {})) : remoteCall(h, op, args, ms));
  return h;
}
for (const [id, conf] of Object.entries({ [LOCAL_HOST]: {}, ...(CONFIG.hosts || {}) })) if (/^[\w.-]+$/.test(id)) HOSTS.set(id, makeHost(id, conf || {}));
const localHost = () => HOSTS.get(LOCAL_HOST);
function remoteCall(h, op, args, ms = 20000) {
  return new Promise((resolve, reject) => {
    if (!h.child || !h.up) return reject(new Error(`${h.label} is not connected${h.error ? ` (${h.error})` : ''}`));
    const id = ++h.seq, timer = setTimeout(() => { h.pending.delete(id); reject(new Error(`${h.label} took too long to answer (${op})`)); }, ms);
    h.pending.set(id, { resolve, reject, timer });
    h.child.stdin.write(JSON.stringify({ id, op, args: args || {} }) + '\n');
  });
}
async function connectHost(h) {
  h.error = 'connecting';
  const have = await runOk('ssh', [...sshOpts, h.ssh, 'cat ~/.local/share/pebtree/sha 2>/dev/null; echo'], { timeout: 25000 });
  if (!have.ok) { h.error = (have.err.trim().split('\n').pop() || 'ssh failed').slice(0, 200); return false; }
  if (have.out.trim() !== SELF_SHA) {
    const put = await runOk('ssh', [...sshOpts, h.ssh, `mkdir -p ~/.local/share/pebtree && cat > ~/.local/share/pebtree/pebtree.tmp && chmod +x ~/.local/share/pebtree/pebtree.tmp && mv ~/.local/share/pebtree/pebtree.tmp ~/.local/share/pebtree/pebtree && printf %s ${SELF_SHA} > ~/.local/share/pebtree/sha`], { timeout: 60000, input: fs.readFileSync(__filename) });
    if (!put.ok) { h.error = `could not install the agent: ${put.err.slice(0, 160)}`; return false; }
  }
  const child = spawn('ssh', [...sshOpts, '-T', h.ssh, 'exec env PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:$PATH" node ~/.local/share/pebtree/pebtree agent'], { stdio: ['pipe', 'pipe', 'pipe'] });
  let buf = '', errTail = '';
  child.stdout.on('data', (d) => {
    buf += d;
    for (let i; (i = buf.indexOf('\n')) >= 0;) {
      const line = buf.slice(0, i); buf = buf.slice(i + 1);
      let m; try { m = JSON.parse(line); } catch { continue; }
      const p = h.pending.get(m.id); if (!p) continue;
      h.pending.delete(m.id); clearTimeout(p.timer);
      if (m.ok) p.resolve(m.result); else p.reject(new Error(m.error));
    }
  });
  child.stderr.on('data', (d) => { errTail = (errTail + d).slice(-600); });
  child.stdin.on('error', () => {});
  child.on('exit', () => {
    if (h.child !== child) return;
    h.child = null; h.up = false; h.error = (errTail.trim().split('\n').pop() || 'disconnected').slice(0, 200);
    for (const p of h.pending.values()) { clearTimeout(p.timer); p.reject(new Error(`${h.label} disconnected`)); }
    h.pending.clear(); push({ type: 'state' });
  });
  h.child = child; h.up = true;
  try { const hi = await remoteCall(h, 'hello', {}, 20000); Object.assign(h, { home: hi.home, error: '', retry: 0 }); }
  catch (e) { h.error = e.message; h.up = false; try { child.kill(); } catch { /* gone */ } return false; }
  return true;
}
// A host's last scan, with the transcripts it left out (unchanged since the one before) carried over.
function mergeScan(h, sc) {
  const prev = new Map(((h.scan && h.scan.sessions) || []).map((s) => [s.pid, s]));
  for (const s of sc.sessions) if (!s.transcript && s.trRev) s.transcript = (prev.get(s.pid) || {}).transcript || null;
  h.revs = Object.fromEntries(sc.sessions.filter((s) => s.transcript).map((s) => [s.pid, s.transcript.rev]));
  h.scan = sc; h.error = '';
}
async function refreshRepos(h) {
  if (Date.now() - h.reposAt < 120000) return;
  h.reposAt = Date.now();
  try { h.repos = await h.call('repos', { roots: h.roots }); } catch { h.reposAt = 0; }
}
async function hostLoop(h) {
  for (;;) {
    if (!h.up) {
      if (!(await connectHost(h).catch((e) => { h.error = e.message; return false; }))) { h.retry = Math.min(5, h.retry + 1); await sleep(1000 * 2 ** h.retry); continue; }
      push({ type: 'state' });
    }
    const t = Date.now();
    try { mergeScan(h, await h.call('scan', { known: h.revs }, 20000)); } catch (e) { h.error = e.message; }
    refreshRepos(h).catch(() => {});
    await sleep(Math.max(500, FAST_MS - (Date.now() - t)));
  }
}
function hostsState() {
  return [...HOSTS.values()].map((h) => ({ id: h.id, label: h.label, local: h.local, up: h.up, error: h.error, home: h.home, terms: (h.scan && h.scan.terms) || [], repos: h.repos, sys: h.scan && h.scan.sys, at: h.scan ? h.scan.at : 0 }));
}
// One-click starts on the Terminals page and in `pebtree new <id>`: config.json "presets", else one per host.
function presets() {
  if (Array.isArray(CONFIG.presets)) return CONFIG.presets.filter((p) => p && p.id && HOSTS.has(p.host || LOCAL_HOST)).map((p) => ({ ...p, host: p.host || LOCAL_HOST }));
  return [...HOSTS.values()].map((h) => ({ id: `${h.id}-shell`, label: `Shell on ${h.label}`, host: h.id, kind: 'shell', repo: '~' }));
}

// ---------- slow state: trees, git, transcripts, board ----------

let slow = { trees: new Map(), board: null, updated: 0 };

// messages that land in the transcript as "user" but were not typed by you
const notYou = (t) => /^Another Claude session sent a message|^<agent-message|^\[SYSTEM NOTIFICATION|^This session is being continued from a previous conversation/.test(t.trim());

// Re-reads a tree's transcript only when its newest file changed, so the feed text is never a cycle behind.
const transcriptCache = new Map();
const PENDING = new Map(); // tree -> messages sent from the dashboard that the transcript has not shown yet
const norm = (t) => String(t || '').replace(/\s+/g, ' ').trim().toLowerCase();
function pendingFor(tree, tr, claudeState) {
  const list = (PENDING.get(tree) || []).filter((p) => {
    if (Date.now() - p.at > 30 * 60000) return false;
    const head = norm(p.text).slice(0, 60);
    const lu = tr ? norm(tr.lastUser) : '';
    if (lu.length >= 8 && head.length >= 8 && (lu.includes(head.slice(0, 40)) || head.includes(lu.slice(0, 40)))) return false;
    if (tr && claudeState === 'waiting' && tr.lastActive > p.at + 1500) return false;
    if (menus.has(tree) && Date.now() - p.at > 1500) return false; // answered with a question or a permission prompt
    return true;
  });
  if (list.length) PENDING.set(tree, list); else PENDING.delete(tree);
  return list;
}
function transcriptInfoCached(dir, only, slug) {
  const proj = path.join(HOME, '.claude/projects', dir.replace(/[/.]/g, '-'));
  let key = only || '';
  try {
    if (only) { const st = fs.statSync(only); key += `:${st.mtimeMs}:${st.size}`; }
    else for (const f of fs.readdirSync(proj)) if (f.endsWith('.jsonl')) { const st = fs.statSync(path.join(proj, f)); key += `${f}:${st.mtimeMs}:${st.size};`; }
  } catch { return null; }
  const hit = transcriptCache.get(dir);
  if (hit && hit.key === key) return hit.info;
  const info = transcriptInfo(dir, only, slug);
  // rev: a short name for this read, so a host only sends a transcript to the dashboard when it changed
  if (info) info.rev = crypto.createHash('sha1').update(key).digest('hex').slice(0, 12);
  transcriptCache.set(dir, { key, info });
  return info;
}

// Claude Code writes a {"type":"pr-link"} record for every PR a session creates or links. Read each file
// once, then only what was appended, so a large transcript is not re-read on every change.
const prLinkCache = new Map();
// slug: owner/repo of the session's own GitHub origin. PR links to any other repo (a dependency, another service)
// carry numbers that mean nothing there.
const sameRepo = (a, slug) => !slug || !a || String(a).toLowerCase() === String(slug).toLowerCase();
function prLinks(file, slug) {
  let c = prLinkCache.get(file);
  try {
    const size = fs.statSync(file).size;
    if (!c || size < c.size) c = { size: 0, nums: [], rest: '' };
    if (size > c.size) {
      const fd = fs.openSync(file, 'r'), buf = Buffer.alloc(size - c.size);
      fs.readSync(fd, buf, 0, buf.length, c.size); fs.closeSync(fd);
      const text = c.rest + buf.toString('utf8'), lines = text.split('\n');
      c.rest = lines.pop();
      for (const l of lines) if (l.includes('"pr-link"')) { try { const j = JSON.parse(l); if (j.type === 'pr-link' && j.prNumber && sameRepo(j.prRepository, slug)) { c.nums = c.nums.filter((n) => n !== j.prNumber); c.nums.push(j.prNumber); } } catch { /* partial line */ } }
      c.size = size;
    }
    prLinkCache.set(file, c);
  } catch { return []; }
  return c.nums;
}

function transcriptInfo(dir, only, slug) {
  const proj = path.join(HOME, '.claude/projects', dir.replace(/[/.]/g, '-'));
  let files;
  try { files = only ? [{ f: path.basename(only), t: fs.statSync(only).mtimeMs }] : fs.readdirSync(proj).filter((f) => f.endsWith('.jsonl')).map((f) => ({ f, t: fs.statSync(path.join(proj, f)).mtimeMs })); } catch { return null; }
  if (!files.length) return null;
  files.sort((a, b) => b.t - a.t);
  const file = path.join(proj, files[0].f);
  const info = { lastActive: files[0].t, lastSay: '', lastUser: '', lastUserAt: 0, file };
  try {
    const size = fs.statSync(file).size;
    const fd = fs.openSync(file, 'r');
    const len = Math.min(size, 400000);
    const buf = Buffer.alloc(len);
    fs.readSync(fd, buf, 0, len, size - len);
    fs.closeSync(fd);
    const txt = buf.toString('utf8');
    // an AskUserQuestion with no tool_result yet is a question waiting in the terminal
    const asks = new Map();
    for (const l of txt.split('\n')) {
      if (!l.includes('AskUserQuestion') && !l.includes('tool_result')) continue;
      let j; try { j = JSON.parse(l); } catch { continue; }
      const c = j.message && Array.isArray(j.message.content) ? j.message.content : [];
      for (const b of c) {
        if (b.type === 'tool_use' && b.name === 'AskUserQuestion' && b.input && Array.isArray(b.input.questions)) asks.set(b.id, b.input.questions);
        if (b.type === 'tool_result' && asks.has(b.tool_use_id)) asks.delete(b.tool_use_id);
      }
    }
    const lastAsk = [...asks].pop();
    info.ask = lastAsk ? { id: lastAsk[0], questions: lastAsk[1].map((q) => ({ header: q.header || '', question: q.question || '', multiSelect: !!q.multiSelect, options: (q.options || []).map((o) => ({ label: o.label, description: o.description || '' })) })) } : null;
    // only PRs Claude itself wrote about in its replies; command output (a PR listing) would add unrelated ones
    // PRs this session made or talks about: links and "PR #123" in Claude's own words, plus the output of its own
    // `pr create` commands (never other command output: a `pr list` would link every PR in the repo)
    const said = [], creates = new Set(), PRLINK = /github\.com\/([\w.-]+\/[\w.-]+)\/pull\/(\d+)/g, mine = (r) => sameRepo(r, slug), PRREF = /\b(?:PR|pull request)\s*#(\d{3,6})\b/gi;
    for (const l of txt.split('\n')) {
      if (!l.includes('/pull/') && !/PR #|pull request #|pr create|pr ready/i.test(l)) continue;
      let j; try { j = JSON.parse(l); } catch { continue; }
      const c = j.message && Array.isArray(j.message.content) ? j.message.content : [];
      if (j.type === 'assistant') for (const b of c) {
        if (b.type === 'text') { for (const m of b.text.matchAll(PRLINK)) if (mine(m[1])) said.push(+m[2]); for (const m of b.text.matchAll(PRREF)) said.push(+m[1]); }
        else if (b.type === 'tool_use' && b.input && /\bpr (create|ready)\b/.test(String(b.input.command || ''))) creates.add(b.id);
      } else if (j.type === 'user') for (const b of c) if (b.type === 'tool_result' && creates.has(b.tool_use_id)) {
        const out = typeof b.content === 'string' ? b.content : Array.isArray(b.content) ? b.content.map((x) => x.text || '').join('\n') : '';
        for (const m of out.matchAll(PRLINK)) if (mine(m[1])) said.push(+m[2]);
      }
    }
    info.prNums = [...new Set([...prLinks(file, slug), ...said])].slice(-10);
    const lines = txt.split('\n');
    let lastTs = 0;
    for (let i = lines.length - 1; i >= 0 && (!info.lastSay || !info.lastUser || !lastTs); i--) {
      let j; try { j = JSON.parse(lines[i]); } catch { continue; }
      const c = j.message && j.message.content;
      if (!lastTs && (j.type === 'assistant' || j.type === 'user') && j.timestamp) lastTs = Date.parse(j.timestamp) || 0;
      if (!info.lastSay && j.type === 'assistant' && Array.isArray(c)) {
        const t = c.filter((x) => x.type === 'text').map((x) => x.text).join(' ').trim();
        if (t) info.lastSay = t.replace(/\n{3,}/g, '\n\n').trim().slice(0, 60000);
      }
      if (!info.lastUser && j.type === 'user' && typeof c === 'string' && !c.startsWith('<') && !notYou(c)) { info.lastUser = c.replace(/\s+/g, ' ').slice(0, 200); info.lastUserAt = Date.parse(j.timestamp) || 0; }
    }
    // the file's mtime moves on metadata writes too, so prefer the last real message
    if (lastTs) info.lastActive = lastTs;
  } catch { /* unreadable transcript: show mtime only */ }
  return info;
}

// Recent conversation for one tree: each of your messages, then Claude's final reply to it.
// opts.side: a subagent's own transcript (every line is a sidechain; its tool calls are shown as steps)
function chatHistory(dir, limit, only, opts = {}) {
  const proj = path.join(HOME, '.claude/projects', dir.replace(/[/.]/g, '-'));
  let file = only && fs.existsSync(only) ? only : null;
  if (!file) try {
    const files = fs.readdirSync(proj).filter((f) => f.endsWith('.jsonl')).map((f) => ({ f, t: fs.statSync(path.join(proj, f)).mtimeMs })).sort((a, b) => b.t - a.t);
    if (!files.length) return [];
    file = path.join(proj, files[0].f);
  } catch { return []; }
  const size = fs.statSync(file).size, len = Math.min(size, 8 * 1024 * 1024), buf = Buffer.alloc(len), fd = fs.openSync(file, 'r');
  fs.readSync(fd, buf, 0, len, size - len); fs.closeSync(fd);
  const strip = (t) => t.replace(/<system-reminder>[\s\S]*?<\/system-reminder>/g, '').trim();
  const items = [], asks = new Set();
  for (const line of buf.toString('utf8').split('\n')) {
    let j; try { j = JSON.parse(line); } catch { continue; }
    const c = j.message && j.message.content, at = Date.parse(j.timestamp) || 0;
    // questions asked with the question tool and the answers given (in the terminal or from here)
    const main = opts.side || !j.isSidechain;
    if (opts.side && j.type === 'assistant' && Array.isArray(c)) for (const b of c) if (b.type === 'tool_use' && !/Handback$/.test(b.name)) {
      const inp = b.input || {}, what = inp.description || (inp.command ? String(inp.command) : '') || (inp.file_path ? path.basename(inp.file_path) : '') || inp.pattern || inp.url || inp.query || '';
      items.push({ who: 'claude', kind: 'tool', at, text: b.name + (what ? ': ' + String(what).replace(/\s+/g, ' ').slice(0, 240) : '') });
    }
    if (j.type === 'assistant' && main && Array.isArray(c)) for (const b of c) if (b.type === 'tool_use' && b.name === 'AskUserQuestion' && b.input && Array.isArray(b.input.questions)) {
      asks.add(b.id);
      items.push({ who: 'claude', kind: 'ask', at, text: b.input.questions.map((q) => `**${q.header ? q.header + ' · ' : ''}${q.question}**\n` + (q.options || []).map((o) => `- ${o.label}`).join('\n')).join('\n\n') });
    }
    if (j.type === 'user' && Array.isArray(c) && c.some((b) => b.type === 'tool_result' && asks.has(b.tool_use_id))) {
      const ans = (j.toolUseResult && j.toolUseResult.answers) || {};
      const lines = Object.entries(ans).map(([q, a]) => `${q} → ${a}`);
      items.push({ who: 'you', kind: 'answer', at, text: lines.length ? lines.join('\n') : 'Answered the question' });
      continue;
    }
    if (j.type === 'user' && !j.isMeta && main && !j.isCompactSummary) {
      let t = typeof c === 'string' ? c : Array.isArray(c) && !c.some((x) => x.type === 'tool_result') ? c.filter((x) => x.type === 'text').map((x) => x.text).join('\n') : '';
      t = strip(t || '');
      if (t && !t.startsWith('<') && !notYou(t) && !/^\/[\w:-]+$/.test(t) && !t.startsWith('This session is being continued from a previous conversation')) items.push({ who: 'you', text: t.slice(0, 4000), at });
    } else if (j.type === 'assistant' && main && Array.isArray(c)) {
      const t = c.filter((x) => x.type === 'text').map((x) => x.text).join('\n').trim();
      if (!t) continue;
      const last = items[items.length - 1];
      // every text Claude wrote along the way is kept; all but the turn's last are marked 'mid' so the page can fade them
      if (last && last.who === 'claude' && !last.kind) last.kind = 'mid';
      items.push({ who: 'claude', text: t.slice(0, 60000), at });
    }
  }
  if (!opts.side && items.length && items[items.length - 1].who === 'claude' && !items[items.length - 1].kind) items.pop(); // already shown as the post
  return items.slice(-limit);
}

async function typeKeys(tty, keys) {
  const lines = ['on run argv', 'tell application "iTerm2"', 'repeat with w in windows', 'repeat with t in tabs of w', 'repeat with s in sessions of t', 'if tty of s is ("/dev/" & item 1 of argv) then'];
  keys.forEach((k, i) => { lines.push(k.cr ? 'tell s to write text (ASCII character 13) newline NO' : `tell s to write text (item ${i + 2} of argv) newline NO`); lines.push(`delay ${k.wait || 0.35}`); });
  lines.push('return "ok"', 'end if', 'end repeat', 'end repeat', 'end repeat', 'end tell', 'end run');
  return run('osascript', [...lines.flatMap((l) => ['-e', l]), tty, ...keys.map((k) => k.text || '')]);
}
// Reads a Claude Code numbered menu (question, permission prompt, review step) off a terminal screen.
function parseMenu(screen) {
  // a card drawn in a box has its rows inside │ … │; drop the borders so the rows parse like the plain menu
  const L = String(screen || '').split('\n').map((l) => l.replace(/\s*[│┃]\s*$/, '').replace(/^(\s*)[│┃]/, '$1 ').replace(/\s+$/, '')).slice(-90);
  let f = -1;
  // a permission card can sit above the input box (you can keep typing while it waits), with the spinner,
  // queued messages and the status line under it, so the footer is looked for well above the bottom; it only
  // counts with a selected option (❯ 1.) close above it
  for (let i = L.length - 1; i >= 0 && i >= L.length - 40; i--) if (/Esc to cancel|Enter to (select|confirm)|^\s*esc cancel\b/i.test(L[i]) && L.slice(Math.max(0, i - 25), i).some((l) => /^\s*❯\s*\d+\.\s/.test(l))) { f = i; break; }
  // the review step ("Ready to submit your answers?") has no footer: end the menu after its last line
  if (f < 0 && L.slice(-20).some((l) => /Ready to submit your answers\?/.test(l))) { f = L.length; while (f > 0 && (!L[f - 1].trim() || /^\s*[─━]{6,}/.test(L[f - 1]))) f--; }
  if (f < 0) return null;
  const opts = [], isRule = (l) => /^\s*[─━]{6,}/.test(l);
  let desc = [], i = f - 1, cursor = 0;
  for (; i >= 0; i--) {
    const l = L[i];
    if (!l.trim() || isRule(l)) { if (opts.length && !l.trim() && desc.length === 0) continue; if (isRule(l)) continue; continue; }
    const m = l.match(/^\s*(❯\s*)?(\d+)\.\s+(.+)$/);
    if (m) { opts.unshift({ n: +m[2], label: m[3].trim(), desc: desc.join(' ').trim() }); if (m[1]) cursor = +m[2]; desc = []; continue; }
    if (/^\s{3,}\S/.test(l) && !opts.length && false) continue;
    if (/^\s{3,}\S/.test(l)) { desc.unshift(l.trim()); continue; }
    break;
  }
  if (!opts.length) return null;
  // the question / prompt: the text block right above the options
  const title = [];
  for (; i >= 0 && title.length < 6; i--) { const l = L[i]; if (!l.trim()) { if (title.length) break; continue; } if (isRule(l) || /[☐☒]|✔ Submit/.test(l)) break; title.unshift(l.trim()); }
  // what is being asked about: the block above the question (a permission prompt's command or SQL, a tool's purpose)
  const context = [];
  for (let k = i; k >= 0 && context.length < 60; k--) {
    const l = L[k];
    if (/^\s*[╭╰]?─{6,}/.test(l) || /[☐☒]|✔ Submit/.test(l)) break;
    if (/^\s*╌{6,}/.test(l)) { if (context.length) context.unshift('—'); continue; }
    const t = l.replace(/^\s*[│┃]\s?/, '').replace(/\s+$/, '');
    if (/ctrl\+o to expand|^\s*\/permissions to let|overrides auto mode for this tool/.test(t)) continue;
    context.unshift(t);
  }
  while (context.length && !context[0].trim()) context.shift();
  while (context.length && !context[context.length - 1].trim()) context.pop();
  let tabs = null;
  for (let k = i; k >= 0 && k > i - 4; k--) if (/[☐☒]/.test(L[k] || '')) { tabs = [...L[k].matchAll(/([☐☒])\s+([^☐☒✔→]+?)(?=\s{2,}|\s*[☐☒✔→]|$)/g)].map((m) => ({ label: m[2].trim(), done: m[1] === '☒' })); break; }
  const options = opts.filter((o) => !/^Chat about this/.test(o.label)).map((o) => ({ ...o, free: /^Type something\.?$/.test(o.label) }));
  const kind = /Ready to submit your answers/.test(title.join(' ')) ? 'review' : /Do you want to|proceed\?/i.test(title.join(' ')) ? 'permission' : 'question';
  return { kind, title: title.join('\n'), context: context.join('\n').replace(/\n{3,}/g, '\n\n').slice(0, 6000), tabs, options, cursor, sig: title.join('|') + '#' + options.map((o) => o.label).join('|') };
}
// Menus are only on screen (Claude Code writes a question to the transcript after it is answered), so read
// every waiting session's screen in one AppleScript call and push changes.
const menus = new Map();
async function readScreens(ttys) {
  if (!ttys.length) return new Map();
  const out = await run('osascript', ['-e', 'on run argv', '-e', 'set out to ""', '-e', 'tell application "iTerm2"', '-e', 'repeat with w in windows', '-e', 'repeat with t in tabs of w', '-e', 'repeat with s in sessions of t',
    '-e', 'set tt to tty of s', '-e', 'if argv contains tt then set out to out & tt & (ASCII character 30) & (contents of s) & (ASCII character 31)', '-e', 'end repeat', '-e', 'end repeat', '-e', 'end repeat', '-e', 'end tell', '-e', 'return out', '-e', 'end run', ...ttys.map((t) => '/dev/' + t)], { timeout: 6000 });
  const m = new Map();
  for (const chunk of out.split('\x1f')) { const k = chunk.indexOf('\x1e'); if (k > 0) m.set(chunk.slice(0, k).replace('/dev/', '').trim(), chunk.slice(k + 1)); }
  return m;
}
// The text in a session's input box. Claude Code fills an empty box with a greyed-out suggested next prompt
// when a turn ends, and the plain screen text cannot show grey, so a draft counts as yours only if it appeared
// while Claude was not just finishing, or it changed after it appeared (you typing or editing).
const PROMPTS = new Map(), WORKED = new Map();
function promptDraft(screen) {
  const all = String(screen || '').split('\n');
  for (let k = all.length - 1; k >= 0 && k > all.length - 15; k--) { const pm = all[k].match(/^\s*[❯>]\s?(.*)$/); if (pm && /^\s*[─━]{8,}/.test(all[k - 1] || '')) return pm[1].replace(/\s+$/, ''); }
  return '';
}
// Claude Code's own grey hints that sit in an empty input box; they are never something you typed
const PROMPT_HINTS = /^(Press up to edit queued messages|Try ".*"|Type a message|\? for shortcuts)$/i;
function trackPrompt(x, screen) {
  const now = Date.now(), raw = promptDraft(screen), text = PROMPT_HINTS.test(raw.trim()) ? '' : raw, prev = PROMPTS.get(x.tree);
  if (x.claudeState === 'working') WORKED.set(x.tree, now);
  if (!text) { PROMPTS.set(x.tree, { text: '', typed: false }); return; }
  if (!prev) { PROMPTS.set(x.tree, { text, typed: false }); return; } // already there when pebtree started: unknown, assume a suggestion
  if (prev.text === text) return;
  const justFinished = now - (WORKED.get(x.tree) || 0) < 8000;
  PROMPTS.set(x.tree, { text, typed: prev.text ? true : !justFinished });
}
function typedDraft(tree, text) { const p = PROMPTS.get(tree); return p && p.typed && p.text === text ? text : ''; }
// a screen that looks like it is asking something but did not parse is kept, so a new Claude Code layout can be fixed from the real thing
const UNPARSED = new Map();
function keepUnparsed(tree, screen) {
  const tail = screen.split('\n').slice(-45).join('\n');
  if (!/Do you want to proceed\?|Esc to cancel|Enter to select/i.test(tail) || UNPARSED.get(tree) === tail) return;
  UNPARSED.set(tree, tail);
  try { fs.mkdirSync(path.join(CONF_DIR, 'unparsed'), { recursive: true }); fs.writeFileSync(path.join(CONF_DIR, 'unparsed', tree.replace(/[^\w.-]+/g, '_') + '.txt'), new Date().toISOString() + '\n' + tail); } catch {}
}
// The terminal a session runs in, as its host's agent addresses it.
function targetOf(x) { return x.term === 'tmux' ? { term: 'tmux', pane: x.pane, session: x.tmuxSession } : x.term === 'iterm' ? { term: 'iterm', tty: x.ttyName } : null; }
const sessionBy = (tree) => state && state.sessions.find((x) => x.tree === tree);
async function screenOf(sess) { const t = targetOf(sess); if (!t) return ''; const m = await hostOf(sess).call('screens', { targets: [t] }, 8000).catch(() => ({})); return m[t.pane || t.tty] || ''; }
const hostOf = (x) => HOSTS.get(x.host) || localHost();
async function refreshMenus(only) {
  if (!state) return;
  // every session, not only those whose title says waiting: with a question or permission prompt open the tab
  // title can keep Claude's working spinner, and that question would never be seen
  const ss = state.sessions.filter((x) => x.tty && (only ? x.tree === only : true));
  const byHost = new Map();
  for (const x of ss) { if (!byHost.has(x.host)) byHost.set(x.host, []); byHost.get(x.host).push(x); }
  await Promise.all([...byHost].map(async ([hid, list]) => {
    const h = HOSTS.get(hid);
    if (!h || !h.up) return;
    let screens; try { screens = await h.call('screens', { targets: list.map(targetOf) }, 8000); } catch { return; }
    for (const x of list) {
      const t = targetOf(x), screen = screens[t.pane || t.tty];
      if (screen === undefined) continue; // not read this time: keep what we had
      trackPrompt(x, screen);
      const pr = (PROMPTS.get(x.tree) || {}).text || '';
      if (x.prompt !== pr) { x.prompt = pr; push({ type: 'session', tree: x.tree, fields: { prompt: pr } }); }
      const menu = parseMenu(screen) || null, old = menus.get(x.tree) || null;
      if (!menu) keepUnparsed(x.tree, screen);
      if (menu) menus.set(x.tree, menu); else menus.delete(x.tree);
      x.menu = menu;
      if ((old && old.sig) !== (menu && menu.sig) || (old && JSON.stringify(old.tabs)) !== (menu && JSON.stringify(menu.tabs))) push({ type: 'session', tree: x.tree, fields: { menu } });
    }
  }));
}
async function pickMenu(tree, n, text, sig) {
  const sess = sessionBy(tree);
  if (!sess || !sess.tty) return { ok: false, error: 'no terminal for that session' };
  const menu = parseMenu(await screenOf(sess));
  if (!menu) return { ok: false, error: 'nothing is being asked in that tab any more' };
  if (sig && menu.sig !== sig) return { ok: false, error: 'the question changed; look again' };
  const opt = menu.options.find((o) => o.n === +n);
  if (!opt) return { ok: false, error: 'no such option' };
  const keys = [{ text: String(opt.n), wait: opt.free ? 0.45 : 0.3 }];
  if (opt.free) { if (!String(text || '').trim()) return { ok: false, error: 'type an answer' }; keys.push({ text: String(text).replace(/[\r\n]+/g, ' ').slice(0, 2000), wait: 0.25 }, { cr: true, wait: 0.3 }); }
  const out = await hostOf(sess).call('keys', { target: targetOf(sess), keys }, 30000);
  if (String(out).trim() !== 'ok') return { ok: false, error: 'its terminal is gone' };
  logAction({ op: 'answer', tree, label: (opt.free ? text : opt.label).slice(0, 80) });
  setTimeout(() => refreshMenus(tree).catch(() => {}), 350);
  return { ok: true };
}

async function answerAsk(tree, answers) {
  const sess = sessionBy(tree);
  if (!sess || !sess.tty) return { ok: false, error: 'no terminal for that session' };
  const h = hostOf(sess), t = slow.trees.get(tree);
  const tr = await h.call('transcript', { dir: sess.path, file: sess.transcriptFile, slug: t && t.slug }), ask = tr && tr.ask;
  if (!ask) return { ok: false, error: 'that question was already answered' };
  if (!Array.isArray(answers) || answers.length !== ask.questions.length) return { ok: false, error: 'answer every question' };
  const keys = [];
  for (let i = 0; i < ask.questions.length; i++) {
    const q = ask.questions[i], a = answers[i] || {};
    if (q.multiSelect) return { ok: false, error: 'multiple-choice questions still need the terminal' };
    if (Number.isInteger(a.opt) && a.opt >= 0 && a.opt < q.options.length) keys.push({ text: String(a.opt + 1) });
    else if (typeof a.text === 'string' && a.text.trim()) { keys.push({ text: String(q.options.length + 1), wait: 0.45 }, { text: a.text.replace(/[\r\n]+/g, ' ').slice(0, 2000), wait: 0.25 }, { cr: true, wait: 0.45 }); }
    else return { ok: false, error: 'missing answer for question ' + (i + 1) };
  }
  const out = await h.call('keys', { target: targetOf(sess), keys }, 60000);
  if (String(out).trim() !== 'ok') return { ok: false, error: 'its terminal is gone' };
  if (ask.questions.length > 1) {
    await sleep(500);
    const screen = await screenOf(sess);
    if (/Ready to submit your answers/.test(screen.split('\n').slice(-20).join('\n'))) await h.call('keys', { target: targetOf(sess), keys: [{ text: '1' }] });
    else return { ok: false, error: 'answers typed, but the submit step did not appear; check the tab' };
  }
  logAction({ op: 'answer', tree, label: answers.map((a, i) => a.text || ask.questions[i].options[a.opt].label).join(' / ').slice(0, 80) });
  return { ok: true };
}

async function writeToTty(tty, text) {
  const script = `on run argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if tty of s is ("/dev/" & item 1 of argv) then
            tell s to write text (item 2 of argv) newline NO
            delay 0.1
            tell s to write text (ASCII character 13) newline NO
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
  end tell
end run`;
  // iTerm delivers the text as a paste, so a trailing newline lands inside the paste and Claude Code
  // never sees Enter; a separate carriage return after a beat is what actually submits it.
  return run('osascript', [...script.split('\n').flatMap((l) => ['-e', l]), tty, text]);
}

// ---- closing a session: stop its dev processes (this Mac), end its terminal, and hand a pool worktree back
async function closePreview(tree) {
  const sess = sessionBy(tree), t = slow.trees.get(tree);
  if (!t || !t.path) return { ok: false, error: 'no such tree' };
  const isPool = /^\d+$/.test(t.slot);
  if (!isPool && !(sess && sess.term === 'tmux')) return { ok: false, error: `${idLabel(tree)} is a checkout, not a pool tree; end its session in its own terminal` };
  const h = HOSTS.get(t.host) || localHost();
  const info = await h.call('closeInfo', { path: t.path });
  if (!info.ok) return info;
  const procs = state ? [...state.services.values()].filter((v) => v.tree === tree).map((v) => ({ id: v.id, kind: v.kind, label: labelFor(v), memMB: Math.round(v.memMB) })) : [];
  if (sess && !h.local && !procs.length) procs.push({ id: sess.pid, kind: 'claude', label: `Claude session on ${h.label}`, memMB: Math.round(sess.memMB) });
  return { ok: true, tree, host: h.id, hostLabel: h.label, pool: isPool, path: t.path, branch: info.branch, ahead: info.ahead, changes: info.changes, ttys: sess && sess.tty ? [sess.tmuxSession || sess.ttyName] : [], shared: [], procs, claudeTty: sess && sess.tty, hostsDashboardSession: h.local && process.cwd().startsWith(t.path) };
}
async function closeTree(tree, discard) {
  const pv = await closePreview(tree);
  if (!pv.ok) return pv;
  if (pv.changes.length && !discard) return { ok: false, error: `${pv.changes.length} uncommitted change(s) would be discarded` };
  const sess = sessionBy(tree), h = HOSTS.get(pv.host);
  if (h.local && TEARDOWN && pv.pool) { const [cmd, ...args] = TEARDOWN.replace(/\{tree\}/g, tree.split(':')[2]).split(/\s+/); await run(cmd, args, { timeout: 60000, cwd: MAIN || HOME }); }
  const r = await h.call('close', { path: pv.path, discard: !!discard, ...(sess ? targetOf(sess) || {} : {}) }, 120000);
  if (!r.ok) return r;
  transcriptCache.delete(pv.path);
  logAction({ op: 'close-tree', tree, label: `${pv.branch}${pv.changes.length ? `, discarded ${pv.changes.length} change(s)` : ''}` });
  return r;
}

// Claude Code's own status line ("✻ Pondering… (12s · ↓ 1.2k tokens)") read off the session's screen
const liveCache = new Map();
async function liveStatus(tree) {
  const sess = sessionBy(tree);
  if (!sess || !sess.tty) return { ok: false };
  const hit = liveCache.get(tree);
  if (hit && Date.now() - hit.at < 900) return hit.v;
  const out = await screenOf(sess);
  const lines = out.split('\n').slice(-40).reverse();
  const tr = slow.trees.get(tree), rev = (tr && tr.transcript && tr.transcript.rev) || '';
  let v = { ok: true, rev, working: sess.claudeState === 'working', verb: '', detail: '' };
  for (const l of lines) {
    const m = l.match(/^\s*[·✢✳✶✻✽*]\s+([A-Z][\w'-]*…)\s*(?:\(([^)]*)\))?/);
    if (m) { v = { ...v, verb: m[1], detail: (m[2] || '').replace(/\s*·\s*esc to interrupt/, '') }; break; }
  }
  // what is typed in the prompt box right now: the line after the box's top rule, starting with ❯
  const all = out.split('\n'); for (let k = all.length - 1; k >= 0 && k > all.length - 15; k--) { const pm = all[k].match(/^\s*[❯>]\s?(.*)$/); if (pm && /^\s*[─━]{8,}/.test(all[k - 1] || '')) { const d0 = pm[1].replace(/\s+$/, ''), d = PROMPT_HINTS.test(d0.trim()) ? '' : d0, p = PROMPTS.get(tree); if (p && p.text !== d) trackPrompt(sess, out); v.draft = d ? typedDraft(tree, d) : ''; v.prompt = d; break; } }
  liveCache.set(tree, { at: Date.now(), v });
  return v;
}
// Reloads the JS on every app attached to a Metro server, the same as pressing r in its terminal: Metro's
// message socket broadcasts { method: 'reload' } to the connected apps.
function metroReload(port) {
  return new Promise((resolve) => {
    let done = false, ws;
    const end = (r) => { if (done) return; done = true; try { ws && ws.close(); } catch {} resolve(r); };
    const timer = setTimeout(() => end({ ok: false, error: 'Metro on :' + port + ' did not answer' }), 4000);
    try { ws = new WebSocket('ws://localhost:' + port + '/message'); } catch (e) { clearTimeout(timer); return end({ ok: false, error: e.message }); }
    ws.onopen = () => { ws.send(JSON.stringify({ version: 2, method: 'reload' })); setTimeout(() => { clearTimeout(timer); end({ ok: true }); }, 250); };
    ws.onerror = () => { clearTimeout(timer); end({ ok: false, error: 'could not reach Metro on :' + port }); };
  });
}
function lanIp() { const ifs = os.networkInterfaces(); for (const n of ['en0', 'en1', ...Object.keys(ifs)]) for (const i of ifs[n] || []) if (i.family === 'IPv4' && !i.internal) return i.address; return 'localhost'; }

// The captain's open decisions, as it writes them to ~/.claude/swarm/decisions.json:
// { version, updated, decisions: [{ id, status: open|answered, worker, title, why, context, options: [{ label, reply, recommended }] }] }
let decCache = { mtime: 0, list: [] };
function readDecisions() {
  const f = path.join(SWARM, 'decisions.json');
  let st; try { st = fs.statSync(f); } catch { return []; }
  if (st.mtimeMs === decCache.mtime) return decCache.list;
  let d; try { d = JSON.parse(fs.readFileSync(f, 'utf8')); } catch { return decCache.list; } // mid-write: keep the last good read
  const str = (v, n) => (typeof v === 'string' ? v.slice(0, n) : '');
  const list = (Array.isArray(d && d.decisions) ? d.decisions : []).filter((x) => x && x.id && x.title).map((x) => ({
    id: str(x.id, 80), status: x.status === 'answered' ? 'answered' : 'open', worker: str(x.worker, 40) || null, title: str(x.title, 300), why: str(x.why, 2000), context: str(x.context, 8000),
    options: (Array.isArray(x.options) ? x.options : []).filter((o) => o && o.label && o.reply).slice(0, 6).map((o) => ({ label: str(o.label, 120), reply: str(o.reply, 2000), recommended: !!o.recommended })),
  }));
  decCache = { mtime: st.mtimeMs, list };
  return list;
}
function readBoard() {
  let boards;
  try { boards = fs.readdirSync(SWARM).filter((f) => /^board-\d{4}-\d\d-\d\d\.md$/.test(f)).map((f) => ({ f, t: fs.statSync(path.join(SWARM, f)).mtimeMs })); } catch { return null; }
  if (!boards.length) return null;
  boards.sort((a, b) => b.t - a.t);
  if (Date.now() - boards[0].t > 3 * 86400000) return null;
  const text = fs.readFileSync(path.join(SWARM, boards[0].f), 'utf8');
  const section = (name) => { const m = text.match(new RegExp(`^## ${name}\\s*\\n([\\s\\S]*?)(?=^## |$(?![\\s\\S]))`, 'm')); return m ? m[1] : ''; };
  const tasks = [];
  for (const l of section('Tasks').split('\n')) {
    const cells = l.split('|').slice(1, -1).map((c) => c.trim());
    if (cells.length >= 6 && /^T\d+-\w+$/.test(cells[0])) tasks.push({ id: cells[0], title: cells[1], tree: cells[2], branch: cells[3], scope: cells[4], state: cells[5], pr: cells[6] || '', update: cells[7] || '' });
  }
  return {
    file: boards[0].f, updated: boards[0].t,
    title: (text.match(/^# (.*)$/m) || [, boards[0].f])[1],
    objectives: section('Objectives').split('\n').filter((l) => /^\s*\d+\.\s/.test(l)).map((l) => l.replace(/^\s*\d+\.\s+/, '').trim()),
    decisions: section('Decisions').split('\n').filter((l) => /^\s*(-|\d+\.)\s/.test(l)).map((l) => l.replace(/^\s*(-|\d+\.)\s+/, '').trim()),
    tasks,
    log: section('Log').split('\n').filter((l) => /^\s*-\s/.test(l)).map((l) => l.replace(/^\s*-\s+/, '')).slice(-6),
  };
}

// ---- push: the page holds one /api/events stream; transcript writes are pushed the moment they land
const streams = new Set();
function push(ev) { const line = `data: ${JSON.stringify(ev)}\n\n`; for (const r of streams) { try { r.write(line); } catch { streams.delete(r); } } }
const watchers = new Map(), watchTimers = new Map();
function watchTree(tree, dir) {
  const proj = path.join(HOME, '.claude/projects', dir.replace(/[/.]/g, '-'));
  if (watchers.has(proj) || !fs.existsSync(proj)) return;
  try {
    const w = fs.watch(proj, () => {
      clearTimeout(watchTimers.get(proj));
      watchTimers.set(proj, setTimeout(() => sessionChanged(tree, dir), 120));
    });
    w.on('error', () => { watchers.delete(proj); });
    watchers.set(proj, w);
  } catch { /* no watch: the 4s loop still catches it */ }
}
function sessionChanged(tree, dir) {
  const sess = state && state.sessions.find((x) => x.tree === tree);
  const t = slow.trees.get(tree);
  const tr = transcriptInfoCached(dir, sess && sess.transcriptFile, t && t.slug);
  if (!tr || !sess) return;
  if (t) t.transcript = tr;
  const fields = { ask: tr.ask || null, lastSay: tr.lastSay, lastUser: tr.lastUser, lastUserAt: tr.lastUserAt, lastActive: tr.lastActive, pending: pendingFor(tree, tr, sess.claudeState),
    prs: treePrNums({ ...t, transcript: tr }).map((n) => prFor(t && t.slug, n)) };
  Object.assign(sess, fields);
  push({ type: 'session', tree, fields });
}

// What has been dropped into a tree: one entry per drop (a dated folder), plus pasted images, with size and age.
async function dropsFor(treePath) {
  const root = path.join(treePath, '.pebtree-drops');
  let names; try { names = fs.readdirSync(root, { withFileTypes: true }).filter((d) => d.isDirectory()).map((d) => d.name); } catch { return []; }
  const out = [];
  for (const n of names) {
    const dir = path.join(root, n);
    let items = []; try { items = fs.readdirSync(dir).filter((x) => x !== '.DS_Store'); } catch { /* gone */ }
    if (!items.length) continue; // an empty folder is nothing to clean
    const kb = +((await run('du', ['-sk', dir])).split('\t')[0]) || 0;
    let mt = 0; try { mt = fs.statSync(dir).mtimeMs; } catch { /* gone */ }
    // image files anywhere in the drop (first 8), for previews
    const allImgs = (await run('find', [dir, '-maxdepth', '6', '-type', 'f', '(', '-iname', '*.png', '-o', '-iname', '*.jpg', '-o', '-iname', '*.jpeg', '-o', '-iname', '*.gif', '-o', '-iname', '*.webp', ')'])).split('\n').filter(Boolean), thumbs = allImgs.slice(0, 8), imgCount = allImgs.length;
    out.push({ id: n, items: n === 'images' ? [`${items.length} image${items.length === 1 ? '' : 's'}`] : items.slice(0, 6), more: Math.max(0, items.length - 6), kb, at: Math.round(mt), images: n === 'images', thumbs, imgCount });
  }
  return out.sort((a, b) => b.at - a.at);
}
async function deleteDrops(tree, id) {
  const t = slow.trees.get(tree);
  if (!t || !t.path) return { ok: false, error: 'no such tree' };
  const r = await (HOSTS.get(t.host) || localHost()).call('deleteDrops', { path: t.path, id });
  if (!r.ok) return r;
  logAction({ op: 'drops', tree, label: id === 'all' ? 'cleared all dropped files' : `deleted drop ${id}` });
  if (t.drops) t.drops = id === 'all' ? [] : t.drops.filter((d) => d.id !== id);
  return { ok: true };
}
// Trees, git and transcripts now come with every host's scan; what is left on the slow loop is the captain's board.
async function refreshSlow() {
  slow.board = readBoard(); slow.updated = Date.now();
  refreshRepos(localHost()).catch(() => {});
}

// ---------- iOS simulators ----------
// A simulator app is a plain Mac process; the tree is whichever Metro (or web server) it is connected to.
// Each booted simulator is renamed "tree N · <model>" so its window says whose build it is.
let sims = [];
const serverDevices = new Map(); // service id -> IPs of other machines connected to it (a phone on Metro)
async function refreshDevices() {
  const own = new Set(['127.0.0.1', '::1', ...Object.values(os.networkInterfaces()).flat().map((i) => i && i.address)]);
  const svcs = state ? [...state.services.values()].filter((v) => (v.kind === 'metro' || v.kind === 'next' || v.kind === 'node') && v.ports.length) : [];
  serverDevices.clear();
  if (!svcs.length) return;
  const byPid = new Map(); for (const v of svcs) for (const pid of v.pids) byPid.set(pid, v);
  const out = await run('lsof', ['-nP', '-a', '-p', [...byPid.keys()].join(','), '-iTCP', '-sTCP:ESTABLISHED', '-Fpn']);
  let cur = null;
  for (const line of out.split('\n')) {
    if (line[0] === 'p') cur = byPid.get(+line.slice(1));
    const m = line[0] === 'n' && line.match(/:(\d+)->\[?([0-9a-f.:]+?)\]?:\d+$/i);
    if (!m || !cur || !cur.ports.includes(+m[1]) || own.has(m[2])) continue;
    if (!serverDevices.has(cur.id)) serverDevices.set(cur.id, new Set());
    serverDevices.get(cur.id).add(m[2]);
  }
}
const SIM_PREFIX = /^(tree \d+|main) · /;
async function refreshSims() {
  let booted = [];
  try {
    const j = JSON.parse(await run('xcrun', ['simctl', 'list', 'devices', 'booted', '-j'], { timeout: 8000 }) || '{}');
    for (const [runtime, list] of Object.entries(j.devices || {})) for (const d of list) if (d.state === 'Booted') booted.push({ udid: d.udid, name: d.name, runtime: runtime.split('.').pop().replace(/-/g, ' ').replace(/^iOS (\d+) (\d+)/, 'iOS $1.$2') });
  } catch { booted = []; }
  if (!booted.length) { sims = []; return; }
  const apps = (await run('ps', ['-axo', 'pid=,args='])).split('\n').map((l) => l.trim().match(/^(\d+) .*CoreSimulator\/Devices\/([0-9A-F-]{36})\/.*?\/([^/]+)\.app\//i)).filter(Boolean).map((m) => ({ pid: +m[1], udid: m[2], app: m[3] }));
  const ports = new Map();
  if (apps.length) {
    const out = await run('lsof', ['-nP', '-a', '-p', apps.map((a) => a.pid).join(','), '-iTCP', '-sTCP:ESTABLISHED', '-Fpn']);
    let pid = 0;
    for (const line of out.split('\n')) {
      if (line[0] === 'p') pid = +line.slice(1);
      const m = line[0] === 'n' && line.match(/->(?:127\.0\.0\.1|\[::1\]|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+|localhost):(\d+)$/);
      if (m) { if (!ports.has(pid)) ports.set(pid, new Set()); ports.get(pid).add(+m[1]); }
    }
  }
  const owner = (port) => state && [...state.services.values()].find((v) => v.ports.includes(port));
  sims = booted.map((d) => {
    const app = apps.find((a) => a.udid === d.udid);
    const conns = app ? [...(ports.get(app.pid) || [])].map(owner).filter(Boolean) : [];
    const metro = conns.find((v) => v.kind === 'metro') || conns.find((v) => v.kind === 'node');
    const via = metro || conns.find((v) => v.kind === 'next');
    const named = d.name.match(SIM_PREFIX);
    return { udid: d.udid, name: d.name, model: d.name.replace(SIM_PREFIX, ''), runtime: d.runtime, app: app ? app.app : null, tree: via ? via.tree : named ? named[1].replace('tree ', '') : null, connected: !!via, metroPort: metro ? metro.ports[0] : null };
  });
  for (const sim of sims) {
    if (!sim.tree || !sim.connected) continue;
    const want = `${sim.tree === 'main' ? 'main' : 'tree ' + sim.tree} · ${sim.model}`;
    if (sim.name !== want) { await run('xcrun', ['simctl', 'rename', sim.udid, want], { timeout: 8000 }); sim.name = want; }
  }
}

// ---------- fast state + history ----------

let state = null;
const fine = [];
const coarse = readHistory();
let minuteBucket = [];

function readHistory() {
  try {
    const cutoff = Date.now() - 86400000;
    return fs.readFileSync(HISTORY_FILE, 'utf8').trim().split('\n').map((l) => JSON.parse(l)).filter((p) => p.t >= cutoff).slice(-COARSE_POINTS);
  } catch { return []; }
}
function averageSamples(samples) {
  const avg = (k) => samples.reduce((a, p) => a + (p[k] || 0), 0) / samples.length;
  const avgMap = (k) => {
    const keys = new Set(samples.flatMap((p) => Object.keys(p[k] || {})));
    return Object.fromEntries([...keys].map((key) => [key, Math.round(samples.reduce((a, p) => a + ((p[k] || {})[key] || 0), 0) / samples.length)]));
  };
  return { t: samples[samples.length - 1].t, cpu: +avg('cpu').toFixed(1), used: Math.round(avg('used')), swap: Math.round(avg('swap')), comp: Math.round(avg('comp')), servers: +avg('servers').toFixed(1), working: +avg('working').toFixed(1), trees: avgMap('trees'), treeCpu: avgMap('treeCpu') };
}
function recordSample(sample) {
  fine.push(sample); if (fine.length > FINE_POINTS) fine.shift();
  if (minuteBucket.length && Math.floor(minuteBucket[0].t / 60000) !== Math.floor(sample.t / 60000)) {
    const point = averageSamples(minuteBucket);
    coarse.push(point); if (coarse.length > COARSE_POINTS) coarse.shift();
    try {
      fs.mkdirSync(CONF_DIR, { recursive: true });
      fs.appendFileSync(HISTORY_FILE, JSON.stringify(point) + '\n');
      if (coarse.length === COARSE_POINTS && Math.random() < 0.02) fs.writeFileSync(HISTORY_FILE, coarse.map((p) => JSON.stringify(p)).join('\n') + '\n');
    } catch { /* history persistence is best effort */ }
    minuteBucket = [];
  }
  minuteBucket.push(sample);
}
const RANGES = { '15m': 900000, '1h': 3600000, '6h': 21600000, '24h': 86400000 };
function historyFor(range) {
  const span = RANGES[range] || RANGES['1h'];
  const since = Date.now() - span;
  // after a restart the 4s buffer is short, so older minutes come from the persisted history
  const src = span <= RANGES['1h'] ? coarse.filter((p) => !fine.length || p.t < fine[0].t).concat(fine) : coarse.concat(fine.length ? [averageSamples(fine.slice(-15))] : []);
  return src.filter((p) => p.t >= since);
}
const throttled = new Set();
const actionLog = readLogTail();

function readLogTail() {
  try { return fs.readFileSync(LOG_FILE, 'utf8').trim().split('\n').slice(-30).map((l) => JSON.parse(l)); } catch { return []; }
}
function logAction(entry) {
  const e = { at: Date.now(), ...entry };
  actionLog.push(e); if (actionLog.length > 30) actionLog.shift();
  try { fs.mkdirSync(CONF_DIR, { recursive: true }); fs.appendFileSync(LOG_FILE, JSON.stringify(e) + '\n'); } catch { /* log is best effort */ }
}

// Session and tree ids: <host>:<repo>:<N> for a treehouse slot, <host>:<repo>:main for a checkout, <host>:<folder>:dir
// for anywhere else; a second Claude in the same place gets :<pid> after that.
function idFor(h, s) {
  if (s.pool) return `${h.id}:${s.pool.repo}:${s.pool.slot}`;
  if (s.top) return `${h.id}:${path.basename(s.top)}:main`;
  return `${h.id}:${path.basename(s.cwd) || 'root'}:dir`;
}
function idLabel(id) {
  const [, repo, slot, n] = String(id).split(':');
  if (!repo) return String(id);
  return (slot === 'main' || slot === 'dir' ? repo : `${repo} ${slot}`) + (n ? ` (${n})` : '');
}
function treeKey(id) { const [host, repo, slot] = String(id).split(':'); return [host === LOCAL_HOST ? 0 : 1, host || '', (repo || '').toLowerCase(), slot === 'main' ? -2 : slot === 'dir' ? -1 : +slot || 0]; }
function treeCmp(a, b) { const x = treeKey(a.tree), y = treeKey(b.tree); for (let i = 0; i < x.length; i++) if (x[i] !== y[i]) return x[i] < y[i] ? -1 : 1; return 0; }

function sessionOf(h, id, s, t, svcs, now) {
  const tr = s ? s.transcript : null, title = s ? s.title : '', slot = id.split(':')[2];
  let claudeState = s ? claudeStateFromTitle(title) : 'none';
  const lastActive = tr ? tr.lastActive : 0;
  // no title Claude set (a plain ssh shell, a fresh pane): what Claude Code itself records it is doing
  if (s && claudeState === 'unknown' && s.status) claudeState = s.status === 'busy' ? 'working' : 'waiting';
  if (s && claudeState === 'unknown') claudeState = now - lastActive < 60000 ? 'working' : 'idle';
  if (s && menus.has(id)) claudeState = 'waiting'; // an open question or prompt is waiting on you, whatever the title says
  const task = h.local && slow.board && /^\d+$/.test(slot) ? slow.board.tasks.find((k) => (String(k.tree).match(/\d+/) || [''])[0] === slot && !/merged|stopped|failed/.test(k.state)) : null;
  return {
    tree: id, host: h.id, hostLabel: h.label, local: h.local, label: idLabel(id), repo: t.repo, slot, pid: s ? s.pid : 0,
    term: s ? s.term : '', pane: s ? s.pane : '', tmuxSession: s ? s.session : '', tmuxAttached: s ? s.attached : 0, ttyName: s ? s.tty : '',
    status: t.status, path: s ? s.cwd : t.path, transcriptFile: s ? s.transcriptFile : null, subagents: s ? s.subagents : [], tty: s && s.term ? s.pane || s.tty : null, remote: !!(s && /--remote-control\b/.test(s.args)),
    branch: t.branch, dirty: t.dirty, ahead: t.ahead,
    ask: tr ? tr.ask || null : null, menu: menus.get(id) || null, prompt: (PROMPTS.get(id) || {}).text || '',
    claudeState, ...pickTitle(s && { id: `${h.id}:${s.pid}`, tabName: s.tabName, tabSince: s.tabSince, name: s.name }, title), lastActive, lastSay: tr ? tr.lastSay : '', lastUser: tr ? tr.lastUser : '', lastUserAt: tr ? tr.lastUserAt : 0,
    memMB: svcs.length ? svcs.reduce((a, v) => a + v.memMB, 0) : s ? s.memMB : 0, cpu: svcs.length ? svcs.reduce((a, v) => a + v.cpu, 0) : s ? s.cpu : 0,
    services: svcs.slice().sort((a, b) => b.memMB - a.memMB).map(publicService), task, sims: sims.filter((x) => x.tree === id), drops: t.drops || [], upstream: t.upstream && t.branch && t.upstream.endsWith('/' + t.branch) ? t.upstream : '', repoUrl: t.slug ? `https://github.com/${t.slug}` : '',
    prs: treePrNums(t).map((n) => prFor(t.slug, n)),
    pending: pendingFor(id, tr, claudeState),
  };
}

async function refreshFast() {
  const procs = await readProcesses();
  const candidates = [...procs.values()].filter((p) => kindOf(p.args, p.comm)).map((p) => p.pid);
  const [cwds, listeners, top, swap, titles] = await Promise.all([readCwds(candidates), readListeners(), readTop(), readSwapAndPressure(), readItermTitles()]);
  const lh = localHost();
  mergeScan(lh, await scanHost({ procs, cwds, titles }));
  // dev servers started in a checkout a session runs in count toward that session's tree
  LOCAL_TOPS = [...new Set(lh.scan.sessions.map((s) => s.top).filter(Boolean))].sort((a, b) => b.length - a.length);
  const services = buildServices(procs, cwds, listeners, top.foot);
  for (const id of [...throttled]) if (!services.has(id)) throttled.delete(id);

  const byTree = new Map();
  for (const s of services.values()) {
    if (!byTree.has(s.tree)) byTree.set(s.tree, []);
    byTree.get(s.tree).push(s);
  }
  const now = Date.now();
  const sessions = [], all = new Map();
  const treeFrom = (h, id, p, git, extra) => ({ tree: id, host: h.id, local: h.local, path: p, repo: id.split(':')[1], slot: id.split(':')[2], branch: git ? git.branch : '', dirty: git ? git.dirty : 0, ahead: git ? git.ahead : 0, upstream: git ? git.upstream : '', slug: git ? git.slug : '', ...extra });
  for (const h of HOSTS.values()) {
    if (!h.scan) continue;
    for (const w of h.scan.pools) { const id = `${h.id}:${w.repo}:${w.slot}`; all.set(id, treeFrom(h, id, w.path, w.git, { status: w.status, stale: w.status !== 'available' && !w.claude, tmuxSession: w.tmux || '', last: w.last || null })); }
    // a session with a terminal claims its tree's id first, so a second Claude in the same checkout gets the suffix
    const seen = new Set();
    for (const s of h.scan.sessions.slice().sort((a, b) => (!!b.term - !!a.term) || a.pid - b.pid)) {
      let id = idFor(h, s);
      if (seen.has(id)) id += `:${s.pid}`;
      seen.add(id);
      const t = all.get(id) || treeFrom(h, id, s.pool ? s.cwd : s.top || s.cwd, s.git, { status: s.top ? 'main' : 'folder' });
      if (s.git) Object.assign(t, { branch: s.git.branch, dirty: s.git.dirty, ahead: s.git.ahead, upstream: s.git.upstream, slug: s.git.slug });
      Object.assign(t, { transcript: s.transcript, drops: s.drops });
      all.set(id, t);
      sessions.push(sessionOf(h, id, s, t, h.local ? byTree.get(id) || [] : [], now));
    }
  }
  // dev servers in a local tree whose Claude session has ended
  for (const [id, svcs] of byTree) if (all.has(id) && !sessions.some((x) => x.tree === id)) sessions.push(sessionOf(lh, id, null, all.get(id), svcs, now));
  sessions.sort(treeCmp);
  slow.trees = all;
  for (const x of sessions) if (x.local && x.transcriptFile) watchTree(x.tree, x.path);

  const treeMem = {};
  const treeCpu = {};
  for (const s of sessions) { treeMem[s.tree] = Math.round(s.memMB); treeCpu[s.tree] = +s.cpu.toFixed(1); }
  const sys = { ...top.sys, ...swap, totalMB: TOTAL_RAM_MB, cores: os.cpus().length, load: os.loadavg(), lanIp: lanIp() };
  recordSample({
    t: now, cpu: +(sys.cpuUser + sys.cpuSys).toFixed(1), used: Math.round(sys.usedMB), swap: Math.round(sys.swapUsedMB), comp: Math.round(sys.compressorMB),
    servers: [...services.values()].filter((s) => SERVER_KINDS.has(s.kind)).length, working: sessions.filter((s) => s.claudeState === 'working').length,
    trees: treeMem, treeCpu,
  });

  // the Trees page: every pool slot on every host
  const trees = [...all.values()].filter((t) => /^\d+$/.test(t.slot)).sort(treeCmp).map((t) => {
    const sess = sessions.find((x) => x.tree === t.tree);
    return {
      tree: t.tree, host: t.host, status: t.status, stale: !sess && !!t.stale, tmuxSession: t.tmuxSession || '', last: !sess ? t.last : null, branch: t.branch || '', dirty: t.dirty || 0, ahead: t.ahead || 0,
      lastActive: sess ? sess.lastActive : (t.transcript ? t.transcript.lastActive : 0),
      claudeState: sess ? sess.claudeState : 'none', title: sess ? sess.title : '',
      memMB: sess ? Math.round(sess.memMB) : 0, servers: sess ? sess.services.filter((x) => SERVER_KINDS.has(x.kind)).length : 0,
      stoppable: sess ? sess.services.filter((x) => x.killable && x.kind !== 'mcp').length : 0,
    };
  });
  const maxTrees = readMaxTrees() || 0;
  const inUse = trees.filter((t) => t.status !== 'available').length;
  setImmediate(() => push({ type: 'state' }));
  state = { at: now, sys, sessions, services, trees, pool: { max: maxTrees || null, inUse, total: trees.length }, board: slow.board };
  await autoReap();
}

function publicService(s) {
  return { devices: [...(serverDevices.get(s.id) || [])], id: s.id, tree: s.tree, kind: s.kind, label: s.label, ports: s.ports, memMB: Math.round(s.memMB), cpu: +s.cpu.toFixed(1), age: s.age, pids: s.pids.length, orphan: s.orphan, throttled: s.throttled, mcpCount: s.mcpCount, killable: KILLABLE.has(s.kind) };
}

// ---------- actions ----------

function idleMinutes(tree) {
  const sess = state && state.sessions.find((s) => s.tree === tree);
  if (!sess) return Infinity;
  if (sess.claudeState === 'working') return 0;
  return sess.lastActive ? (Date.now() - sess.lastActive) / 60000 : Infinity;
}

async function stopService(id, reason) {
  const s = state && state.services.get(id);
  if (!s) return { ok: false, error: 'not running any more' };
  if (!KILLABLE.has(s.kind)) return { ok: false, error: `pebtree never stops a ${s.kind} process` };
  const now = await readProcesses();
  const snapshot = new Map(s.pids.filter((pid) => now.has(pid)).map((pid) => [pid, now.get(pid).args]));
  const pids = [...snapshot.keys()].sort((a, b) => b - a);
  for (const pid of pids) try { process.kill(pid, 'SIGTERM'); } catch { /* already gone */ }
  await sleep(4000);
  const after = await readProcesses();
  const survivors = pids.filter((pid) => after.has(pid) && after.get(pid).args === snapshot.get(pid));
  for (const pid of survivors) try { process.kill(pid, 'SIGKILL'); } catch { /* gone */ }
  throttled.delete(id);
  logAction({ op: 'stop', tree: s.tree, label: s.label, memMB: Math.round(s.memMB), reason, forced: survivors.length });
  return { ok: true, freedMB: Math.round(s.memMB), forced: survivors.length };
}

async function setThrottle(id, on) {
  const s = state && state.services.get(id);
  if (!s) return { ok: false, error: 'not running any more' };
  for (const pid of s.pids) await run('taskpolicy', [on ? '-b' : '-B', '-p', String(pid)]);
  on ? throttled.add(id) : throttled.delete(id);
  logAction({ op: on ? 'throttle' : 'unthrottle', tree: s.tree, label: s.label });
  return { ok: true };
}

function cleanupCandidates(mode, minutes) {
  if (!state) return [];
  return [...state.services.values()].filter((s) => {
    if (!KILLABLE.has(s.kind) || s.kind === 'mcp') return false;
    if (mode === 'orphans') return s.orphan;
    if (mode === 'idle') return (SERVER_KINDS.has(s.kind) || s.kind === 'jest') && idleMinutes(s.tree) >= minutes;
    return false;
  }).map(publicService);
}

let reaping = false;
async function autoReap() {
  const mins = Number(settings.autoStopIdleMinutes) || 0;
  if (!mins || reaping) return;
  reaping = true;
  try {
    for (const s of cleanupCandidates('idle', mins)) {
      if (!SERVER_KINDS.has(s.kind)) continue;
      await stopService(s.id, `auto: tree idle over ${mins} min`);
    }
  } finally { reaping = false; }
}

// ---------- proof ----------

const PROOF_DIR = path.join(CONF_DIR, 'proof');
const MIME = { '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.gif': 'image/gif', '.webp': 'image/webp', '.svg': 'image/svg+xml', '.mp4': 'video/mp4', '.mov': 'video/quicktime', '.webm': 'video/webm', '.txt': 'text/plain; charset=utf-8', '.log': 'text/plain; charset=utf-8', '.md': 'text/plain; charset=utf-8', '.json': 'application/json', '.html': 'text/plain; charset=utf-8' };

function listProof() {
  const entries = [];
  let trees = [];
  try { trees = fs.readdirSync(PROOF_DIR); } catch { return entries; }
  for (const tree of trees) {
    let ids = [];
    try { ids = fs.readdirSync(path.join(PROOF_DIR, tree)); } catch { continue; }
    for (const id of ids) {
      const meta = readJson(path.join(PROOF_DIR, tree, id, 'meta.json'), null);
      if (meta) entries.push({ ...meta, tree, id });
    }
  }
  return entries.sort((a, b) => b.at - a.at).slice(0, 300);
}

// ---- slash commands a tree's Claude accepts: built-ins, your skills and commands, the repo's, enabled plugins'
const BUILTIN_CMDS = [
  ['compact', 'Summarize the conversation so far to free up context'], ['clear', 'Start a fresh conversation in this tab'],
  ['context', 'Show how full the context window is'], ['rename', 'Rename this session (and its tab)'], ['remote-control', 'Let you reach this session from claude.ai or your phone'],
  ['cost', 'Show what this session has cost'], ['review', 'Review the current changes'], ['security-review', 'Security review of the pending changes'], ['init', 'Write a CLAUDE.md for this repo'],
];
function frontmatter(file) {
  try { const t = fs.readFileSync(file, 'utf8').slice(0, 4000), m = t.match(/^---\n([\s\S]*?)\n---/); if (!m) return {}; const o = {}; for (const l of m[1].split('\n')) { const k = l.match(/^([\w-]+):\s*(.*)$/); if (k) o[k[1]] = k[2].replace(/^["']|["']$/g, ''); } return o; } catch { return {}; }
}
let skillCache = { at: 0, key: '', list: [] };
function listSkills(treePath) {
  if (skillCache.key === treePath && Date.now() - skillCache.at < 60000) return skillCache.list;
  const out = new Map(), add = (name, desc, src) => { if (name && !out.has(name)) out.set(name, { name, desc: String(desc || '').slice(0, 220), src }); };
  const fromDir = (dir, src, prefix) => {
    let ents = []; try { ents = fs.readdirSync(dir, { withFileTypes: true }); } catch { return; }
    for (const e of ents) {
      const f = path.join(dir, e.name, 'SKILL.md');
      if (!fs.existsSync(f)) continue;
      const fm = frontmatter(f); if (fm['user-invocable'] === 'false') continue;
      add((prefix || '') + (fm.name || e.name), fm.description, src);
    }
  };
  const cmds = (dir, src, prefix) => { let fs_ = []; try { fs_ = fs.readdirSync(dir).filter((f) => f.endsWith('.md')); } catch { return; } for (const f of fs_) add((prefix || '') + f.slice(0, -3), frontmatter(path.join(dir, f)).description, src); };
  if (treePath) { fromDir(path.join(treePath, '.claude/skills'), 'repo'); cmds(path.join(treePath, '.claude/commands'), 'repo'); }
  fromDir(path.join(HOME, '.claude/skills'), 'yours'); cmds(path.join(HOME, '.claude/commands'), 'yours');
  try {
    const enabled = (JSON.parse(fs.readFileSync(path.join(HOME, '.claude/settings.json'), 'utf8')).enabledPlugins) || {};
    const inst = JSON.parse(fs.readFileSync(path.join(HOME, '.claude/plugins/installed_plugins.json'), 'utf8')).plugins || {};
    for (const [id, v] of Object.entries(inst)) { if (!enabled[id]) continue; const ip = (Array.isArray(v) ? v[0] : v).installPath, pn = id.split('@')[0]; if (!ip) continue; fromDir(path.join(ip, 'skills'), 'plugin', pn + ':'); cmds(path.join(ip, 'commands'), 'plugin', pn + ':'); }
  } catch { /* no plugins */ }
  for (const [n, d] of BUILTIN_CMDS) add(n, d, 'built-in');
  skillCache = { at: Date.now(), key: treePath, list: [...out.values()] };
  return skillCache.list;
}

// ---- subagents: Claude Code keeps each one's transcript and a .meta.json (description, type, finished) in
// <session>/subagents/ next to the session's own transcript.
const subCache = new Map();
function subagentsFor(file) {
  if (!file) return [];
  const dir = file.replace(/\.jsonl$/, '') + '/subagents';
  let names; try { names = fs.readdirSync(dir).filter((f) => f.endsWith('.meta.json')); } catch { return []; }
  const now = Date.now(), out = [];
  for (const n of names) {
    const id = n.replace(/\.meta\.json$/, ''), jf = path.join(dir, id + '.jsonl');
    let st; try { st = fs.statSync(jf); } catch { continue; }
    if (now - st.mtimeMs > 864e5) continue;
    const key = jf + ':' + st.mtimeMs, hit = subCache.get(jf);
    if (hit && hit.key === key) { out.push(hit.v); continue; }
    let meta = {}; try { meta = JSON.parse(fs.readFileSync(path.join(dir, n), 'utf8')); } catch { /* still being written */ }
    // what it is doing: the newest assistant text or tool call in the last 96 KB
    let doing = '', tools = 0;
    try {
      const len = Math.min(st.size, 98304), buf = Buffer.alloc(len), fd = fs.openSync(jf, 'r'); fs.readSync(fd, buf, 0, len, st.size - len); fs.closeSync(fd);
      const lines = buf.toString('utf8').split('\n');
      for (let i = lines.length - 1; i >= 0 && !doing; i--) {
        let j; try { j = JSON.parse(lines[i]); } catch { continue; }
        const c = j.type === 'assistant' && j.message && Array.isArray(j.message.content) ? j.message.content : [];
        for (let k = c.length - 1; k >= 0 && !doing; k--) {
          const b = c[k];
          if (b.type === 'text' && b.text.trim()) doing = b.text.trim().replace(/\s+/g, ' ').slice(0, 300);
          else if (b.type === 'tool_use' && !/Handback$/.test(b.name)) { const inp = b.input || {}; doing = b.name + (inp.description ? ': ' + inp.description : inp.command ? ': ' + String(inp.command).slice(0, 120) : inp.file_path ? ': ' + path.basename(inp.file_path) : inp.pattern ? ': ' + inp.pattern : ''); }
        }
      }
      tools = (buf.toString('utf8').match(/"type":"tool_use"/g) || []).length;
    } catch { /* unreadable: show the meta only */ }
    const v = { id, desc: meta.description || id, type: meta.agentType || 'agent', model: meta.model || '', finished: !!meta.finished, background: meta.requestShape === 'background', worktree: meta.worktreeBranch || '', lastAt: Math.round(st.mtimeMs), doing, recentTools: tools };
    subCache.set(jf, { key, v }); out.push(v);
  }
  return out.sort((a, b) => (a.finished - b.finished) || b.lastAt - a.lastAt).slice(0, 12);
}

// ---- PRs: one `gh pr list` per repo the trees belong to, matched to trees by the PR links their sessions posted
// and by the branch they push. Keyed "<owner/repo>#<number>": sessions span several repos.
const PRS = new Map();
const prKey = (slug, n) => `${String(slug || '').toLowerCase()}#${n}`;
function prFor(slug, n) { return PRS.get(prKey(slug, n)) || { number: n, repo: slug || '', url: slug ? `https://github.com/${slug}/pull/${n}` : '', title: '', state: '' }; }
const prState = (p) => (p.state === 'MERGED' ? 'merged' : p.state === 'CLOSED' ? 'closed' : p.isDraft ? 'draft' : 'open');
function keepPR(slug, p) {
  const k = prKey(slug, p.number);
  PRS.set(k, { ...PRS.get(k), repo: slug, number: p.number, title: p.title || '', state: prState(p), review: (p.reviewDecision || '').toLowerCase(), author: (p.author && p.author.login) || '', updatedAt: Date.parse(p.updatedAt) || 0, url: p.url, head: p.headRefName || '' });
}
async function ghJson(args) { const r = await runOk('gh', args, { timeout: 90000 }); if (!r.ok) return null; try { return JSON.parse(r.out); } catch { return null; } }
let ME = '';
async function refreshPRs() {
  if (!ME && !CONFIG.githubUser) ME = (await run('gh', ['api', 'user', '-q', '.login'], { timeout: 30000 })).trim();
  const slugs = [...new Set([...slow.trees.values()].map((t) => t.slug).filter(Boolean))];
  for (const slug of slugs) {
    const list = await ghJson(['pr', 'list', '-R', slug, '--state', 'all', '--limit', '80', '--json', 'number,title,state,isDraft,author,updatedAt,url,reviewDecision,headRefName']);
    for (const p of list || []) keepPR(slug, p);
  }
  // Open PRs a tree linked, and yours: how mergeable they are (conflicts, behind, failing checks), rechecked every 5 minutes
  const now = Date.now(), open = new Set(), me = ghUser();
  for (const t of slow.trees.values()) for (const n of treePrNums(t)) { const p = PRS.get(prKey(t.slug, n)); if (p && (p.state === 'open' || p.state === 'draft')) open.add(p); }
  for (const p of PRS.values()) if (me && p.author === me && (p.state === 'open' || p.state === 'draft')) open.add(p);
  for (const p of [...open].filter((p) => now - (p.mergeAt || 0) > 300000).slice(0, 12)) {
    const v = await ghJson(['pr', 'view', String(p.number), '-R', p.repo, '--json', 'mergeStateStatus,statusCheckRollup']);
    if (!v) continue;
    const failing = (v.statusCheckRollup || []).filter((c) => /^(FAILURE|TIMED_OUT|ERROR|STARTUP_FAILURE)$/.test(c.conclusion || c.state || '')).length;
    Object.assign(p, { merge: String(v.mergeStateStatus || '').toLowerCase(), failing, mergeAt: now });
  }
  // PRs a tree linked that are older than the listing: look each up once (a closed or merged PR stays that way)
  const wanted = [];
  for (const t of slow.trees.values()) for (const n of treePrNums(t)) { const k = prKey(t.slug, n); if (t.slug && !PRS.has(k) && !PRS_VIEWED.has(k)) { PRS_VIEWED.add(k); wanted.push([t.slug, n]); } }
  for (const [slug, n] of wanted.slice(0, 12)) { const v = await ghJson(['pr', 'view', String(n), '-R', slug, '--json', 'number,title,state,isDraft,author,updatedAt,url,reviewDecision,headRefName']); if (v) keepPR(slug, v); }
}
const PRS_VIEWED = new Set();
// PRs a session linked, plus those whose head is the branch its tree pushes to, so a PR shows on the tree that
// pushed it even when the session never printed the link.
function treePrNums(t) {
  if (!t) return [];
  const up = String(t.upstream || '').replace(/^[^/]+\//, '') || t.branch, slug = String(t.slug || '').toLowerCase();
  const byBranch = up && up !== 'master' && up !== 'main' && up !== '(detached)' ? [...PRS.values()].filter((p) => p.head === up && p.repo.toLowerCase() === slug).map((p) => p.number) : [];
  return [...new Set([...((t.transcript && t.transcript.prNums) || []), ...byBranch])].slice(-12);
}
// Who "mine" is: config.json githubUser, else whoever gh is logged in as.
function ghUser() { return CONFIG.githubUser || ME; }
function allPRs() {
  const byPr = {};
  for (const t of slow.trees.values()) for (const n of treePrNums(t)) (byPr[prKey(t.slug, n)] = byPr[prKey(t.slug, n)] || []).push(t.tree);
  return [...PRS.values()].map((p) => ({ ...p, trees: byPr[prKey(p.repo, p.number)] || [] }));
}

// ---- captain: one swarm-master session in its own leased tree (it never edits files, so a fresh tree keeps it
// away from your own work in main), started with the day's objectives
function captainSession() { return state && state.sessions.find((x) => x.claudeState !== 'none' && /^(✳\s*)?master$/i.test(String(x.title || '').trim())); }
async function startCaptain(objectives) {
  const list = String(objectives || '').split('\n').map((l) => l.replace(/^\s*(\d+[.)]|[-*])\s*/, '').trim()).filter(Boolean);
  if (!list.length) return { ok: false, error: 'write at least one objective' };
  const cur = captainSession();
  if (cur) return { ok: false, error: `a captain is already running in ${cur.tree === 'main' ? 'main' : 'tree ' + cur.tree}; tell it "add: ..." instead` };
  const id = `${new Date().toISOString().slice(0, 10)}-captain-${Date.now().toString(36).slice(-4)}`;
  const leased = await run('treehouse', ['get', '--lease', '--lease-holder', `captain:${id}`], { cwd: MAIN, timeout: 600000 });
  const treePath = leased.trim().split('\n').pop();
  if (!treePath || !fs.existsSync(treePath)) return { ok: false, error: 'no free tree in the pool for the captain' };
  const tree = path.basename(path.dirname(treePath));
  const prompt = `Load the swarm-master skill. You are the master. Your session runs in tree ${tree} (${treePath}), leased just for you: never edit files in it; read other trees with git -C.\n\nToday's objectives:\n${list.map((o, i) => `${i + 1}. ${o}`).join('\n')}\n\nWrite today's board, show me the plan, and wait for my go-ahead before spawning workers.\n`;
  fs.mkdirSync(SPINOFF_DIR, { recursive: true });
  const pf = path.join(SPINOFF_DIR, `${id}.md`), launch = path.join(SPINOFF_DIR, `${id}.sh`);
  fs.writeFileSync(pf, prompt);
  fs.writeFileSync(launch, `#!/bin/zsh -li\ncd ${JSON.stringify(treePath)} || exit 1\nclaude -n master --permission-mode auto "$(cat ${JSON.stringify(pf)})"\nexec zsh -l\n`, { mode: 0o755 });
  // the indigo "Swarm Master" profile when it exists, else the default one
  const out = await run('osascript', ['-e', 'on run argv', '-e', 'tell application "iTerm2"', '-e', 'if (count of windows) = 0 then', '-e', 'create window with default profile command (item 1 of argv)', '-e', 'else', '-e', 'set w to current window',
    '-e', 'try', '-e', 'tell w to create tab with profile "Swarm Master" command (item 1 of argv)', '-e', 'on error', '-e', 'tell w to create tab with default profile command (item 1 of argv)', '-e', 'end try', '-e', 'end if', '-e', 'return "ok"', '-e', 'end tell', '-e', 'end run', `/bin/zsh -lic ${launch}`]);
  logAction({ op: 'captain', tree, label: `${list.length} objective(s)` });
  refreshSlow().catch(() => {});
  return out.trim() === 'ok' ? { ok: true, tree } : { ok: false, error: 'tree leased but the iTerm tab did not open', tree };
}

// ---- spin-off: hand an unrelated task to a fresh tree with its own Claude session
const SPINOFF_DIR = path.join(CONF_DIR, 'spinoffs');
function slugify(t) { return String(t).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').split('-').slice(0, 5).join('-') || 'task'; }
// Where a spin-off goes: the host and repo of the session it came from, else config.json "spinoff": { host, repo },
// else the first preset that starts a tree, else this Mac's configured checkout.
function spinoffTarget(from) {
  const t = from && slow.trees.get(from);
  if (t && t.path) return { host: t.host, repo: t.path };
  const c = CONFIG.spinoff || presets().find((p) => p.kind === 'tree');
  return c ? { host: c.host || LOCAL_HOST, repo: c.repo } : { host: LOCAL_HOST, repo: MAIN };
}
async function spinoff({ task, title, from, host, repo, untrusted }) {
  task = String(task || '').trim();
  if (!task) return { ok: false, error: 'the task is empty' };
  title = String(title || task.split('\n')[0]).replace(/\s+/g, ' ').trim().slice(0, 50);
  const tgt = host && repo ? { host, repo } : spinoffTarget(from), h = HOSTS.get(tgt.host);
  if (!h || !tgt.repo) return { ok: false, error: 'nowhere to spin off to: set "spinoff": { "host", "repo" } in config.json' };
  const branch = `${CONFIG.branchPrefix || ''}${slugify(title)}`;
  const brief = `You were spun off${from ? ` from ${idLabel(from)}` : ''} to do one self-contained task, here in a fresh worktree.

Before anything else:
1. Run \`git status\` and \`git branch --show-current\`. If this tree has uncommitted changes, or is on a branch that is not yours, stop and tell me; never discard someone's work.
2. Otherwise: \`git fetch origin\` and \`git switch -c ${branch} origin/HEAD\` (pick another name if that branch exists).

Then do the task below, following the repo's CLAUDE.md. Commit on your branch; ask me before pushing or opening a PR unless the task says to. When done, summarize what changed, how you checked it, and anything left.

## Task
${task}
`;
  const r = await h.call('spawn', { kind: 'tree', repo: tgt.repo, prompt: brief, title, untrusted: !!untrusted }, 600000);
  if (!r.ok) return r;
  const tree = `${h.id}:${path.basename(r.path)}:${r.tree}`;
  logAction({ op: 'spinoff', tree, label: title });
  return { ok: true, tree, host: h.id, session: r.session, path: r.path, branch, title };
}
async function spinoffCli(argv) {
  const opt = { task: '', title: '', from: '' };
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === '--title') opt.title = argv[++i];
    else if (argv[i] === '--from') opt.from = argv[++i];
    else if (argv[i] === '--brief-file') opt.task = fs.readFileSync(argv[++i], 'utf8');
    else opt.task += (opt.task ? ' ' : '') + argv[i];
  }
  if (!opt.task.trim()) { console.log('usage: pebtree spinoff [--title "short name"] [--from <tree>] (--brief-file brief.md | "task text")'); process.exit(1); }
  // run from inside a checkout: a new tree of the same repo, on this machine
  const r = await spinoff({ ...opt, host: LOCAL_HOST, repo: process.cwd() });
  console.log(r.ok ? `spun off to ${idLabel(r.tree)} (${r.path}), tmux session ${r.session}\n  branch: ${r.branch}\n  title:  ${r.title}` : `pebtree spinoff: ${r.error}`);
  process.exit(r.ok ? 0 : 1);
}

async function proofCli(argv) {
  const opts = { files: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--title' || a === '--note' || a === '--run') opts[a.slice(2)] = argv[++i];
    else if (a === '-h' || a === '--help') opts.help = true;
    else opts.files.push(a);
  }
  if (opts.help || (!opts.files.length && !opts.run && !opts.note)) {
    console.log('usage: pebtree proof [files...] --title "what this proves" [--note "..."] [--run "command whose output and exit code to record"]');
    process.exit(opts.help ? 0 : 1);
  }
  const cwd = process.cwd();
  const top = (await run('git', ['rev-parse', '--show-toplevel'], { cwd })).trim() || cwd;
  LOCAL_TOPS = [top];
  const tree = treeOf(cwd) || 'other';
  const branch = (await run('git', ['branch', '--show-current'], { cwd })).trim();
  const at = Date.now();
  const id = new Date(at).toISOString().replace(/[:.]/g, '-') + '-' + (opts.title || 'proof').toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 40).replace(/-+$/, '');
  const dir = path.join(PROOF_DIR, tree, id);
  fs.mkdirSync(dir, { recursive: true });
  const files = [];
  for (const f of opts.files) {
    const src = path.resolve(cwd, f);
    if (!fs.existsSync(src) || !fs.statSync(src).isFile()) { console.error(`pebtree proof: no such file ${f}`); process.exit(1); }
    let name = path.basename(src).replace(/[^\w.\-]+/g, '_');
    while (files.some((x) => x.name === name)) name = '1_' + name;
    fs.copyFileSync(src, path.join(dir, name));
    files.push({ name, size: fs.statSync(src).size, type: (MIME[path.extname(name).toLowerCase()] || 'application/octet-stream').split(';')[0] });
  }
  let runResult = null;
  if (opts.run) {
    const started = Date.now();
    runResult = await new Promise((resolve) => {
      execFile('/bin/zsh', ['-lc', opts.run], { cwd, maxBuffer: 64 * 1024 * 1024, timeout: 30 * 60000 }, (err, stdout, stderr) => {
        const output = (String(stdout) + (stderr ? '\n' + String(stderr) : '')).trim();
        resolve({ cmd: opts.run, exit: err ? (typeof err.code === 'number' ? err.code : 1) : 0, ms: Date.now() - started, output: output.slice(-60000) });
      });
    });
    fs.writeFileSync(path.join(dir, 'output.txt'), runResult.output);
    console.log(`pebtree proof: ${opts.run} exited ${runResult.exit}`);
  }
  const meta = { tree, at, title: opts.title || (runResult ? opts.run : files.map((f) => f.name).join(', ')), note: opts.note || '', branch, repo: path.basename(top), files, run: runResult };
  fs.writeFileSync(path.join(dir, 'meta.json'), JSON.stringify(meta, null, 2));
  console.log(`pebtree proof: saved to ${dir}\nview it at http://localhost:${PORT}/#proof`);
  process.exit(runResult && runResult.exit ? runResult.exit : 0);
}

function serveProofFile(res, rel) {
  const parts = rel.split('/').map(decodeURIComponent);
  if (parts.length !== 3 || parts.some((x) => !x || x === '.' || x === '..' || x.includes('/'))) return send(res, 400, { error: 'path' });
  const file = path.join(PROOF_DIR, ...parts);
  if (!file.startsWith(PROOF_DIR + path.sep) || !fs.existsSync(file)) return send(res, 404, { error: 'not found' });
  res.writeHead(200, { 'Content-Type': MIME[path.extname(file).toLowerCase()] || 'application/octet-stream', 'Cache-Control': 'private, max-age=86400', 'X-Content-Type-Options': 'nosniff', 'Content-Security-Policy': "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'" });
  fs.createReadStream(file).pipe(res);
}

// ---------- journal ----------

// ---- engineering tickets: a project's /api/engineering/tickets (contract in docs/pebtree.md).
// config.json "tickets": { "url": "https://your-app.example.com", "key": "<PEBTREE_API_KEY>" }; env PEBTREE_TICKETS_URL / _KEY override.
// The key is only ever sent in the Authorization header: never logged, never sent to the page.
const TK = { url: String(process.env.PEBTREE_TICKETS_URL || (CONFIG.tickets && CONFIG.tickets.url) || '').replace(/\/+$/, ''), key: process.env.PEBTREE_TICKETS_KEY || (CONFIG.tickets && CONFIG.tickets.key) || '' };
const TICKETS = new Map(), TK_STATE_FILE = path.join(CONF_DIR, 'tickets.json');
let tkCursor = '', tkError = '', tkPolled = 0;
let tkStarted = readJson(TK_STATE_FILE, {}); // ticket id -> { tree, at }: tickets pebtree started, so their PR can be written back
async function tkFetch(p, opts = {}) {
  if (!TK.url || !TK.key) throw new Error('tickets are not configured');
  const ctl = new AbortController(), timer = setTimeout(() => ctl.abort(), 20000);
  try {
    const r = await fetch(TK.url + p, { ...opts, signal: ctl.signal, headers: { Authorization: `Bearer ${TK.key}`, 'Content-Type': 'application/json', ...(opts.headers || {}) } });
    let body = {}; try { body = await r.json(); } catch { /* not json */ }
    if (!r.ok) throw new Error(`${r.status} ${body.error || r.statusText}`);
    return body;
  } finally { clearTimeout(timer); }
}
function tkKeep(t) { const old = TICKETS.get(t.id); if (!old || String(t.updated_at) >= String(old.updated_at)) TICKETS.set(t.id, t); }
async function pollTickets() {
  if (!TK.url || !TK.key) return;
  try {
    // the cursor steps back 5s when caught up, so a ticket can arrive twice: keyed by id, newer updated_at wins
    for (let page = 0; page < 20; page++) {
      const r = await tkFetch(`/api/engineering/tickets?limit=200&updated_since=${encodeURIComponent(tkCursor || '1970-01-01T00:00:00.000Z')}`);
      (r.tickets || []).forEach(tkKeep);
      if (r.next_updated_since) tkCursor = r.next_updated_since;
      if (!r.has_more) break;
    }
    tkError = ''; tkPolled = Date.now();
    await tkWriteBackPRs();
  } catch (e) { tkError = String(e.message || e).slice(0, 200); }
}
async function tkPatch(id, fields) { const r = await tkFetch(`/api/engineering/tickets/${encodeURIComponent(id)}`, { method: 'PATCH', body: JSON.stringify(fields) }); if (r.ticket) TICKETS.set(r.ticket.id, r.ticket); return r.ticket; }
// a ticket pebtree started gets its tree's PR written back once one exists
async function tkWriteBackPRs() {
  for (const [id, st] of Object.entries(tkStarted)) {
    const t = TICKETS.get(id), tr = slow.trees.get(String(st.tree));
    if (!t || t.pr_url || !tr) continue;
    const pr = treePrNums(tr).map((n) => PRS.get(prKey(tr.slug, n))).filter(Boolean).find((p) => p.url && p.state !== 'closed');
    if (pr) { try { await tkPatch(id, { pr_url: pr.url }); logAction({ op: 'ticket', tree: String(st.tree), label: `PR #${pr.number} written to "${t.title.slice(0, 40)}"` }); } catch (e) { tkError = String(e.message).slice(0, 200); } }
  }
}
function ticketsState() {
  const list = [...TICKETS.values()].sort((a, b) => String(b.updated_at).localeCompare(String(a.updated_at)));
  return { configured: !!(TK.url && TK.key), base: TK.url, error: tkError, polled: tkPolled, list, newCount: list.filter((t) => t.status === 'new').length };
}
function ticketBrief(t) {
  const pc = t.pebble_context || {};
  return [`Engineering ticket from ${t.requester_name || 'someone'} (${t.kind}, ${t.priority} priority${t.area ? ', area: ' + t.area : ''}).`, `Admin page: ${t.url}`, t.slack_permalink ? `Slack thread: ${t.slack_permalink}` : '', '', `## ${t.title}`, '', t.body || '',
    t.acceptance ? `\n## Done when\n${t.acceptance}` : '', pc.summary ? `\n## What the filer found\n${pc.summary}` : '', (pc.links || []).length ? '\nLinks:\n' + pc.links.map((l) => `- ${l.label ? l.label + ': ' : ''}${l.url}`).join('\n') : '',
    (pc.files || []).length ? '\nFiles:\n' + pc.files.map((f) => `- ${f}`).join('\n') : '', '\nOpen a PR when it is ready and link it in your summary.'].filter((l) => l !== '').join('\n');
}
async function startTicket(id) {
  const t = TICKETS.get(id);
  if (!t) return { ok: false, error: 'no such ticket (wait for the next poll)' };
  if (tkStarted[id] && slow.trees.get(String(tkStarted[id].tree))) return { ok: false, error: `already started in tree ${tkStarted[id].tree}` };
  const r = await spinoff({ task: ticketBrief(t), title: t.title.slice(0, 50), untrusted: true });
  if (!r.ok) return r;
  tkStarted[id] = { tree: r.tree, at: Date.now() };
  try { fs.writeFileSync(TK_STATE_FILE, JSON.stringify(tkStarted, null, 2)); } catch { /* best effort */ }
  try { await tkPatch(id, { status: 'in_progress', tree: String(r.tree), notes: `pebtree: started in tree ${r.tree} on ${r.branch}` }); }
  catch (e) { return { ok: true, tree: r.tree, warning: `tree ${r.tree} started, but the ticket was not updated: ${e.message}` }; }
  logAction({ op: 'ticket', tree: String(r.tree), label: `started "${t.title.slice(0, 50)}"` });
  return { ok: true, tree: r.tree, branch: r.branch };
}

const JOURNAL_DIR = path.join(CONF_DIR, 'journal');
const JOURNAL_HOUR = 7;
let journalRunning = null;

function listJournal() {
  let files = [];
  try { files = fs.readdirSync(JOURNAL_DIR).filter((f) => /^\d{4}-\d\d-\d\d\.json$/.test(f)); } catch { return []; }
  return files.sort().reverse().slice(0, 120).map((f) => readJson(path.join(JOURNAL_DIR, f), null)).filter(Boolean);
}
function localDate(d) { return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; }

// One entry per calendar day: exactly midnight to midnight (or to now for "today so far"), headed with that day.
let journalChild = null, journalCancelled = false;
function dayStart(dateStr) { const [y, m, d] = dateStr.split('-').map(Number); return new Date(y, m - 1, d, 0, 0, 0, 0); }
async function writeJournal(trigger, date) {
  if (journalRunning) return { ok: false, error: 'already writing an entry' };
  date = date || localDate(new Date());
  if (!/^\d{4}-\d\d-\d\d$/.test(date)) return { ok: false, error: 'bad date' };
  const start = dayStart(date), end = new Date(start.getTime() + 86400000), until = end > new Date() ? new Date() : end;
  const label = `${start.getMonth() + 1}/${String(start.getDate()).padStart(2, '0')}`;
  const prompt = `${JOURNAL_SKILL}
This runs unattended for my dev journal, so adjust the skill:
- The day is ${start.toDateString()}. Window: from ${start.toString()} until ${until.toString()} (absolute; use these exact times with git --since/--until). Count only work inside this window: never include anything from the day before or after.
- Base it on GitHub history: my commits in that window, plus PRs I opened, merged or reviewed in that window (npx -y gh-axi).
- Header line is exactly ${label}.
- Do NOT ask me anything and do NOT run pbcopy. If you would have asked, put that question as a final line starting with "Missing:".
- If there was no work that day, output "${label}" then "No commits or PR activity."
- Output ONLY the finished standup text, nothing before or after it.`;
  journalRunning = { startedAt: Date.now(), trigger, date };
  journalCancelled = false;
  logAction({ op: 'journal', label: `writing ${date} (${trigger})` });
  const started = Date.now();
  const out = await new Promise((resolve) => {
    journalChild = execFile('claude', ['-p', prompt, '--output-format', 'text', '--allowedTools', 'Bash(git log:*),Bash(git config:*),Bash(git show:*),Bash(npx -y gh-axi:*),Read,Grep,Glob,Skill'],
      { cwd: MAIN || HOME, maxBuffer: 16 * 1024 * 1024, timeout: 20 * 60000 }, (err, stdout, stderr) => resolve({ err, text: String(stdout || '').trim(), stderr: String(stderr || '').trim() }));
    // no input is coming: an open stdin makes claude wait 3s and print a warning that used to read as a failure
    if (journalChild.stdin) journalChild.stdin.end();
  });
  journalChild = null; journalRunning = null;
  if (journalCancelled) { logAction({ op: 'journal', label: `cancelled ${date}` }); return { ok: false, cancelled: true }; }
  // the header is always this entry's own day, whatever the model wrote on the first line
  const body = out.text.replace(/^\s*\d{1,2}\/\d{1,2}\s*\n?/, '').trim();
  const entry = { date, since: start.getTime(), until: until.getTime(), partial: until < end, at: Date.now(), ms: Date.now() - started, trigger, text: body ? label + '\n' + body : '', error: out.err && !body ? (out.stderr || out.err.message).replace(/^Warning: no stdin data[^\n]*\n?/, '').slice(0, 2000) || 'no output' : '' };
  if (!entry.text && entry.error) { logAction({ op: 'journal', label: 'failed: ' + entry.error.slice(0, 120) }); return { ok: false, error: entry.error }; }
  fs.mkdirSync(JOURNAL_DIR, { recursive: true });
  fs.writeFileSync(path.join(JOURNAL_DIR, entry.date + '.json'), JSON.stringify(entry, null, 2));
  logAction({ op: 'journal', label: `entry for ${entry.date} written` });
  return { ok: true, entry };
}
// Days in the last week with no complete entry, oldest first (yesterday at the latest).
function missingDays() {
  // an entry only counts when it covers exactly its own day and its header names that day (older code got both wrong)
  const ok = (e) => { if (e.partial || !e.text) return false; const s0 = dayStart(e.date).getTime(); const lbl = `${new Date(s0).getMonth() + 1}/${String(new Date(s0).getDate()).padStart(2, '0')}`; return e.since === s0 && e.until === s0 + 86400000 && e.text.split('\n')[0].trim() === lbl; };
  const have = new Set(listJournal().filter(ok).map((e) => e.date)), out = [];
  for (let k = 7; k >= 1; k--) { const d = new Date(); d.setHours(12, 0, 0, 0); d.setDate(d.getDate() - k); const ds = localDate(d); if (!have.has(ds)) out.push(ds); }
  return out;
}
async function fillJournal(trigger) {
  for (const d of missingDays()) { const r = await writeJournal(trigger, d); if (r.cancelled) break; }
}

// Fires once a day at 7:00 local, or on the first check after 7:00 if the Mac was asleep: writes every missing day.
async function journalTick() {
  if (!settings.journalEnabled) return;
  // without its skill a run would only spend a Claude call on nothing; the Journal tab's buttons still work
  const js = JOURNAL_SKILL.replace(/^\//, '');
  if (!fs.existsSync(path.join(HOME, '.claude/skills', js, 'SKILL.md')) && !(MAIN && fs.existsSync(path.join(MAIN, '.claude/skills', js, 'SKILL.md')))) return;
  const now = new Date();
  if (now.getHours() < JOURNAL_HOUR) return;
  const today = localDate(now);
  // once a day at 7, plus a retry at most hourly while days are still missing (a failed or interrupted run)
  if (journalRunning) return;
  if (settings.journalLastRun === today && (!missingDays().length || Date.now() - (journalTick.lastTry || 0) < 3600000)) return;
  journalTick.lastTry = Date.now();
  settings = { ...settings, journalLastRun: today };
  try { fs.mkdirSync(CONF_DIR, { recursive: true }); fs.writeFileSync(SETTINGS_FILE, JSON.stringify(settings, null, 2)); } catch { /* retried tomorrow */ }
  await fillJournal('7am');
}

// ---------- http ----------

function send(res, code, body, type = 'application/json') {
  res.writeHead(code, { 'Content-Type': type, 'Cache-Control': 'no-store' });
  res.end(type === 'application/json' ? JSON.stringify(body) : body);
}

// Changes whenever pebtree itself is edited and restarted; an open page compares it and reloads itself.
const BUILD = String(Math.round(fs.statSync(__filename).mtimeMs));
function serialState(wantCoarse) {
  if (!state) return { loading: true };
  const { services, ...rest } = state;
  const all = [...services.values()].filter((s) => s.kind !== 'claude').map(publicService).sort((a, b) => treeCmp(a, b) || b.memMB - a.memMB);
  return { ...rest, hosts: hostsState(), presets: presets(), ids: idsMeta(), sims, servers: all, history: historyFor('1h'), ...(wantCoarse ? { coarse: historyFor('24h') } : {}), settings: { ...settings, lock: undefined }, lock: { enabled: lockOn(), minutes: lockMinutes(), set: !!(settings.lock && settings.lock.hash) }, actions: actionLog.slice().reverse(), slowUpdated: slow.updated, build: BUILD, prsAll: allPRs(), ghUser: ghUser(), decisions: readDecisions().filter((x) => x.status === 'open'), tickets: ticketsState() };
}

// How the page names every tree and session id it may show: "cbc-ditto 24" and which host it is on.
function idsMeta() {
  const out = {}, add = (id, host) => { if (out[id]) return; const h = HOSTS.get(host) || {}; out[id] = { label: idLabel(id), host, hostLabel: h.label || host, local: !!h.local, slot: String(id).split(':')[2] || '' }; };
  for (const t of slow.trees.values()) add(t.tree, t.host);
  if (state) for (const x of state.sessions) add(x.tree, x.host);
  return out;
}

// ---- lock: a passcode that pebtree's server enforces. While locked, every route except the page itself, the lock
// status and the unlock refuses with 423, so the lock cannot be bypassed from the browser. settings.lock holds only a
// salted scrypt hash. It locks after `minutes` with no activity from any open tab; lock.json keeps the state across restarts.
const LOCK_FILE = path.join(CONF_DIR, 'lock.json');
const LOCK = { locked: false, lastActivity: Date.now(), fails: [], ...readJson(LOCK_FILE, {}) };
function lockOn() { return !!(settings.lock && settings.lock.hash && settings.lock.enabled !== false); }
function lockMinutes() { return Math.min(240, Math.max(1, +((settings.lock && settings.lock.minutes) || 3))); }
function saveLock() { try { fs.writeFileSync(LOCK_FILE, JSON.stringify({ locked: LOCK.locked, lastActivity: LOCK.lastActivity }), { mode: 0o600 }); } catch { /* best effort */ } }
function passHash(pass, salt) { return crypto.scryptSync(String(pass), salt, 32).toString('hex'); }
function passOk(pass) { const L = settings.lock || {}; if (!L.hash || !L.salt) return false; const a = Buffer.from(passHash(pass, L.salt), 'hex'), b = Buffer.from(L.hash, 'hex'); return a.length === b.length && crypto.timingSafeEqual(a, b); }
function setLocked(v) { LOCK.locked = v; if (!v) LOCK.lastActivity = Date.now(); saveLock(); push({ type: v ? 'lock' : 'unlock' }); }
if (lockOn() && Date.now() - LOCK.lastActivity > lockMinutes() * 60000) LOCK.locked = true;
setInterval(() => { if (lockOn() && !LOCK.locked && Date.now() - LOCK.lastActivity > lockMinutes() * 60000) { setLocked(true); logAction({ op: 'lock', label: `locked after ${lockMinutes()} min idle` }); } }, 5000);
function saveSettings() { try { fs.mkdirSync(CONF_DIR, { recursive: true }); fs.writeFileSync(SETTINGS_FILE, JSON.stringify(settings, null, 2), { mode: 0o600 }); fs.chmodSync(SETTINGS_FILE, 0o600); } catch { /* best effort */ } }
async function readBody(req, max = 1e5) { let b = ''; for await (const c of req) { b += c; if (b.length > max) break; } try { return JSON.parse(b); } catch { return null; } }

const server = http.createServer(async (req, res) => {
  const host = (req.headers.host || '').split(':')[0];
  if (host !== 'localhost' && host !== '127.0.0.1') return send(res, 403, { error: 'host' });
  const url = new URL(req.url, 'http://localhost');
  if (req.method === 'GET' && url.pathname === '/') return send(res, 200, PAGE.replace('__TOKEN__', TOKEN).replace('__BUILD__', BUILD).replace('__UIPREFS__', JSON.stringify(uiPrefs).replace(/</g, '\\u003c')), 'text/html; charset=utf-8');
  if (req.method === 'GET' && url.pathname === '/api/lock') return send(res, 200, { enabled: lockOn(), locked: lockOn() && LOCK.locked, minutes: lockMinutes() });
  if (req.method === 'POST' && url.pathname === '/api/unlock') {
    const b = await readBody(req);
    if (!b || b.token !== TOKEN) return send(res, 403, { error: 'token' });
    const now = Date.now(); LOCK.fails = LOCK.fails.filter((t) => now - t < 60000);
    if (LOCK.fails.length >= 5) return send(res, 200, { ok: false, error: 'too many tries, wait a minute' });
    if (!lockOn() || passOk(b.passcode)) { setLocked(false); return send(res, 200, { ok: true }); }
    LOCK.fails.push(now); logAction({ op: 'lock', label: 'wrong passcode' });
    return send(res, 200, { ok: false, error: 'wrong passcode' });
  }
  if (lockOn() && LOCK.locked && url.pathname !== '/api/events') return send(res, 423, { locked: true, error: 'locked' });
  if (req.method === 'GET' && url.pathname === '/api/proof') return send(res, 200, { entries: listProof() });
  if (req.method === 'GET' && url.pathname.startsWith('/proof/')) return serveProofFile(res, url.pathname.slice(7));
  if (req.method === 'GET' && url.pathname === '/api/events') {
    res.writeHead(200, { 'Content-Type': 'text/event-stream', 'Cache-Control': 'no-cache', Connection: 'keep-alive' });
    res.write('retry: 1000\n\n'); streams.add(res);
    const ping = setInterval(() => { try { res.write(': ping\n\n'); } catch { /* closed */ } }, 20000);
    req.on('close', () => { clearInterval(ping); streams.delete(res); });
    return;
  }
  if (req.method === 'GET' && url.pathname.startsWith('/vendor/')) return serveVendor(res, url.pathname.slice(8));
  if (req.method === 'GET' && url.pathname === '/api/skills') { const t = slow.trees.get(url.searchParams.get('tree') || ''); return send(res, 200, { items: await (t ? HOSTS.get(t.host) || localHost() : localHost()).call('skills', { path: t ? t.path : MAIN }).catch(() => []) }); }
  if (req.method === 'GET' && url.pathname === '/api/live') return send(res, 200, await liveStatus(url.searchParams.get('tree') || ''));
  if (req.method === 'GET' && url.pathname === '/api/subchat') {
    const cs = state && state.sessions.find((x) => x.tree === url.searchParams.get('tree')), id = url.searchParams.get('id') || '';
    const base = cs && (cs.transcriptFile || (slow.trees.get(cs.tree) || {}).transcript && slow.trees.get(cs.tree).transcript.file);
    if (!base || !/^[\w-]+$/.test(id)) return send(res, 200, { items: [] });
    const f = base.replace(/\.jsonl$/, '') + '/subagents/' + id + '.jsonl';
    return send(res, 200, { items: await hostOf(cs).call('chat', { dir: cs.path, limit: 300, file: f, side: true }).catch(() => []) });
  }
  if (req.method === 'GET' && url.pathname === '/api/chat') {
    const cs = state && state.sessions.find((x) => x.tree === url.searchParams.get('tree'));
    if (!cs || !cs.path) return send(res, 200, { items: [] });
    return send(res, 200, { items: await hostOf(cs).call('chat', { dir: cs.path, limit: Math.min(200, +url.searchParams.get('limit') || 60), file: cs.transcriptFile }).catch(() => []) });
  }
  if (req.method === 'GET' && url.pathname === '/api/journal') return send(res, 200, { entries: listJournal(), running: journalRunning, missing: missingDays(), enabled: !!settings.journalEnabled, hour: JOURNAL_HOUR });
  if (req.method === 'GET' && url.pathname === '/api/state') return send(res, 200, serialState(url.searchParams.get('coarse') === '1'));
  // One file of a drop, uploaded by the page: written to <tree>/.pebtree-drops/<batch>/<its path inside the drop>.
  if (req.method === 'POST' && url.pathname === '/api/drop-file') {
    if (req.headers['x-pebtree-token'] !== TOKEN) return send(res, 403, { error: 'token' });
    const tid = url.searchParams.get('tree') || '', tt = slow.trees.get(tid);
    if (!tt || !tt.path || (tt.local && !fs.existsSync(tt.path))) return send(res, 400, { error: 'no such tree' });
    const batch = url.searchParams.get('batch') || '', rel = String(url.searchParams.get('rel') || '').replace(/^\/+/, '');
    if (!/^[\w-]{6,40}$/.test(batch) || !rel || rel.split('/').some((seg) => !seg || seg === '.' || seg === '..')) return send(res, 400, { error: 'bad path' });
    const root = path.join(tt.path, '.pebtree-drops'), dest = path.join(root, batch, rel);
    if (!dest.startsWith(path.join(root, batch) + path.sep)) return send(res, 400, { error: 'bad path' });
    let size = 0; const chunks = [];
    const max = tt.local ? 200 : 25; // a file for another host travels in the agent's JSON, so smaller
    for await (const c of req) { size += c.length; if (size > max * 1024 * 1024) return send(res, 413, { error: `a single file over ${max} MB` }); chunks.push(c); }
    if (!tt.local) { const r = await HOSTS.get(tt.host).call('putFile', { path: dest, b64: Buffer.concat(chunks).toString('base64') }, 120000).catch((e) => ({ ok: false, error: e.message })); return send(res, r.ok ? 200 : 500, r.ok ? { ok: true, path: dest, dir: path.join(root, batch) } : { error: r.error }); }
    fs.mkdirSync(path.dirname(dest), { recursive: true });
    if (!fs.existsSync(path.join(root, '.gitignore'))) fs.writeFileSync(path.join(root, '.gitignore'), '*\n');
    fs.writeFileSync(dest, Buffer.concat(chunks));
    return send(res, 200, { ok: true, path: dest, dir: path.join(root, batch) });
  }
  // Images you paste or drop into a reply are saved here and their path goes into the message for Claude to open.
  if (req.method === 'POST' && url.pathname === '/api/upload') {
    if (req.headers['x-pebtree-token'] !== TOKEN) return send(res, 403, { error: 'token' });
    const ext = ({ 'image/png': 'png', 'image/jpeg': 'jpg', 'image/gif': 'gif', 'image/webp': 'webp' })[String(req.headers['content-type'] || '').split(';')[0]];
    if (!ext) return send(res, 400, { error: 'png, jpg, gif or webp only' });
    const chunks = []; let size = 0;
    for await (const c of req) { size += c.length; if (size > 20 * 1024 * 1024) return send(res, 413, { error: 'images up to 20 MB' }); chunks.push(c); }
    // saved inside the session's own tree (git-ignored), like dropped files; pebtree's folder only when there is no tree
    const tid = String(req.headers['x-pebtree-tree'] || ''), tt = slow.trees.get(tid);
    if (tt && !tt.local) {
      // an image for a session on another host goes into its tree there, where that Claude can open it
      const f = path.join(tt.path, '.pebtree-drops', 'images', `${new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-')}-${crypto.randomBytes(3).toString('hex')}.${ext}`);
      const r = await HOSTS.get(tt.host).call('putFile', { path: f, b64: Buffer.concat(chunks).toString('base64') }, 60000).catch((e) => ({ ok: false, error: e.message }));
      return send(res, 200, r.ok ? { ok: true, path: f } : { ok: false, error: r.error });
    }
    let dir = path.join(CONF_DIR, 'uploads');
    if (tt && tt.path && fs.existsSync(tt.path)) { const root = path.join(tt.path, '.pebtree-drops'); dir = path.join(root, 'images'); if (!fs.existsSync(path.join(root, '.gitignore'))) { fs.mkdirSync(root, { recursive: true }); fs.writeFileSync(path.join(root, '.gitignore'), '*\n'); } }
    fs.mkdirSync(dir, { recursive: true });
    const f = path.join(dir, `${new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-')}-${crypto.randomBytes(3).toString('hex')}.${ext}`);
    fs.writeFileSync(f, Buffer.concat(chunks));
    return send(res, 200, { ok: true, path: f });
  }
  // Shows an image file named in a conversation, only from places sessions write screenshots to.
  if (req.method === 'GET' && url.pathname === '/api/img') {
    if (url.searchParams.get('t') !== TOKEN) return send(res, 403, { error: 'token' });
    // a path under another host's home is a file there (a screenshot a remote session took)
    const rp = url.searchParams.get('path') || '', rh = [...HOSTS.values()].find((h) => !h.local && h.home && rp.startsWith(h.home + '/'));
    if (rh) { const r = await rh.call('getFile', { path: rp }, 30000).catch(() => ({ ok: false })); if (!r.ok) return send(res, 404, { error: 'not found' }); res.writeHead(200, { 'Content-Type': r.type, 'Cache-Control': 'private, max-age=3600' }); return res.end(Buffer.from(r.b64, 'base64')); }
    let f; try { f = fs.realpathSync(tilde(rp)); } catch { return send(res, 404, { error: 'not found' }); }
    const types = { '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.gif': 'image/gif', '.webp': 'image/webp' }, type = types[path.extname(f).toLowerCase()];
    const roots = [CONF_DIR, '/private/tmp', '/tmp', path.join(HOME, '.claude'), path.join(HOME, 'Desktop'), path.join(HOME, 'Downloads'), path.join(HOME, '.treehouse'), ...LOCAL_TOPS, MAIN, POOL].filter(Boolean).map((r) => { try { return fs.realpathSync(r); } catch { return r; } });
    if (!type || !roots.some((r) => f === r || f.startsWith(r + path.sep))) return send(res, 403, { error: 'not an image in an allowed folder' });
    let st; try { st = fs.statSync(f); } catch { return send(res, 404, { error: 'not found' }); }
    if (!st.isFile() || st.size > 30 * 1024 * 1024) return send(res, 404, { error: 'not found' });
    res.writeHead(200, { 'Content-Type': type, 'Cache-Control': 'private, max-age=3600' }); return fs.createReadStream(f).pipe(res);
  }
  if (req.method === 'POST' && url.pathname === '/api/action') {
    let body = '';
    for await (const chunk of req) { body += chunk; if (body.length > 1e5) break; }
    let a; try { a = JSON.parse(body); } catch { return send(res, 400, { error: 'json' }); }
    if (a.token !== TOKEN) return send(res, 403, { error: 'token' });
    LOCK.lastActivity = Date.now();
    if (a.op === 'activity') { if (Math.random() < 0.2) saveLock(); return send(res, 200, { ok: true }); }
    if (a.op === 'lock-now') { if (!lockOn()) return send(res, 200, { ok: false, error: 'set a passcode first' }); setLocked(true); logAction({ op: 'lock', label: 'locked by hand' }); return send(res, 200, { ok: true }); }
    if (a.op === 'lock-set') {
      const L = settings.lock || {};
      if (L.hash && !passOk(a.current)) return send(res, 200, { ok: false, error: 'current passcode is wrong' });
      const minutes = Math.min(240, Math.max(1, +a.minutes || L.minutes || 3));
      if (a.remove) { settings = { ...settings, lock: undefined }; saveSettings(); logAction({ op: 'lock', label: 'passcode removed' }); return send(res, 200, { ok: true }); }
      let next = { ...L, minutes, enabled: a.enabled !== false };
      if (a.passcode) { if (String(a.passcode).length < 4) return send(res, 200, { ok: false, error: 'use at least 4 characters' }); const salt = crypto.randomBytes(16).toString('hex'); next = { ...next, salt, hash: passHash(a.passcode, salt) }; }
      if (!next.hash) return send(res, 200, { ok: false, error: 'set a passcode' });
      settings = { ...settings, lock: next }; saveSettings(); LOCK.lastActivity = Date.now(); saveLock();
      logAction({ op: 'lock', label: a.passcode ? 'passcode set' : `auto-lock after ${minutes} min` });
      return send(res, 200, { ok: true });
    }
    try {
      if (a.op === 'stop') return send(res, 200, await stopService(+a.id, typeof a.reason === 'string' ? a.reason.slice(0, 60) : 'manual'));
      if (a.op === 'stop-tree') {
        const ids = state ? [...state.services.values()].filter((x) => x.tree === String(a.tree) && KILLABLE.has(x.kind) && x.kind !== 'mcp').map((x) => x.id) : [];
        const results = [];
        for (const id of ids) results.push(await stopService(id, 'manual: stop everything in tree'));
        return send(res, 200, { ok: true, stopped: results.filter((r) => r.ok).length, freedMB: results.reduce((x, r) => x + (r.freedMB || 0), 0) });
      }
      if (a.op === 'max-trees') {
        const n = Math.floor(+a.value);
        const inUse = state ? state.pool.inUse : 0;
        if (!(n >= 1 && n <= 100)) return send(res, 200, { ok: false, error: 'Pick a number from 1 to 100.' });
        if (n < inUse) return send(res, 200, { ok: false, error: `${inUse} trees are in use right now, more than ${n}. Return ${inUse - n} of them first; nothing was changed.` });
        const before = readMaxTrees();
        writeMaxTrees(n);
        logAction({ op: 'max trees', label: `${before} -> ${n}` });
        return send(res, 200, { ok: true, max: n });
      }
      if (a.op === 'send') {
        const sess = state && state.sessions.find((x) => x.tree === String(a.tree));
        const text = String(a.text || '').replace(/\r/g, '').trim();
        if (!sess || !sess.tty) return send(res, 200, { ok: false, error: 'no terminal found for that session' });
        if (!text || text.length > 8000) return send(res, 200, { ok: false, error: 'empty or too long' });
        // Typed into an open menu, the text is ignored and Enter picks the highlighted option (usually 1).
        const menu = parseMenu(await screenOf(sess));
        if (menu) {
          const free = menu.options.find((o) => o.free);
          if (free && !text.startsWith('/')) return send(res, 200, await pickMenu(sess.tree, free.n, text, menu.sig));
          return send(res, 200, { ok: false, error: `Not sent: that tab is showing a ${menu.kind === 'permission' ? 'permission prompt' : 'choice'}. Pick an option first.` });
        }
        const out = String(await hostOf(sess).call('write', { target: targetOf(sess), text }, 20000).catch(() => ''));
        if (out.trim() === 'ok' && !text.startsWith('/')) { if (!PENDING.has(sess.tree)) PENDING.set(sess.tree, []); PENDING.get(sess.tree).push({ text, at: Date.now() }); }
        logAction({ op: text.startsWith('/remote-control') ? 'remote' : 'reply', tree: sess.tree, label: text.slice(0, 80) });
        return send(res, 200, out.trim() === 'ok' ? { ok: true } : { ok: false, error: `its terminal is gone${sess.local ? '' : ` (or ${sess.hostLabel} is unreachable)`}` });
      }
      if (a.op === 'spawn') {
        const h = HOSTS.get(String(a.host || LOCAL_HOST));
        if (!h) return send(res, 200, { ok: false, error: 'no such host' });
        const r = await h.call('spawn', { kind: a.kind, repo: a.repo, prompt: a.prompt, title: a.title, session: a.session, cmd: a.cmd }, 600000).catch((e) => ({ ok: false, error: e.message }));
        if (r.ok) logAction({ op: 'new', label: `${h.label}: ${r.session}` });
        return send(res, 200, { ...r, host: h.id });
      }
      // pick a stale tree back up: its tmux session if one is left, else Claude --continue in it
      if (a.op === 'resume-tree') {
        const t = slow.trees.get(String(a.tree || '')), h = t && HOSTS.get(t.host);
        if (!t || !h || !/^\d+$/.test(t.slot)) return send(res, 200, { ok: false, error: 'no such tree' });
        const r = await h.call('spawn', { kind: 'resume', repo: t.path }, 60000).catch((e) => ({ ok: false, error: e.message }));
        if (r.ok) logAction({ op: 'resume', tree: t.tree, label: r.existed ? `reattached ${r.session}` : `Claude --continue in ${r.session}` });
        return send(res, 200, { ...r, host: h.id });
      }
      if (a.op === 'kill-term') {
        const h = HOSTS.get(String(a.host || ''));
        if (!h) return send(res, 200, { ok: false, error: 'no such host' });
        const r = await h.call('kill', { session: String(a.session || '') }).catch((e) => ({ ok: false, error: e.message }));
        if (r.ok) logAction({ op: 'end', label: `${h.label}: ${a.session}` });
        return send(res, 200, r);
      }
      if (a.op === 'uiprefs') {
        for (const [k, v] of Object.entries(a.set || {})) {
          if (!/^(treehouse|devdeck)-[\w:.-]{1,80}$/.test(k)) continue;
          if (v === null || v === '') delete uiPrefs[k]; else if (typeof v === 'string' && v.length <= 20000) uiPrefs[k] = v;
        }
        try { fs.mkdirSync(CONF_DIR, { recursive: true }); fs.writeFileSync(UI_FILE, JSON.stringify(uiPrefs, null, 1)); } catch { /* best effort */ }
        return send(res, 200, { ok: true });
      }
      if (a.op === 'menu') return send(res, 200, await pickMenu(String(a.tree), a.n, a.text, a.sig));
      if (a.op === 'answer') return send(res, 200, await answerAsk(String(a.tree), a.answers));
      if (a.op === 'spinoff') return send(res, 200, await spinoff({ task: a.task, title: a.title, from: a.from, host: a.host, repo: a.repo }));
      if (a.op === 'captain-start') return send(res, 200, await startCaptain(a.objectives));
      if (a.op === 'ticket-status') { if (!['new', 'triaged', 'in_progress', 'done', 'wont_do'].includes(a.status)) return send(res, 200, { ok: false, error: 'bad status' }); try { const t = await tkPatch(String(a.id), { status: a.status }); logAction({ op: 'ticket', label: `"${String(t.title).slice(0, 40)}" -> ${a.status}` }); return send(res, 200, { ok: true, ticket: t }); } catch (e) { return send(res, 200, { ok: false, error: e.message }); } }
      if (a.op === 'ticket-notes') { try { const t = await tkPatch(String(a.id), { notes: String(a.notes || '').slice(0, 4000) }); return send(res, 200, { ok: true, ticket: t }); } catch (e) { return send(res, 200, { ok: false, error: e.message }); } }
      if (a.op === 'ticket-start') return send(res, 200, await startTicket(String(a.id)));
      if (a.op === 'drops-delete') return send(res, 200, await deleteDrops(String(a.tree), String(a.id || '')));
      if (a.op === 'sim-reload') {
        const port = +a.port;
        if (!(port > 1023 && port < 65536)) return send(res, 200, { ok: false, error: 'no Metro port' });
        const r = await metroReload(port);
        if (r.ok) logAction({ op: 'sim-reload', tree: String(a.tree || ''), label: 'reloaded the app on Metro :' + port });
        return send(res, 200, r);
      }
      if (a.op === 'path-open') {
        // a path from the chat: show it in Finder (reveal) or open it with its default app
        let f = String(a.path || '').trim().replace(/^~(?=\/)/, HOME).replace(/[.,;:!?)]+$/, '');
        if (!f.startsWith('/')) return send(res, 200, { ok: false, error: 'not a full path' });
        const rh = [...HOSTS.values()].find((h) => !h.local && h.home && f.startsWith(h.home + '/'));
        if (rh) return send(res, 200, { ok: false, error: `that is on ${rh.label}; copy the path instead` });
        while (f.length > 1 && !fs.existsSync(f)) f = path.dirname(f); // a path to something gone: show the nearest folder that exists
        await run('open', a.reveal ? ['-R', f] : [f]);
        return send(res, 200, { ok: true, path: f });
      }
      if (a.op === 'drops-reveal') {
        const t = slow.trees.get(String(a.tree)), id = String(a.id || '');
        if (!t || !t.path || !/^[\w-]{3,60}$/.test(id)) return send(res, 200, { ok: false, error: 'no such drop' });
        if (!t.local) return send(res, 200, { ok: false, error: `that drop is on ${(HOSTS.get(t.host) || {}).label}` });
        const dir = path.join(t.path, '.pebtree-drops', id);
        if (!fs.existsSync(dir)) return send(res, 200, { ok: false, error: 'that drop is gone' });
        // select the dropped item itself when there is one, else open the drop's folder
        const inside = fs.readdirSync(dir).filter((x) => x !== '.DS_Store');
        await run('open', inside.length === 1 ? ['-R', path.join(dir, inside[0])] : [dir]);
        return send(res, 200, { ok: true });
      }
      if (a.op === 'ticket-refresh') { await pollTickets(); return send(res, 200, { ok: !tkError, error: tkError }); }
      if (a.op === 'close-preview') return send(res, 200, await closePreview(String(a.tree)));
      if (a.op === 'close-tree') return send(res, 200, await closeTree(String(a.tree), !!a.discard));
      if (a.op === 'rename') {
        const sess = state && state.sessions.find((x) => x.tree === String(a.tree));
        const name = String(a.name || '').replace(/[\u0000-\u001f\u007f]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 60);
        if (!sess || !sess.pid) return send(res, 200, { ok: false, error: 'no Claude session in that tree' });
        if (!name) return send(res, 200, { ok: false, error: 'name is empty' });
        // names are kept per Claude process (<host>:<pid>), so a new session in the tree starts fresh
        const live = new Set(state.sessions.map((x) => `${x.host}:${x.pid}`));
        customTitles = Object.fromEntries(Object.entries(customTitles).filter(([k]) => live.has(k)));
        customTitles[`${sess.host}:${sess.pid}`] = { name, at: Date.now() };
        try { fs.mkdirSync(CONF_DIR, { recursive: true }); fs.writeFileSync(TITLES_FILE, JSON.stringify(customTitles, null, 2)); } catch { /* best effort */ }
        // /rename runs immediately in Claude Code, even mid-task, and its title then drives the tab name
        const out = sess.tty ? String(await hostOf(sess).call('write', { target: targetOf(sess), text: `/rename ${name}` }).catch(() => '')) : '';
        logAction({ op: 'rename', tree: sess.tree, label: name });
        return send(res, 200, { ok: true, tab: out.trim() === 'ok', tabNamed: sess.tabNamed });
      }
      if (a.op === 'focus') {
        const sess = state && state.sessions.find((x) => x.tree === String(a.tree));
        if (!sess || !sess.tty) return send(res, 200, { ok: false, error: 'no terminal found for that session' });
        if (sess.term === 'tmux') return send(res, 200, { ok: true, term: { host: sess.host, session: sess.tmuxSession } }); // the page opens its own terminal
        const script = `tell application "iTerm2"
  activate
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if tty of s is "/dev/${sess.ttyName}" then
          select w
          select t
          select s
          return "ok"
        end if
      end repeat
    end repeat
  end repeat
end tell`;
        const out = await run('osascript', ['-e', script]);
        // macOS ignores AppleScript "activate" from a background process; LaunchServices still brings iTerm forward
        if (out.trim() === 'ok') await run('open', ['-b', 'com.googlecode.iterm2']);
        return send(res, 200, out.trim() === 'ok' ? { ok: true } : { ok: false, error: 'tab not found in iTerm' });
      }
      if (a.op === 'throttle' || a.op === 'unthrottle') return send(res, 200, await setThrottle(+a.id, a.op === 'throttle'));
      if (a.op === 'cleanup-preview') return send(res, 200, { ok: true, candidates: cleanupCandidates(a.mode, +a.minutes || 30) });
      if (a.op === 'cleanup') {
        const ids = cleanupCandidates(a.mode, +a.minutes || 30).map((s) => s.id).filter((id) => (a.ids || []).includes(id));
        const results = [];
        for (const id of ids) results.push(await stopService(id, a.mode === 'orphans' ? 'cleanup: orphan' : `cleanup: idle ${a.minutes} min`));
        return send(res, 200, { ok: true, stopped: results.filter((r) => r.ok).length, freedMB: results.reduce((x, r) => x + (r.freedMB || 0), 0) });
      }
      if (a.op === 'journal-now') { writeJournal('manual'); return send(res, 200, { ok: true }); }
      if (a.op === 'journal-day') { writeJournal('manual', String(a.date)); return send(res, 200, { ok: true }); }
      if (a.op === 'journal-fill') { fillJournal('manual'); return send(res, 200, { ok: true, days: missingDays() }); }
      if (a.op === 'journal-cancel') { if (journalChild) { journalCancelled = true; journalChild.kill('SIGTERM'); } return send(res, 200, { ok: true }); }
      if (a.op === 'journal-delete') {
        const d = String(a.date || '');
        if (!/^\d{4}-\d\d-\d\d$/.test(d)) return send(res, 200, { ok: false, error: 'bad date' });
        try { fs.unlinkSync(path.join(JOURNAL_DIR, d + '.json')); } catch { return send(res, 200, { ok: false, error: 'no entry for ' + d }); }
        logAction({ op: 'journal', label: `deleted ${d}` });
        return send(res, 200, { ok: true });
      }
      if (a.op === 'journal-toggle') {
        settings = { ...settings, journalEnabled: !!a.enabled };
        fs.mkdirSync(CONF_DIR, { recursive: true });
        fs.writeFileSync(SETTINGS_FILE, JSON.stringify(settings, null, 2));
        return send(res, 200, { ok: true });
      }
      if (a.op === 'settings') {
        settings = { ...settings, autoStopIdleMinutes: Math.max(0, +a.autoStopIdleMinutes || 0), serverBudget: Math.max(0, +a.serverBudget || 0) };
        fs.mkdirSync(CONF_DIR, { recursive: true });
        fs.writeFileSync(SETTINGS_FILE, JSON.stringify(settings, null, 2));
        logAction({ op: 'settings', label: `auto-stop idle ${settings.autoStopIdleMinutes || 'off'} min, budget ${settings.serverBudget}` });
        return send(res, 200, { ok: true, settings });
      }
      return send(res, 400, { error: 'unknown op' });
    } catch (e) { return send(res, 500, { error: String(e.message || e) }); }
  }
  send(res, 404, { error: 'not found' });
});

// ---- terminals in the page: xterm.js on a WebSocket, attached to a tmux session here or on another host.
// xterm.js comes from jsDelivr once, is checked against these hashes, and is kept in ~/.config/pebtree/vendor.
const VENDOR = {
  'xterm.js': ['https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/lib/xterm.js', 'text/javascript', '1f991ac3b4b283ebf96e60ae23a00a52765dd3a2e46fa6fdda9f1aab032f7495'],
  'xterm.css': ['https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/css/xterm.css', 'text/css', 'ba8e6985669488981ccf40c0cefe3aba80722cb6c92de7ad628b0bd717faf2b6'],
  'xterm-fit.js': ['https://cdn.jsdelivr.net/npm/@xterm/addon-fit@0.10.0/lib/addon-fit.js', 'text/javascript', 'bdaefa370b1bfc42ee88d46fe6072400902a4d4b2d45cd93438dda9b23c97089'],
};
async function serveVendor(res, name) {
  const v = VENDOR[name];
  if (!v) return send(res, 404, { error: 'not found' });
  const f = path.join(CONF_DIR, 'vendor', name);
  if (!fs.existsSync(f)) {
    try {
      const r = await fetch(v[0]); if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const body = Buffer.from(await r.arrayBuffer());
      if (crypto.createHash('sha256').update(body).digest('hex') !== v[2]) throw new Error('it does not match the pinned hash');
      fs.mkdirSync(path.dirname(f), { recursive: true }); fs.writeFileSync(f, body);
    } catch (e) { return send(res, 502, { error: `could not fetch ${name}: ${e.message}` }); }
  }
  res.writeHead(200, { 'Content-Type': `${v[1]}; charset=utf-8`, 'Cache-Control': 'private, max-age=86400' });
  fs.createReadStream(f).pipe(res);
}

// A pty for `tmux attach` (Node has none built in): forks the command on a pty, copies bytes both ways, and takes
// "<cols> <rows>" lines on fd 3 to resize it. Closing its stdin hangs up the client, which only detaches from tmux.
const PTY_PY = String.raw`
import os, pty, sys, select, fcntl, termios, struct, signal
cols, rows, argv = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3:]
pid, fd = pty.fork()
if pid == 0:
    try:
        os.execvp(argv[0], argv)
    except Exception as e:
        sys.stderr.write('pebtree: %s: %s\r\n' % (argv[0], e))
        os._exit(127)
def size(c, r):
    try:
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', r, c, 0, 0))
    except OSError:
        pass
def put(f, d):
    while d:
        d = d[os.write(f, d):]
size(cols, rows)
fds, buf = [0, fd, 3], b''
while True:
    try:
        r = select.select(fds, [], [])[0]
    except InterruptedError:
        continue
    if fd in r:
        try:
            d = os.read(fd, 65536)
        except OSError:
            d = b''
        if not d:
            break
        put(1, d)
    if 0 in r:
        d = os.read(0, 65536)
        if d:
            put(fd, d)
        else:
            fds.remove(0)
            os.kill(pid, signal.SIGHUP)
    if 3 in r:
        d = os.read(3, 4096)
        if not d:
            fds.remove(3)
            continue
        buf += d
        while b'\n' in buf:
            line, buf = buf.split(b'\n', 1)
            try:
                c, rr = [int(x) for x in line.split()]
            except ValueError:
                continue
            size(c, rr)
            try:
                os.kill(pid, signal.SIGWINCH)
            except OSError:
                pass
try:
    st = os.waitpid(pid, 0)[1]
except ChildProcessError:
    st = 0
sys.exit(os.WEXITSTATUS(st) if os.WIFEXITED(st) else 1)
`;

// The few WebSocket frames a terminal needs (RFC 6455): client frames arrive masked, ours go unmasked.
function wsSend(socket, data, op = 2) {
  const len = data.length;
  let head;
  if (len < 126) head = Buffer.from([0x80 | op, len]);
  else if (len < 65536) { head = Buffer.alloc(4); head[0] = 0x80 | op; head[1] = 126; head.writeUInt16BE(len, 2); }
  else { head = Buffer.alloc(10); head[0] = 0x80 | op; head[1] = 127; head.writeBigUInt64BE(BigInt(len), 2); }
  socket.write(Buffer.concat([head, data]));
}
function wsReader(onMessage, onClose, onPing) {
  let buf = Buffer.alloc(0), parts = [], partOp = 0;
  return (chunk) => {
    buf = Buffer.concat([buf, chunk]);
    for (;;) {
      if (buf.length < 2) return;
      const fin = buf[0] & 0x80, op = buf[0] & 0x0f, masked = buf[1] & 0x80;
      let len = buf[1] & 0x7f, off = 2;
      if (len === 126) { if (buf.length < 4) return; len = buf.readUInt16BE(2); off = 4; }
      else if (len === 127) { if (buf.length < 10) return; len = Number(buf.readBigUInt64BE(2)); off = 10; }
      if (len > 4 * 1024 * 1024) return onClose();
      const maskAt = off; if (masked) off += 4;
      if (buf.length < off + len) return;
      let data = Buffer.from(buf.subarray(off, off + len));
      if (masked) for (let i = 0; i < data.length; i++) data[i] ^= buf[maskAt + (i & 3)];
      buf = buf.subarray(off + len);
      if (op === 8) return onClose();
      if (op === 9) { onPing(data); continue; }
      if (op === 0 || op === 1 || op === 2) {
        if (op) partOp = op;
        parts.push(data);
        if (fin) { const msg = Buffer.concat(parts); parts = []; onMessage(msg, partOp); }
      }
    }
  };
}
const TERMS = new Set();
function openTerminal(socket, h, session, cols, rows) {
  const attach = ['tmux', '-u', 'attach-session', '-t', `=${session}`];
  const cmd = h.local ? attach : ['ssh', '-tt', ...sshOpts.filter((o, i, a) => o !== 'BatchMode=yes' && a[i + 1] !== 'BatchMode=yes'), h.ssh, attach.join(' ')];
  const py = spawn('python3', ['-c', PTY_PY, String(cols), String(rows), ...cmd], { stdio: ['pipe', 'pipe', 'pipe', 'pipe'], env: { ...process.env, TERM: 'xterm-256color', COLORTERM: 'truecolor' } });
  const t = { host: h.id, session, at: Date.now() };
  TERMS.add(t);
  let closed = false;
  const end = () => {
    if (closed) return; closed = true; TERMS.delete(t);
    try { py.stdin.end(); } catch { /* gone */ }
    setTimeout(() => { try { py.kill('SIGHUP'); } catch { /* gone */ } }, 1500).unref();
    try { wsSend(socket, Buffer.alloc(0), 8); socket.end(); } catch { /* gone */ }
  };
  const out = (d) => { try { wsSend(socket, d, 2); } catch { end(); } };
  py.stdout.on('data', out); py.stderr.on('data', out);
  py.on('exit', (code) => { try { wsSend(socket, Buffer.from(JSON.stringify({ exit: code })), 1); } catch { /* gone */ } end(); });
  py.on('error', (e) => { out(Buffer.from(`\r\n[pebtree] could not start a terminal (python3 is needed): ${e.message}\r\n`)); end(); });
  for (const s of [py.stdin, py.stdio[3]]) s.on('error', () => {});
  socket.on('data', wsReader((msg, op) => {
    if (op === 2) { py.stdin.write(msg); return; }
    let m; try { m = JSON.parse(msg.toString('utf8')); } catch { return; }
    if (typeof m.i === 'string') py.stdin.write(m.i);
    if (Array.isArray(m.r)) py.stdio[3].write(`${Math.max(10, m.r[0] | 0)} ${Math.max(4, m.r[1] | 0)}\n`);
  }, end, (data) => { try { wsSend(socket, data, 10); } catch { /* gone */ } }));
  socket.on('close', end); socket.on('error', end);
}
server.on('upgrade', (req, socket) => {
  const url = new URL(req.url, 'http://localhost'), host = (req.headers.host || '').split(':')[0], origin = req.headers.origin || '';
  const deny = (why) => { try { socket.end(`HTTP/1.1 403 Forbidden\r\nContent-Type: text/plain\r\n\r\n${why}`); } catch { /* gone */ } };
  if (host !== 'localhost' && host !== '127.0.0.1') return deny('host');
  // only this page: a page on another site sends its own Origin, and does not have the token
  if (origin && !/^http:\/\/(localhost|127\.0\.0\.1)(:\d+)?$/.test(origin)) return deny('origin');
  if (url.pathname !== '/api/term' || url.searchParams.get('t') !== TOKEN) return deny('token');
  if (lockOn() && LOCK.locked) return deny('locked');
  const h = HOSTS.get(url.searchParams.get('host') || ''), session = url.searchParams.get('session') || '', key = req.headers['sec-websocket-key'];
  if (!h || !SAFE_NAME.test(session) || !key) return deny('bad request');
  socket.write(['HTTP/1.1 101 Switching Protocols', 'Upgrade: websocket', 'Connection: Upgrade', `Sec-WebSocket-Accept: ${crypto.createHash('sha1').update(key + '258EAFA5-E914-47DA-95CA-C5AB0DC85B11').digest('base64')}`, '', ''].join('\r\n'));
  socket.setNoDelay(true);
  LOCK.lastActivity = Date.now();
  openTerminal(socket, h, session, +url.searchParams.get('cols') || 120, +url.searchParams.get('rows') || 36);
});

async function loop(fn, ms) {
  for (;;) {
    const t = Date.now();
    try { await fn(); } catch (e) { console.error(`[pebtree] ${fn.name}: ${e.message}`); }
    await sleep(Math.max(500, ms - (Date.now() - t)));
  }
}

// ---- setup: `pebtree init` writes config.json for this machine, `pebtree doctor` checks every dependency
function sh(cmd, args, cwd) { try { return require('child_process').execFileSync(cmd, args, { cwd, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'], timeout: 20000 }).trim(); } catch { return null; } }
function initCli(argv) {
  const arg = (k) => { const i = argv.indexOf(k); return i >= 0 ? argv[i + 1] : undefined; };
  const main = path.resolve(tilde(arg('--main') || process.cwd()));
  const top = sh('git', ['-C', main, 'rev-parse', '--show-toplevel']);
  if (!top) { console.error(`${main} is not a git checkout. Run this from your project's main checkout, or pass --main <path>.`); process.exit(1); }
  let pool = arg('--pool');
  if (!pool) { const st = sh('treehouse', ['status'], top) || ''; const m = st.match(/^\d+\s+\S+\s+(\S+)/m); if (m) pool = path.dirname(path.dirname(tilde(m[1]))); }
  const cfg = { ...CONFIG, main: top.replace(HOME, '~'), pool: pool ? path.resolve(tilde(pool)).replace(HOME, '~') : undefined, repoDir: arg('--repo-dir') || path.basename(top) };
  if (arg('--teardown')) cfg.teardown = arg('--teardown');
  if (arg('--journal-skill')) cfg.journalSkill = arg('--journal-skill');
  fs.mkdirSync(CONF_DIR, { recursive: true }); fs.writeFileSync(CONFIG_FILE, JSON.stringify(cfg, null, 2) + '\n');
  console.log(`Wrote ${CONFIG_FILE}:\n${JSON.stringify(cfg, null, 2)}\n`);
  if (!pool) console.log('No treehouse pool found yet (treehouse status listed no trees). Create one tree, then run `pebtree init` again, or pass --pool <dir>.\n');
  console.log('Next: `pebtree doctor` to check the rest of the setup.');
}
function doctorCli() {
  let bad = 0; const ok = (good, what, fix) => { console.log(`${good ? '  ok ' : ' FAIL'}  ${what}${good || !fix ? '' : `\n         fix: ${fix}`}`); if (!good) bad++; };
  const which = (b) => sh('/bin/sh', ['-c', `command -v ${b}`]);
  console.log(`pebtree doctor (config: ${fs.existsSync(CONFIG_FILE) ? CONFIG_FILE : 'none, using defaults'})\n`);
  ok(process.platform === 'darwin', 'macOS', 'the dashboard reads macOS memory stats; other machines join as hosts (config.json "hosts")');
  ok(+process.versions.node.split('.')[0] >= 18, `Node ${process.versions.node} (18 or newer)`, 'brew install node');
  ok(!!which('tmux'), 'tmux (sessions pebtree starts run in it)', 'brew install tmux');
  ok(!!which('python3'), 'python3 (gives the page\'s terminals a pty)', 'xcode-select --install');
  if (fs.existsSync('/Applications/iTerm.app')) ok(sh('osascript', ['-e', 'tell application "iTerm2" to count windows']) !== null, 'allowed to script iTerm2, for sessions still in iTerm tabs (Automation permission)', 'System Settings > Privacy & Security > Automation: allow your terminal to control iTerm2, then rerun');
  else console.log('  --    iTerm2: not installed (only sessions in tmux are followed)');
  ok(!!which('claude'), 'Claude Code CLI on PATH', 'npm i -g @anthropic-ai/claude-code');
  ok(fs.existsSync(path.join(HOME, '.claude/projects')), '~/.claude/projects (session transcripts)', 'start one Claude Code session so it is created');
  ok(!!which('treehouse'), 'treehouse CLI on PATH', 'install treehouse (the git worktree pool manager pebtree is built around)');
  ok(!!which('gh') && sh('gh', ['auth', 'status']) !== null, 'gh, logged in (PR status for every repo)', 'brew install gh && gh auth login');
  for (const h of HOSTS.values()) {
    if (h.local) continue;
    const r = sh('ssh', [...sshOpts, h.ssh, 'PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:$PATH"; command -v node tmux treehouse claude; node -v']) || '';
    ok(/node/.test(r) && /tmux/.test(r), `host ${h.id} (ssh ${h.ssh}): node and tmux${/treehouse/.test(r) ? ', treehouse' : ''}${/claude/.test(r) ? ', claude' : ''}`, r ? 'install node 18+ and tmux there' : `\`ssh ${h.ssh}\` must work without a prompt (a key in the agent or keychain)`);
  }
  if (MAIN) ok(!!sh('git', ['-C', MAIN, 'rev-parse', '--git-dir']), `main checkout ${MAIN} (journal, captain)`, 'pebtree init --main <your repo checkout>, or remove "main" from config.json');
  const td = TEARDOWN && TEARDOWN.split(/\s+/)[0];
  ok(!td || !!which(td), `teardown command: ${TEARDOWN || '(none)'}`, 'put it on PATH, or set "teardown" in config.json ("" to skip)');
  if (TK.url || TK.key) {
    ok(!!(TK.url && TK.key), 'tickets: url and key in config.json', 'set "tickets": { "url": "https://your-app.example.com", "key": "<PEBTREE_API_KEY>" }');
    if (TK.url && TK.key) { let code = null; try { code = require('child_process').execFileSync('curl', ['-s', '-o', '/dev/null', '-w', '%{http_code}', '-m', '15', '-H', '@-', `${TK.url}/api/engineering/tickets?limit=1`], { input: `Authorization: Bearer ${TK.key}\n`, encoding: 'utf8', timeout: 20000 }).trim(); } catch { /* no answer: the key goes in on stdin, never on the command line */ } ok(code === '200', `tickets API answers (${code || 'no response'})`, code === '401' ? 'the key does not match PEBTREE_API_KEY on the server' : code === '503' ? 'the server has no PEBTREE_API_KEY yet: set it and redeploy' : /^30/.test(code || '') ? 'the url redirects (a redirect drops the key): use the address it redirects to (often the www. one)' : 'check the url, and that PEBTREE_API_KEY is set on the server'); }
  } else console.log('  --    tickets: not set up (optional: "tickets" in config.json, see docs/pebtree.md)');
  const js = JOURNAL_SKILL.replace(/^\//, '');
  ok(fs.existsSync(path.join(HOME, '.claude/skills', js, 'SKILL.md')) || fs.existsSync(path.join(MAIN, '.claude/skills', js, 'SKILL.md')), `journal skill ${JOURNAL_SKILL}`, 'install it (see docs/pebtree.md), or set "journalSkill"; only the Journal tab needs it');
  for (const k of ['send-proof', 'spinoff']) ok(fs.existsSync(path.join(HOME, '.claude/skills', k, 'SKILL.md')), `optional skill ${k}`, `copy skills/${k} from this repo into ~/.claude/skills/`);
  console.log(bad ? `\n${bad} problem(s). pebtree still runs; the parts that depend on them will be empty.` : '\nAll good. Run `pebtree` and open http://localhost:' + PORT);
  process.exit(bad ? 1 : 0);
}
// `pebtree tickets-key [url]`: takes the API key from the clipboard and writes it into config.json, never printing it
function ticketsKeyCli(argv) {
  const key = (sh('pbpaste', []) || '').trim();
  if (!/^[\x21-\x7e]{32,}$/.test(key)) { console.error('Copy the PEBTREE_API_KEY value first (at least 32 characters, no spaces), then run this again.'); process.exit(1); }
  const url = (argv[0] || (CONFIG.tickets && CONFIG.tickets.url) || '').replace(/\/+$/, '');
  if (!url) { console.error('Give the API base URL: pebtree tickets-key https://your-app.example.com'); process.exit(1); }
  const cfg = { ...CONFIG, tickets: { url, key } };
  fs.mkdirSync(CONF_DIR, { recursive: true }); fs.writeFileSync(CONFIG_FILE, JSON.stringify(cfg, null, 2) + '\n', { mode: 0o600 }); fs.chmodSync(CONFIG_FILE, 0o600);
  console.log(`Saved the tickets key (${key.length} characters, ending ...${key.slice(-4)}) and url ${url} to ${CONFIG_FILE} (owner-only).`);
  console.log('Restart pebtree to use it, then run `pebtree doctor` to check the API accepts it. You can clear your clipboard now.');
}
// `pebtree new <preset>` or `pebtree new <host> <kind> [repo] [--prompt "..."]`: starts it through the running dashboard
// (which holds the ssh connections), then attaches this terminal to it, the way `tw` did.
async function newCli(argv) {
  const pos = [], opt = { prompt: '', attach: true };
  for (let i = 0; i < argv.length; i++) { if (argv[i] === '--prompt') opt.prompt = argv[++i] || ''; else if (argv[i] === '--no-attach') opt.attach = false; else pos.push(argv[i]); }
  const pre = presets().find((p) => p.id === pos[0]);
  const spec = pre ? { ...pre } : { host: pos[0], kind: pos[1], repo: pos[2] || '~' };
  if (!spec.host || !spec.kind) {
    console.log(`usage: pebtree new <preset> [--prompt "..."]      presets: ${presets().map((p) => p.id).join(', ') || '(none in config.json)'}\n       pebtree new <host> <tree|claude|codex|shell> [repo] [--prompt "..."] [--no-attach]      hosts: ${[...HOSTS.keys()].join(', ')}`);
    process.exit(1);
  }
  let r;
  try { r = await (await fetch(`http://127.0.0.1:${PORT}/api/action`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...spec, op: 'spawn', prompt: opt.prompt || spec.prompt || '', token: fs.readFileSync(path.join(CONF_DIR, 'token'), 'utf8').trim() }) })).json(); }
  catch { console.error(`pebtree is not running (start it with \`pebtree\`)`); process.exit(1); }
  if (!r.ok) { console.error(`pebtree new: ${r.error}`); process.exit(1); }
  console.log(`${r.existed ? 'attaching to' : 'started'} ${r.session} on ${(HOSTS.get(spec.host) || {}).label || spec.host}${r.path ? ` in ${r.path}` : ''}`);
  if (!opt.attach || !process.stdout.isTTY) process.exit(0);
  const h = HOSTS.get(spec.host), attach = ['tmux', '-u', 'attach-session', '-t', `=${r.session}`];
  const c = h && !h.local ? spawn('ssh', ['-t', h.ssh, attach.join(' ')], { stdio: 'inherit' }) : spawn(attach[0], attach.slice(1), { stdio: 'inherit' });
  c.on('exit', (code) => process.exit(code || 0));
}
if (AGENT) agentMain();
else if (process.argv[2] === 'new') newCli(process.argv.slice(3));
else if (process.argv[2] === 'tickets-key') ticketsKeyCli(process.argv.slice(3));
else if (process.argv[2] === 'init') initCli(process.argv.slice(3));
else if (process.argv[2] === 'doctor') doctorCli();
else if (process.argv[2] === 'proof') proofCli(process.argv.slice(3));
else if (process.argv[2] === 'spinoff') spinoffCli(process.argv.slice(3));
else (async () => {
  for (const h of HOSTS.values()) if (!h.local) hostLoop(h);
  loop(journalTick, 60000);
  await refreshSlow().catch((e) => console.error(e));
  loop(refreshFast, FAST_MS);
  setTimeout(() => loop(refreshSims, 8000), 2000);
  setTimeout(() => loop(refreshDevices, 8000), 3000);
  setTimeout(() => loop(refreshPRs, 60000), 5000);
  setTimeout(() => loop(pollTickets, 60000), 3000);
  setTimeout(() => loop(refreshMenus, 2000), 2500);
  setTimeout(() => loop(refreshSlow, SLOW_MS), SLOW_MS);
  server.on('error', (e) => { console.error(e.code === 'EADDRINUSE' ? `pebtree: port ${PORT} is taken (already running? open http://localhost:${PORT})` : e.message); process.exit(1); });
  // On kill, stop taking connections but let requests already running finish, so a restart never cuts an action in half.
  for (const sig of ['SIGTERM', 'SIGINT']) process.on(sig, () => { server.close(() => process.exit(0)); for (const r of streams) try { r.end(); } catch { /* gone */ } setTimeout(() => process.exit(0), 4000).unref(); });
  server.listen(PORT, '127.0.0.1', () => console.log(`pebtree on http://localhost:${PORT}`));
})();

