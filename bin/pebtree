function postTop(x){
  var topic=(x.tabNamed?x.title:humanize(x.title))||humanize(branchLabel(x.branch))||'No topic yet',asked=(x.lastUser||'').replace(/^\[Image[^\]]*\]\s*/,'');
  if(/^This session is being continued/.test(asked))asked='';
  return '<div class="post-head" style="--tc:'+colorFor(x.tree)+'"><button class="cardchev" data-cardfold="'+x.tree+'" data-tip="Collapse or expand this card"><svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></button>'+treeIcon(x.tree,38)+'<div class="who"><div class="l1"><b class="tname">'+treeName(x.tree)+'</b>'+capBadge(x)+(x.hostUp===false?'<span class="pill bad" data-tip="'+esc(x.hostLabel)+' is unreachable; pebtree reconnects on its own and the session keeps running there">offline</span>':'')+(EDITING[x.tree]!==undefined?'<input class="topicedit" data-renamebox="'+x.tree+'" maxlength="60" value="'+esc(EDITING[x.tree])+'">':'<span class="topic" title="'+esc(topic)+'">'+esc(topic)+'</span>'+(x.menu&&ASKDONE[x.tree]!==x.menu.sig?'<span class="pill waiting askpill">'+(x.menu.kind==='permission'?'Permission':'Question')+'</span>':'')+'<button class="renamebtn" data-rename="'+x.tree+'" data-tip="Rename · also renames its terminal tab"><svg viewBox="0 0 24 24"><path d="M4 20h4L19 9l-4-4L4 16z"/></svg></button>')+(x.remote?'<span class="pill ok">remote</span>':'')+(subRunning(x).length?'<span class="pill agentpill" data-tip="'+esc(subRunning(x).map(function(a){return a.desc}).join(' · '))+'">'+subRunning(x).length+' subagent'+(subRunning(x).length>1?'s':'')+'</span>':'')+headActs(x,false)+'<span class="muted small when">'+(x.claudeState==='working'?'<span class="dots"><i></i><i></i><i></i></span> working · ':'waiting ')+ago(x.lastActive).replace(' ago','')+'</span></div>'+
    '<div class="l2 small muted">'+(x.branch?'<span class="br" title="'+esc(x.branch)+'"><svg viewBox="0 0 24 24"><circle cx="6" cy="5" r="2"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="8" r="2"/><path d="M6 7v10M18 10c0 4-6 3-11 7"/></svg>'+esc(branchLabel(x.branch))+'</span>':'')+(asked?'<span class="asked" title="'+esc(asked)+'">You: '+esc(asked)+'</span>':'')+'</div></div></div>';
}
function pendingOf(x){var a=((SENT[x.tree]&&SENT[x.tree].msgs)||[]).slice();(x.pending||[]).forEach(function(p){if(!a.some(function(q){return q.text===p.text}))a.push(p)});return a.sort(function(a,b){return a.at-b.at})}
